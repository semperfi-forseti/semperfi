@@ -0,0 +1,86 @@
+"""
+Cliente HTTP com proteção SSRF.
+
+- Allowlist de hosts (config).
+- Bloqueio de IPs privados/loopback/link-local após resolução DNS.
+- Sem follow_redirects (decidir manualmente) — evita redirect para IP interno.
+- Timeout obrigatório.
+- User-Agent identificável.
+"""
+import ipaddress
+import socket
+from typing import Any
+
+import httpx
+from tenacity import retry, retry_if_exception_type, stop_after_attempt, wait_exponential
+
+from app.core.config import get_settings
+from app.core.errors import AppError
+
+USER_AGENT = "SEMPER-FI/2.0 (+https://semperfi.local)"
+DEFAULT_TIMEOUT = httpx.Timeout(10.0, connect=5.0)
+
+
+class SSRFBlocked(AppError):
+    code = "ssrf_blocked"
+    http_status = 403
+    public_message = "Host bloqueado por política SSRF."
+
+
+def _resolve_ips(host: str) -> list[str]:
+    try:
+        return [ai[4][0] for ai in socket.getaddrinfo(host, None)]
+    except socket.gaierror as e:
+        raise AppError(f"DNS falhou: {host}") from e
+
+
+def _assert_public_ip(host: str) -> None:
+    for ip_str in _resolve_ips(host):
+        ip = ipaddress.ip_address(ip_str)
+        if ip.is_private or ip.is_loopback or ip.is_link_local or ip.is_multicast or ip.is_unspecified:
+            raise SSRFBlocked(f"Resolução para IP não-público: {ip_str}")
+
+
+def _assert_allowlisted(host: str) -> None:
+    allowlist = get_settings().http_allowlist_set
+    h = host.lower()
+    if not any(h == a or h.endswith("." + a) for a in allowlist):
+        raise SSRFBlocked(f"Host '{host}' fora da allowlist.")
+
+
+def _check_url(url: str) -> str:
+    parsed = httpx.URL(url)
+    if parsed.scheme not in {"http", "https"}:
+        raise SSRFBlocked(f"Esquema não permitido: {parsed.scheme}")
+    host = parsed.host
+    if not host:
+        raise SSRFBlocked("URL sem host.")
+    _assert_allowlisted(host)
+    _assert_public_ip(host)
+    return host
+
+
+@retry(
+    reraise=True,
+    stop=stop_after_attempt(3),
+    wait=wait_exponential(multiplier=1, min=1, max=8),
+    retry=retry_if_exception_type((httpx.HTTPError,)),
+)
+async def safe_request(method: str, url: str, *, headers: dict | None = None,
+                       params: dict | None = None, json: Any | None = None,
+                       data: Any | None = None, timeout: httpx.Timeout = DEFAULT_TIMEOUT) -> httpx.Response:
+    _check_url(url)
+    merged_headers = {"User-Agent": USER_AGENT, **(headers or {})}
+    async with httpx.AsyncClient(timeout=timeout, follow_redirects=False) as cli:
+        resp = await cli.request(method, url, headers=merged_headers, params=params, json=json, data=data)
+        # Não seguimos redirect automaticamente; um 30x exige decisão explícita do conector.
+        if 300 <= resp.status_code < 400:
+            raise httpx.HTTPStatusError(f"redirect bloqueado para {resp.headers.get('location')}",
+                                        request=resp.request, response=resp)
+        resp.raise_for_status()
+        return resp
+
+
+async def safe_get_json(url: str, **kwargs) -> Any:
+    r = await safe_request("GET", url, **kwargs)
+    return r.json()
