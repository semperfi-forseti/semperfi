@@ -0,0 +1,65 @@
+"""
+Rotação programada de KEK.
+
+- Lista KMSKey ativas; para cada uma com next_rotation_after vencido,
+  marca como rotating, cria nova KEK metadata e audita.
+- Material da chave é rotacionado no KMS externo (AWS KMS já oferece automatic
+  key rotation; este task apenas espelha o estado em DB para visibilidade).
+"""
+import asyncio
+import uuid
+from datetime import date, datetime, timedelta, timezone
+
+from sqlalchemy import select
+
+from app.audit.service import AuditService
+from app.core.config import get_settings
+from app.db.base import SessionLocal
+from app.models import KMSKey
+from app.security import keystore
+from app.workers.celery_app import celery_app
+
+
+@celery_app.task(name="app.workers.tasks.key_rotation.check_and_rotate", bind=True)
+def check_and_rotate(self) -> dict:
+    return asyncio.run(_check())
+
+
+async def _check() -> dict:
+    s = get_settings()
+    today = date.today()
+    rotated = 0
+    async with SessionLocal() as session:
+        rows = (await session.execute(
+            select(KMSKey).where(KMSKey.state == "active")
+        )).scalars().all()
+        if not rows:
+            # bootstrap: registra a KEK ativa atual
+            kek_id = keystore.active_kek_id()
+            fp = keystore.fingerprint(kek_id.encode())
+            k = KMSKey(
+                id=kek_id, kind="KEK",
+                backend=s.kms_backend, external_ref=s.kms_kek_id or None,
+                state="active", algorithm="AES-256-GCM",
+                activated_at=datetime.now(timezone.utc),
+                next_rotation_after=today + timedelta(days=s.kms_key_rotation_days),
+                fingerprint=fp,
+            )
+            session.add(k)
+            await AuditService(session).write(
+                action="kms.bootstrap", resource="kms_key", resource_id=k.id,
+                metadata={"backend": s.kms_backend, "fingerprint_prefix": fp[:16]},
+            )
+            await session.commit()
+            return {"bootstrapped": kek_id}
+
+        for k in rows:
+            if k.next_rotation_after and k.next_rotation_after <= today:
+                k.state = "rotating"
+                await AuditService(session).write(
+                    action="kms.rotation_due", resource="kms_key", resource_id=k.id,
+                    metadata={"next_rotation_after": k.next_rotation_after.isoformat()},
+                )
+                rotated += 1
+        await session.commit()
+    return {"rotated": rotated, "checked": len(rows)}
