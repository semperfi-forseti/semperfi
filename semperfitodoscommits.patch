diff --git a/backend/app/connectors/_http.py b/backend/app/connectors/_http.py
new file mode 100644
index 0000000..95f3ad6
--- /dev/null
+++ b/backend/app/connectors/_http.py
@@ -0,0 +1,20 @@
+"""Cliente HTTP compartilhado: timeout, retry com backoff, user-agent."""
+import httpx
+from tenacity import retry, retry_if_exception_type, stop_after_attempt, wait_exponential
+
+USER_AGENT = "SEMPER-FI-OSINT/1.0 (https://semperfi.local)"
+DEFAULT_TIMEOUT = httpx.Timeout(10.0, connect=5.0)
+
+
+@retry(
+    reraise=True,
+    stop=stop_after_attempt(3),
+    wait=wait_exponential(multiplier=1, min=1, max=10),
+    retry=retry_if_exception_type((httpx.HTTPError,)),
+)
+async def request_json(method: str, url: str, *, headers: dict | None = None, params: dict | None = None, json: dict | None = None) -> dict:
+    headers = {"User-Agent": USER_AGENT, "Accept": "application/json", **(headers or {})}
+    async with httpx.AsyncClient(timeout=DEFAULT_TIMEOUT, follow_redirects=True) as cli:
+        r = await cli.request(method, url, headers=headers, params=params, json=json)
+        r.raise_for_status()
+        return r.json()
