+"""Endpoints admin de backup (criação, listagem, verificação, restore-dry-run)."""
+from datetime import datetime
+
+from fastapi import APIRouter, Depends, Query
+from sqlalchemy import select
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from app.api.deps import current_session, get_db, require_reauth
+from app.audit.service import AuditService
+from app.backup.service import restore_dry_run, run_full_backup, verify_backup
+from app.core.errors import PolicyDenied
+from app.db.outbox import enqueue
+from app.models import BackupRun
+from app.policies import PolicyEngine, PolicyRequest
+
+router = APIRouter(prefix="/backups", tags=["backup"])
+
+
+async def _check_admin(session: dict, db: AsyncSession, action: str) -> None:
+    dec = await PolicyEngine(db).evaluate(PolicyRequest(
+        action=action, resource="backup",
+        actor_id=session["user_id"], actor_role=session["role"],
+        tenant_id=session["tenant_id"],
+        mfa_verified=session["mfa_verified"], reauth_verified=True,
+    ))
+    if not dec.allowed:
+        raise PolicyDenied(dec.reason, details={"code": dec.code})
+    if session["role"] != "admin":
+        raise PolicyDenied("Apenas admin pode operar backups.", details={"code": "NOT_ADMIN"})
+
+
+@router.get("")
+async def list_backups(
+    session: dict = Depends(current_session), db: AsyncSession = Depends(get_db),
+    limit: int = Query(50, ge=1, le=500),
+):
+    await _check_admin(session, db, "backup.read")
+    rows = (await db.execute(
+        select(BackupRun).order_by(BackupRun.started_at.desc()).limit(limit)
+    )).scalars().all()
+    return [{
+        "id": r.id, "kind": r.kind, "status": r.status,
+        "started_at": r.started_at.isoformat(), "finished_at": r.finished_at.isoformat() if r.finished_at else None,
+        "size_bytes": r.size_bytes,
+        "storage_key": r.storage_key, "kek_id": r.kek_id,
+        "object_lock_until": r.object_lock_until.isoformat() if r.object_lock_until else None,
+        "verified_at": r.verified_at.isoformat() if r.verified_at else None,
+        "sha256_plaintext_prefix": r.sha256_plaintext[:16] if r.sha256_plaintext else None,
+        "sha256_ciphertext_prefix": r.sha256_ciphertext[:16] if r.sha256_ciphertext else None,
+    } for r in rows]
+
+
+@router.post("/run-full", status_code=202)
+async def trigger_full_backup(
+    session: dict = Depends(require_reauth), db: AsyncSession = Depends(get_db),
+):
+    await _check_admin(session, db, "backup.create")
+    msg_id = await enqueue(
+        db, task_name="app.workers.tasks.backup.run_full", queue="critical",
+        tenant_id=None, payload={},
+    )
+    await AuditService(db).write(
+        action="backup.trigger", resource="backup_run",
+        tenant_id=None, actor_id=session["user_id"], actor_role=session["role"],
+        metadata={"outbox_id": msg_id},
+    )
+    await db.commit()
+    return {"status": "enqueued", "outbox_id": msg_id}
+
+
+@router.post("/{backup_id}/verify")
+async def verify(
+    backup_id: str, deep: bool = False,
+    session: dict = Depends(require_reauth), db: AsyncSession = Depends(get_db),
+):
+    await _check_admin(session, db, "backup.verify")
+    return await verify_backup(backup_id, db, deep=deep)
+
+
+@router.post("/{backup_id}/restore-dry-run")
+async def restore_dry(
+    backup_id: str,
+    session: dict = Depends(require_reauth), db: AsyncSession = Depends(get_db),
+):
+    await _check_admin(session, db, "backup.restore_dry_run")
+    return await restore_dry_run(backup_id, db)
