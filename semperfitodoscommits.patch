@@ -0,0 +1,83 @@
+"""Despacha coleta OSINT via outbox → Celery."""
+import uuid
+from datetime import datetime, timezone
+
+from fastapi import APIRouter, Depends, Request
+from pydantic import BaseModel
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from app.api.deps import current_session, get_db, request_ip_masked
+from app.audit.service import AuditService
+from app.connectors.registry import get_connector
+from app.core.errors import NotFound, PolicyDenied
+from app.db.outbox import enqueue
+from app.models import ConnectorRun, Entity
+from app.policies import PolicyEngine, PolicyRequest
+from app.security.rate_limit import hit_connector
+
+router = APIRouter(prefix="/osint", tags=["osint"])
+
+
+class RunIn(BaseModel):
+    investigation_id: str
+    connector_id: str
+    target_entity_id: str | None = None
+    purpose: str
+    payload: dict = {}
+
+
+@router.post("/runs", status_code=202)
+async def submit_run(data: RunIn, request: Request,
+                     session: dict = Depends(current_session), db: AsyncSession = Depends(get_db)):
+    # 1. Rate limit por (tenant, connector)
+    rl = await hit_connector(session["tenant_id"], data.connector_id)
+    # 2. Validação de entrada do conector
+    connector = get_connector(data.connector_id)
+    await connector.validate_input(data.payload)
+    # 3. Política
+    target_entity = await db.get(Entity, data.target_entity_id) if data.target_entity_id else None
+    dec = await PolicyEngine(db).evaluate(PolicyRequest(
+        action="connector.run", resource="connector_run",
+        actor_id=session["user_id"], actor_role=session["role"],
+        tenant_id=session["tenant_id"], mfa_verified=session["mfa_verified"],
+        investigation_id=data.investigation_id, connector_id=data.connector_id,
+        target_entity_type=target_entity.entity_type if target_entity else None,
+        rate_limited=not rl.allowed, purpose=data.purpose,
+    ))
+    if not dec.allowed:
+        raise PolicyDenied(dec.reason, details={"code": dec.code, "outcome": str(dec.outcome.value)})
+    # 4. Cria ConnectorRun + enfileira via outbox (mesma transação)
+    correlation_id = uuid.uuid4().hex[:16]
+    run = ConnectorRun(
+        id=str(uuid.uuid4()), tenant_id=session["tenant_id"],
+        investigation_id=data.investigation_id, connector_id=data.connector_id,
+        target_entity_id=data.target_entity_id, purpose=data.purpose,
+        scope_snapshot=[], payload_fingerprint=uuid.uuid4().hex,
+        started_at=datetime.now(timezone.utc), status="enfileirada",
+        actor_id=session["user_id"], correlation_id=correlation_id,
+    )
+    db.add(run)
+    await enqueue(db, task_name="app.workers.tasks.ingest_connector.run",
+                  queue="default", tenant_id=session["tenant_id"], correlation_id=correlation_id,
+                  payload={"run_id": run.id, "connector_id": data.connector_id, "payload": data.payload,
+                           "ctx": {"tenant_id": session["tenant_id"], "investigation_id": data.investigation_id,
+                                   "actor_id": session["user_id"], "correlation_id": correlation_id,
+                                   "purpose": data.purpose}})
+    await AuditService(db).write(action="connector.submit", resource="connector_run", resource_id=run.id,
+                                 tenant_id=session["tenant_id"], actor_id=session["user_id"],
+                                 actor_role=session["role"], ip_masked=request_ip_masked(request),
+                                 correlation_id=correlation_id,
+                                 metadata={"connector": data.connector_id})
+    await db.commit()
+    return {"id": run.id, "status": run.status}
+
+
+@router.get("/runs/{rid}")
+async def get_run(rid: str, session: dict = Depends(current_session), db: AsyncSession = Depends(get_db)):
+    run = await db.get(ConnectorRun, rid)
+    if not run or run.tenant_id != session["tenant_id"]:
+        raise NotFound()
+    return {"id": run.id, "status": run.status, "summary": run.result_summary,
+            "started_at": run.started_at.isoformat(),
+            "finished_at": run.finished_at.isoformat() if run.finished_at else None,
+            "error_code": run.error_code, "confidence": run.confidence}
