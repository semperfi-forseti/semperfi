+"""Endpoints de verificação de integridade sistêmica."""
+from fastapi import APIRouter, Depends, Query
+from sqlalchemy import select
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from app.api.deps import current_session, get_db, require_reauth
+from app.core.errors import PolicyDenied
+from app.integrity.verifier import full_scan, persist_report
+from app.models import IntegrityReport
+from app.policies import PolicyEngine, PolicyRequest
+
+router = APIRouter(prefix="/integrity", tags=["integrity"])
+
+
+async def _check(session: dict, db: AsyncSession, action: str) -> None:
+    dec = await PolicyEngine(db).evaluate(PolicyRequest(
+        action=action, resource="integrity_report",
+        actor_id=session["user_id"], actor_role=session["role"],
+        tenant_id=session["tenant_id"], mfa_verified=session["mfa_verified"],
+    ))
+    if not dec.allowed:
+        raise PolicyDenied(dec.reason, details={"code": dec.code})
+    if session["role"] not in {"admin", "auditor"}:
+        raise PolicyDenied("Apenas admin/auditor acessam integridade.", details={"code": "FORBIDDEN_ROLE"})
+
+
+@router.get("/reports")
+async def list_reports(
+    session: dict = Depends(current_session), db: AsyncSession = Depends(get_db),
+    limit: int = Query(50, ge=1, le=200),
+):
+    await _check(session, db, "integrity.read")
+    rows = (await db.execute(
+        select(IntegrityReport).order_by(IntegrityReport.started_at.desc()).limit(limit)
+    )).scalars().all()
+    return [{
+        "id": r.id, "scope": r.scope, "overall_status": r.overall_status,
+        "started_at": r.started_at.isoformat(), "finished_at": r.finished_at.isoformat() if r.finished_at else None,
+        "audit": {"checked": r.audit_events_checked, "ok": r.audit_chain_ok, "broken_index": r.audit_broken_index},
+        "evidence": {"checked": r.evidence_events_checked, "ok": r.evidence_chain_ok, "broken_index": r.evidence_broken_index},
+        "s3": {"checked": r.s3_objects_checked, "mismatches": r.s3_mismatches},
+        "backups": {"checked": r.backups_checked, "failed": r.backups_failed_verify},
+        "report_sha256": r.report_sha256,
+    } for r in rows]
+
+
+@router.get("/reports/{report_id}")
+async def get_report(
+    report_id: str,
+    session: dict = Depends(current_session), db: AsyncSession = Depends(get_db),
+):
+    await _check(session, db, "integrity.read")
+    r: IntegrityReport | None = await db.get(IntegrityReport, report_id)
+    if not r:
+        return {"error": "not_found"}
+    return {
+        "id": r.id, "scope": r.scope, "overall_status": r.overall_status,
+        "started_at": r.started_at.isoformat(),
+        "finished_at": r.finished_at.isoformat() if r.finished_at else None,
+        "details": r.details, "report_sha256": r.report_sha256,
+        "correlation_id": r.correlation_id,
+    }
+
+
+@router.post("/full-scan", status_code=202)
+async def trigger_full_scan(
+    session: dict = Depends(require_reauth), db: AsyncSession = Depends(get_db),
+    audit_limit: int = 5000, evidence_limit: int = 5000,
+    s3_sample: int = 50, backup_sample: int = 3,
+):
+    await _check(session, db, "integrity.run")
+    res = await full_scan(db, audit_limit=audit_limit, evidence_limit=evidence_limit,
+                          s3_sample=s3_sample, backup_sample=backup_sample)
+    rep = await persist_report(res, db)
+    return {"report_id": rep.id, "overall": rep.overall_status,
+            "report_sha256_prefix": rep.report_sha256[:16]}
