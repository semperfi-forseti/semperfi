@@ -0,0 +1,39 @@
+"""Verifica periodicamente o hash SHA-256 de evidências recentes."""
+import asyncio
+from datetime import datetime, timedelta, timezone
+
+from sqlalchemy import select
+
+from app.audit.service import AuditService
+from app.core.errors import IntegrityError
+from app.db.base import SessionLocal
+from app.evidence.vault import EvidenceVault
+from app.models import Evidence
+from app.workers.celery_app import celery_app
+
+
+@celery_app.task(name="app.workers.tasks.integrity.verify_recent_evidence", bind=True)
+def verify_recent_evidence(self) -> dict:
+    return asyncio.run(_verify())
+
+
+async def _verify() -> dict:
+    horizon = datetime.now(timezone.utc) - timedelta(hours=2)
+    ok = bad = 0
+    async with SessionLocal() as session:
+        rows = (await session.execute(
+            select(Evidence).where(Evidence.created_at >= horizon).limit(200)
+        )).scalars().all()
+        for ev in rows:
+            try:
+                EvidenceVault.verify_integrity(ev.s3_key, ev.sha256)
+                ok += 1
+            except IntegrityError:
+                bad += 1
+                await AuditService(session).write(
+                    action="evidence.integrity_violation", resource="evidence",
+                    resource_id=ev.id, result="violacao", tenant_id=ev.tenant_id,
+                    metadata={"sha256_prefix": ev.sha256[:16]},
+                )
+        await session.commit()
+    return {"ok": ok, "bad": bad}
