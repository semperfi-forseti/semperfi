+"""
+Orquestração de agentes + backup + verificação de integridade + KMS keystore.
+
+AgentDAGRun       — pipeline encadeada de AgentRuns (coordenador).
+BackupRun         — snapshot lógico criptografado (DB + manifest de evidências).
+IntegrityReport   — varredura sistêmica de hash chain + S3 + DB drift.
+KMSKey            — metadados das DEKs/KEKs (chave material NUNCA persistido aqui).
+ComplianceFinding — achados de revisão de compliance (LGPD/CFOAB).
+"""
+from datetime import date, datetime
+
+from sqlalchemy import JSON, Boolean, Date, DateTime, Float, ForeignKey, Integer, String, Text
+from sqlalchemy.orm import Mapped, mapped_column
+
+from app.db.base import Base
+from app.models.base import TenantMixin, TimestampMixin
+
+
+class AgentDAGRun(Base, TenantMixin, TimestampMixin):
+    """Execução de pipeline coordenada — várias AgentRun encadeadas."""
+    __tablename__ = "agent_dag_runs"
+    id: Mapped[str] = mapped_column(String(36), primary_key=True)
+    investigation_id: Mapped[str | None] = mapped_column(String(36), ForeignKey("investigations.id"), nullable=True, index=True)
+    pipeline_id: Mapped[str] = mapped_column(String(80), nullable=False, index=True)
+    pipeline_version: Mapped[str] = mapped_column(String(20), default="1.0")
+    requested_by: Mapped[str] = mapped_column(String(36), nullable=False)
+    status: Mapped[str] = mapped_column(String(30), default="pending", index=True)
+    # pending|running|partial|completed|failed|blocked
+    current_step: Mapped[str | None] = mapped_column(String(80), nullable=True)
+    step_history: Mapped[list] = mapped_column(JSON, default=list)
+    agent_run_ids: Mapped[list] = mapped_column(JSON, default=list)
+    started_at: Mapped[datetime | None] = mapped_column(DateTime(timezone=True), nullable=True)
+    finished_at: Mapped[datetime | None] = mapped_column(DateTime(timezone=True), nullable=True)
+    error_message: Mapped[str | None] = mapped_column(Text, nullable=True)
+    correlation_id: Mapped[str] = mapped_column(String(32), nullable=False, index=True)
+
+
+class BackupRun(Base, TimestampMixin):
+    """Manifesto de backup. Material criptográfico NÃO persistido em DB."""
+    __tablename__ = "backup_runs"
+    id: Mapped[str] = mapped_column(String(36), primary_key=True)
+    kind: Mapped[str] = mapped_column(String(30), default="full", index=True)
+    # full|incremental|wal|evidence_manifest
+    status: Mapped[str] = mapped_column(String(30), default="running", index=True)
+    # running|success|failed|verified|restored
+    started_at: Mapped[datetime] = mapped_column(DateTime(timezone=True), nullable=False)
+    finished_at: Mapped[datetime | None] = mapped_column(DateTime(timezone=True), nullable=True)
+    storage_bucket: Mapped[str] = mapped_column(String(120), nullable=False)
+    storage_key: Mapped[str] = mapped_column(String(255), nullable=False, index=True)
+    size_bytes: Mapped[int] = mapped_column(Integer, default=0)
+    sha256_ciphertext: Mapped[str | None] = mapped_column(String(64), nullable=True)
+    sha256_plaintext: Mapped[str | None] = mapped_column(String(64), nullable=True)
+    dek_wrapped_b64: Mapped[str | None] = mapped_column(Text, nullable=True)  # DEK envelopada pela KEK ativa
+    kek_id: Mapped[str | None] = mapped_column(String(80), nullable=True)
+    object_lock_until: Mapped[datetime | None] = mapped_column(DateTime(timezone=True), nullable=True)
+    manifest: Mapped[dict] = mapped_column(JSON, default=dict)
+    error_message: Mapped[str | None] = mapped_column(Text, nullable=True)
+    verified_at: Mapped[datetime | None] = mapped_column(DateTime(timezone=True), nullable=True)
+
+
+class IntegrityReport(Base, TimestampMixin):
+    """Relatório consolidado de uma varredura full-system."""
+    __tablename__ = "integrity_reports"
+    id: Mapped[str] = mapped_column(String(36), primary_key=True)
+    scope: Mapped[str] = mapped_column(String(40), default="full")
+    # full|audit_chain|evidence_chain|s3_drift|backup
+    started_at: Mapped[datetime] = mapped_column(DateTime(timezone=True), nullable=False)
+    finished_at: Mapped[datetime | None] = mapped_column(DateTime(timezone=True), nullable=True)
+    audit_events_checked: Mapped[int] = mapped_column(Integer, default=0)
+    audit_chain_ok: Mapped[bool] = mapped_column(Boolean, default=True)
+    audit_broken_index: Mapped[int | None] = mapped_column(Integer, nullable=True)
+    evidence_events_checked: Mapped[int] = mapped_column(Integer, default=0)
+    evidence_chain_ok: Mapped[bool] = mapped_column(Boolean, default=True)
+    evidence_broken_index: Mapped[int | None] = mapped_column(Integer, nullable=True)
+    s3_objects_checked: Mapped[int] = mapped_column(Integer, default=0)
+    s3_mismatches: Mapped[int] = mapped_column(Integer, default=0)
+    backups_checked: Mapped[int] = mapped_column(Integer, default=0)
+    backups_failed_verify: Mapped[int] = mapped_column(Integer, default=0)
+    overall_status: Mapped[str] = mapped_column(String(20), default="ok", index=True)
+    # ok|warning|violation
+    details: Mapped[dict] = mapped_column(JSON, default=dict)
+    report_sha256: Mapped[str] = mapped_column(String(64), nullable=False)
+    correlation_id: Mapped[str] = mapped_column(String(32), nullable=False)
+
+
+class KMSKey(Base, TimestampMixin):
+    """Metadados das chaves. Material NUNCA persistido aqui — vive no KMS externo ou em Secrets Manager."""
+    __tablename__ = "kms_keys"
+    id: Mapped[str] = mapped_column(String(80), primary_key=True)  # ex: kek-2026q2-001
+    kind: Mapped[str] = mapped_column(String(20), default="KEK", index=True)  # KEK|DEK_AUDIT|DEK_FIELD
+    backend: Mapped[str] = mapped_column(String(30), default="aws_kms")
+    # aws_kms|gcp_kms|vault|local_fernet
+    external_ref: Mapped[str | None] = mapped_column(String(255), nullable=True)
+    state: Mapped[str] = mapped_column(String(20), default="active", index=True)
+    # active|rotating|retired|destroyed
+    algorithm: Mapped[str] = mapped_column(String(40), default="AES-256-GCM")
+    activated_at: Mapped[datetime] = mapped_column(DateTime(timezone=True), nullable=False)
+    retired_at: Mapped[datetime | None] = mapped_column(DateTime(timezone=True), nullable=True)
+    next_rotation_after: Mapped[date | None] = mapped_column(Date, nullable=True)
+    fingerprint: Mapped[str] = mapped_column(String(64), nullable=False, index=True)
+    metadata_json: Mapped[dict] = mapped_column(JSON, default=dict)
+
+
+class ComplianceFinding(Base, TenantMixin, TimestampMixin):
+    """Achado de compliance — gerado pelo agente compliance ou por verificação manual."""
+    __tablename__ = "compliance_findings"
+    id: Mapped[str] = mapped_column(String(36), primary_key=True)
+    investigation_id: Mapped[str | None] = mapped_column(String(36), ForeignKey("investigations.id"), nullable=True, index=True)
+    agent_run_id: Mapped[str | None] = mapped_column(String(36), nullable=True, index=True)
+    rule_id: Mapped[str] = mapped_column(String(80), nullable=False, index=True)
+    severity: Mapped[str] = mapped_column(String(20), default="info", index=True)
+    # info|low|medium|high|critical
+    framework: Mapped[str] = mapped_column(String(40), default="LGPD")
+    # LGPD|CFOAB|CNJ|interno|ISO27001
+    category: Mapped[str] = mapped_column(String(60), nullable=False)
+    description: Mapped[str] = mapped_column(Text, nullable=False)
+    suggested_action: Mapped[str | None] = mapped_column(Text, nullable=True)
+    status: Mapped[str] = mapped_column(String(30), default="aberto", index=True)
+    # aberto|em_remediacao|aceito_risco|falso_positivo|resolvido
+    resolved_by: Mapped[str | None] = mapped_column(String(36), nullable=True)
+    resolved_at: Mapped[datetime | None] = mapped_column(DateTime(timezone=True), nullable=True)
+    resolution_note: Mapped[str | None] = mapped_column(Text, nullable=True)
+    evidence_refs: Mapped[list] = mapped_column(JSON, default=list)
