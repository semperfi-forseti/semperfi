+"""Entidades investigadas — adição segura com fingerprint/máscara."""
+import uuid
+
+from fastapi import APIRouter, Depends, HTTPException
+from sqlalchemy.orm import Session
+
+from app.api.deps import db_session, requires
+from app.core.pseudonymize import fingerprint, mask_doc, normalize_doc
+from app.models import Investigation, OsintEntity
+from app.schemas.investigation import EntityCreate
+from app.services.audit import write_event
+
+router = APIRouter(prefix="/api/osint/investigations/{inv_id}/entities", tags=["entities"])
+
+
+@router.post("", status_code=201)
+def add_entity(
+    inv_id: str,
+    data: EntityCreate,
+    db: Session = Depends(db_session),
+    user: dict = Depends(requires("entity.create")),
+):
+    inv = db.get(Investigation, inv_id)
+    if not inv:
+        raise HTTPException(404, "Investigação não encontrada")
+    if inv.status in {"concluida", "arquivada", "bloqueada"}:
+        raise HTTPException(400, f"Investigação está '{inv.status}' (somente leitura)")
+
+    doc_norm = normalize_doc(data.document) if data.document else None
+    ent = OsintEntity(
+        id=str(uuid.uuid4()),
+        investigation_id=inv_id,
+        entity_type=data.entity_type,
+        display_name=data.display_name,
+        normalized_name=data.display_name.upper(),
+        document_masked=mask_doc(data.document) if data.document else None,
+        document_fingerprint=fingerprint(data.document) if data.document else None,
+        # document_encrypted: integrar com KMS/pgcrypto em produção
+        aliases=data.aliases,
+        notes=data.notes,
+        confidence=0.7,
+    )
+    db.add(ent)
+    db.commit()
+    db.refresh(ent)
+
+    write_event(
+        db, actor_id=user["id"], actor_role=user["role"],
+        module="osint", action="adicao_entidade",
+        target_id=inv_id,
+        metadata={
+            "entity_id": ent.id, "type": data.entity_type,
+            # SOMENTE fingerprint nos logs — nunca o documento em claro.
+            "fingerprint": ent.document_fingerprint,
+        },
+    )
+    return {"id": ent.id, "fingerprint": ent.document_fingerprint, "masked": ent.document_masked}
