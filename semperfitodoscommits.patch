+"""Listagem de auditoria + verificador de cadeia."""
+from datetime import datetime
+
+from fastapi import APIRouter, Depends, Query
+from sqlalchemy import select
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from app.api.deps import current_session, get_db
+from app.audit.chain import verify_segment
+from app.core.errors import PolicyDenied
+from app.models import AuditEvent
+from app.policies import PolicyEngine, PolicyRequest
+
+router = APIRouter(prefix="/audit-events", tags=["audit"])
+
+
+@router.get("")
+async def list_events(
+    session: dict = Depends(current_session), db: AsyncSession = Depends(get_db),
+    limit: int = Query(100, ge=1, le=500),
+    action: str | None = None,
+    resource: str | None = None,
+    since: datetime | None = None,
+):
+    dec = await PolicyEngine(db).evaluate(PolicyRequest(
+        action="audit.read", resource="audit_events",
+        actor_id=session["user_id"], actor_role=session["role"],
+        tenant_id=session["tenant_id"], mfa_verified=session["mfa_verified"],
+    ))
+    if not dec.allowed:
+        raise PolicyDenied(dec.reason, details={"code": dec.code})
+    q = select(AuditEvent).where(AuditEvent.tenant_id == session["tenant_id"]).order_by(AuditEvent.timestamp.desc()).limit(limit)
+    if action:
+        q = q.where(AuditEvent.action == action)
+    if resource:
+        q = q.where(AuditEvent.resource == resource)
+    if since:
+        q = q.where(AuditEvent.timestamp >= since)
+    rows = (await db.execute(q)).scalars().all()
+    return [{"id": e.id, "timestamp": e.timestamp.isoformat(), "actor_id": e.actor_id,
+             "action": e.action, "resource": e.resource, "resource_id": e.resource_id,
+             "result": e.result, "correlation_id": e.correlation_id} for e in rows]
+
+
+@router.post("/verify-chain")
+async def verify_chain(session: dict = Depends(current_session), db: AsyncSession = Depends(get_db),
+                       limit: int = Query(1000, ge=10, le=10000)):
+    dec = await PolicyEngine(db).evaluate(PolicyRequest(
+        action="audit.read", resource="audit_events",
+        actor_id=session["user_id"], actor_role=session["role"],
+        tenant_id=session["tenant_id"], mfa_verified=session["mfa_verified"],
+    ))
+    if not dec.allowed:
+        raise PolicyDenied(dec.reason, details={"code": dec.code})
+    rows = (await db.execute(
+        select(AuditEvent).order_by(AuditEvent.timestamp).limit(limit)
+    )).scalars().all()
+    events = [{
+        "tenant_id": r.tenant_id, "actor_id": r.actor_id, "actor_role": r.actor_role,
+        "action": r.action, "resource": r.resource, "resource_id": r.resource_id,
+        "result": r.result, "metadata": r.metadata_json, "correlation_id": r.correlation_id,
+        "previous_hash": r.previous_hash, "current_hash": r.current_hash,
+    } for r in rows]
+    ok, idx, msg = verify_segment(events)
+    return {"ok": ok, "verified": len(events), "broken_index": idx, "message": msg}
