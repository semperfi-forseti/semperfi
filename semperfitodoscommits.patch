@@ -0,0 +1,140 @@
+"""Investigações OSINT TACER + entidades + relações."""
+import uuid
+from datetime import date, datetime, timedelta, timezone
+from typing import Literal
+
+from fastapi import APIRouter, Depends
+from pydantic import BaseModel, Field
+from sqlalchemy import select
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from app.api.deps import current_session, get_db
+from app.audit.service import AuditService
+from app.core.errors import NotFound, PolicyDenied, TenantIsolationViolation
+from app.models import Entity, EntityIdentifier, EntityRelation, Investigation, InvestigationScope
+from app.policies import PolicyEngine, PolicyRequest
+from app.security.crypto import encrypt_str, fingerprint, mask_doc, normalize_doc
+
+router = APIRouter(prefix="/investigations", tags=["investigations"])
+
+
+class InvestigationIn(BaseModel):
+    title: str = Field(min_length=3, max_length=255)
+    objective: str = Field(min_length=50)
+    hypothesis: str | None = None
+    category: Literal["processual", "patrimonial", "societaria", "fraude", "compliance",
+                       "reputacao", "prova_digital", "ciberseguranca_defensiva"]
+    legal_basis: str
+    legitimate_interest_assessment: str = Field(min_length=20)
+    authorization_reference: str = Field(min_length=3)
+    purpose: str
+    scope: list[str] = Field(min_length=1)
+    client_id: str | None = None
+    process_id: str | None = None
+    retention_years: int = Field(default=5, ge=1, le=20)
+    declaration_of_legitimate_purpose: bool
+
+
+class EntityIn(BaseModel):
+    entity_type: str
+    display_name: str
+    identifiers: list[dict] = []   # [{"kind":"cnpj","value":"..."}]
+    notes: str | None = None
+
+
+class RelationIn(BaseModel):
+    from_entity_id: str
+    to_entity_id: str
+    relation_type: str
+    description: str | None = None
+    confidence_score: float = 0.5
+
+
+@router.post("", status_code=201)
+async def create_investigation(data: InvestigationIn, session: dict = Depends(current_session), db: AsyncSession = Depends(get_db)):
+    if not data.declaration_of_legitimate_purpose:
+        raise PolicyDenied("Declaração de finalidade legítima é obrigatória.", details={"code": "declaration_missing"})
+    dec = await PolicyEngine(db).evaluate(PolicyRequest(
+        action="investigation.create", resource="investigation",
+        actor_id=session["user_id"], actor_role=session["role"], tenant_id=session["tenant_id"],
+        mfa_verified=session["mfa_verified"],
+    ))
+    if not dec.allowed:
+        raise PolicyDenied(dec.reason, details={"code": dec.code})
+    inv = Investigation(
+        id=str(uuid.uuid4()), tenant_id=session["tenant_id"],
+        title=data.title, objective=data.objective, hypothesis=data.hypothesis,
+        category=data.category, legal_basis=data.legal_basis,
+        legitimate_interest_assessment=data.legitimate_interest_assessment,
+        authorization_reference=data.authorization_reference,
+        purpose=data.purpose, client_id=data.client_id, process_id=data.process_id,
+        owner_id=session["user_id"], status="em_coleta",
+        retention_until=(datetime.now(timezone.utc) + timedelta(days=365 * data.retention_years)).date(),
+        tacer_state={"scope": data.scope},
+    )
+    db.add(inv)
+    for sc in data.scope:
+        db.add(InvestigationScope(id=str(uuid.uuid4()), tenant_id=session["tenant_id"],
+                                   investigation_id=inv.id, scope=sc, approved_by=session["user_id"]))
+    audit = AuditService(db)
+    await audit.write(action="investigation.create", resource="investigation", resource_id=inv.id,
+                      tenant_id=session["tenant_id"], actor_id=session["user_id"], actor_role=session["role"],
+                      metadata={"scope": data.scope})
+    await audit.write(action="investigation.scope_approved", resource="investigation", resource_id=inv.id,
+                      tenant_id=session["tenant_id"], actor_id=session["user_id"], actor_role=session["role"])
+    await db.commit()
+    return {"id": inv.id, "status": inv.status}
+
+
+@router.get("/{inv_id}")
+async def get_investigation(inv_id: str, session: dict = Depends(current_session), db: AsyncSession = Depends(get_db)):
+    inv = await db.get(Investigation, inv_id)
+    if not inv or inv.is_deleted:
+        raise NotFound()
+    if inv.tenant_id != session["tenant_id"]:
+        raise TenantIsolationViolation()
+    return {
+        "id": inv.id, "title": inv.title, "category": inv.category, "status": inv.status,
+        "purpose": inv.purpose, "owner_id": inv.owner_id,
+        "retention_until": inv.retention_until.isoformat(),
+        "tacer_state": inv.tacer_state,
+    }
+
+
+@router.post("/{inv_id}/entities", status_code=201)
+async def add_entity(inv_id: str, data: EntityIn, session: dict = Depends(current_session), db: AsyncSession = Depends(get_db)):
+    inv = await db.get(Investigation, inv_id)
+    if not inv or inv.tenant_id != session["tenant_id"]:
+        raise TenantIsolationViolation()
+    e = Entity(id=str(uuid.uuid4()), tenant_id=session["tenant_id"], investigation_id=inv_id,
+               entity_type=data.entity_type, display_name=data.display_name,
+               normalized_name=data.display_name.upper(), notes=data.notes)
+    db.add(e)
+    for ident in data.identifiers:
+        raw = ident.get("value", "")
+        db.add(EntityIdentifier(
+            id=str(uuid.uuid4()), tenant_id=session["tenant_id"], entity_id=e.id,
+            kind=ident.get("kind", "outro"),
+            value_masked=mask_doc(raw), value_fingerprint=fingerprint(raw),
+            value_encrypted=encrypt_str(normalize_doc(raw)) if raw else None,
+        ))
+    await AuditService(db).write(action="entity.create", resource="entity", resource_id=e.id,
+                                 tenant_id=session["tenant_id"], actor_id=session["user_id"],
+                                 actor_role=session["role"])
+    await db.commit()
+    return {"id": e.id}
+
+
+@router.post("/{inv_id}/relations", status_code=201)
+async def add_relation(inv_id: str, data: RelationIn, session: dict = Depends(current_session), db: AsyncSession = Depends(get_db)):
+    inv = await db.get(Investigation, inv_id)
+    if not inv or inv.tenant_id != session["tenant_id"]:
+        raise TenantIsolationViolation()
+    r = EntityRelation(id=str(uuid.uuid4()), tenant_id=session["tenant_id"],
+                       investigation_id=inv_id, **data.model_dump())
+    db.add(r)
+    await AuditService(db).write(action="relation.create", resource="relation", resource_id=r.id,
+                                 tenant_id=session["tenant_id"], actor_id=session["user_id"],
+                                 actor_role=session["role"])
+    await db.commit()
+    return {"id": r.id}
