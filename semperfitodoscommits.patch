+#!/usr/bin/env bash
+set -euo pipefail
+
+echo "==> SEMPER-FI bootstrap: validando ferramentas"
+python --version
+pip --version
+psql --version
+redis-cli --version || true
+
+if [ ! -f .env ]; then
+  if [ -f backend/.env.example ]; then
+    cp backend/.env.example .env
+    chmod 600 .env
+    echo "==> .env criado a partir de backend/.env.example (lembre-se de editar segredos locais)"
+  fi
+fi
+
+echo "==> Instalando dependências do backend"
+cd backend
+python -m pip install --upgrade pip
+python -m pip install -e ".[dev]" || python -m pip install -r <(python - <<'PY'
+import tomllib, sys
+data = tomllib.loads(open("pyproject.toml","rb").read().decode())
+deps = data.get("project",{}).get("dependencies",[])
+print("\n".join(deps))
+PY
+)
+
+echo "==> Bootstrap concluído. Próximos passos:"
+echo "    make compose-up && make migrate && make seed && make run"
