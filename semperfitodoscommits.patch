@@ -0,0 +1,51 @@
+"""
+Relay do transactional outbox.
+
+A cada 5s: pega mensagens pending, despacha para a fila correta,
+marca como dispatched. Idempotente via lease (SKIP LOCKED).
+"""
+from datetime import datetime, timezone
+
+from sqlalchemy import select, update
+from sqlalchemy.exc import OperationalError
+
+from app.db.base import SessionLocal
+from app.models import OutboxMessage
+from app.workers.celery_app import celery_app
+
+
+@celery_app.task(name="app.workers.tasks.outbox_relay.relay_pending", bind=True, max_retries=3)
+def relay_pending(self) -> dict:
+    import asyncio
+    return asyncio.run(_relay())
+
+
+async def _relay() -> dict:
+    dispatched = 0
+    async with SessionLocal() as session:
+        # SKIP LOCKED para múltiplos workers
+        stmt = (select(OutboxMessage)
+                .where(OutboxMessage.status == "pending")
+                .order_by(OutboxMessage.created_at)
+                .limit(50)
+                .with_for_update(skip_locked=True))
+        try:
+            rows = (await session.execute(stmt)).scalars().all()
+        except OperationalError:
+            return {"dispatched": 0}
+        for msg in rows:
+            try:
+                celery_app.send_task(
+                    msg.task_name, kwargs=msg.payload, queue=msg.queue,
+                    task_id=msg.id,  # idempotência: task_id == outbox id
+                )
+                msg.status = "dispatched"
+                msg.dispatched_at = datetime.now(timezone.utc)
+                dispatched += 1
+            except Exception as e:  # noqa: BLE001
+                msg.attempts += 1
+                msg.last_error = str(e)[:500]
+                if msg.attempts >= 5:
+                    msg.status = "failed"
+        await session.commit()
+    return {"dispatched": dispatched}
