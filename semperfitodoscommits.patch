+# =====================================================================
+# SEMPER-FI / ABDCRIM — .env.example (RAIZ)
+# Use 'cp .env.example .env' e ajuste apenas para o seu ambiente local.
+# Segredos reais (AWS, OIDC, OpenAI, Anthropic, tokens governamentais)
+# NÃO entram no Git. Em produção use AWS Secrets Manager.
+# =====================================================================
+
+# ---------- App ----------
+APP_ENV=development
+APP_NAME=semperfi-backend
+APP_VERSION=2.0.0
+LOG_LEVEL=INFO
+
+# ---------- Sessão / CSRF ----------
+SESSION_SECRET=change-me-use-secrets-token-hex-32
+SESSION_COOKIE_NAME=sf_session
+SESSION_COOKIE_DOMAIN=
+SESSION_COOKIE_SECURE=false
+SESSION_COOKIE_SAMESITE=lax
+SESSION_MAX_AGE_SECONDS=28800
+CSRF_SECRET=change-me-32-bytes
+CSRF_COOKIE_NAME=sf_csrf
+REAUTH_TTL_SECONDS=300
+PSEUDONYMIZATION_SALT=change-me-deterministic-keep-secret
+FERNET_KEYS=base64-key-here,older-base64-key-for-rotation
+
+# ---------- CORS ----------
+CORS_ALLOWED_ORIGINS=http://localhost:5500,http://localhost:8000
+
+# ---------- OIDC ----------
+OIDC_ENABLED=false
+OIDC_ISSUER=https://auth.example.com/realms/semperfi
+OIDC_CLIENT_ID=semperfi-backend
+OIDC_CLIENT_SECRET=
+OIDC_REDIRECT_URI=https://app.example.com/v1/auth/oidc/callback
+OIDC_AUDIENCE=semperfi
+LOCAL_AUTH_ENABLED=true
+
+# ---------- MFA ----------
+MFA_REQUIRED_FOR_ROLES=admin,gestor,investigador,auditor
+MFA_TOTP_ISSUER=SEMPER-FI
+
+# ---------- Banco ----------
+DATABASE_URL=postgresql+asyncpg://semperfi:semperfi@postgres:5432/semperfi
+DATABASE_POOL_SIZE=10
+DATABASE_MAX_OVERFLOW=20
+
+# ---------- Redis / Celery ----------
+REDIS_URL=redis://redis:6379/0
+CELERY_BROKER_URL=redis://redis:6379/1
+CELERY_RESULT_BACKEND=redis://redis:6379/2
+
+# ---------- Evidência (S3 / Object Lock) ----------
+EVIDENCE_S3_ENDPOINT=http://minio:9000
+EVIDENCE_S3_BUCKET=semperfi-evidence
+EVIDENCE_S3_REGION=us-east-1
+EVIDENCE_S3_ACCESS_KEY=semperfi
+EVIDENCE_S3_SECRET_KEY=semperfi-secret
+EVIDENCE_S3_OBJECT_LOCK_MODE=GOVERNANCE
+EVIDENCE_S3_DEFAULT_RETENTION_DAYS=1825
+EVIDENCE_KMS_KEY_ID=
+EVIDENCE_SSE_TYPE=AES256
+
+# ---------- Backup / KMS ----------
+KMS_BACKEND=local_fernet
+KMS_KEK_ID=
+KMS_KEY_ROTATION_DAYS=90
+BACKUP_S3_ENDPOINT=http://minio:9000
+BACKUP_S3_BUCKET=semperfi-backup
+BACKUP_S3_REGION=us-east-1
+BACKUP_S3_ACCESS_KEY=semperfi
+BACKUP_S3_SECRET_KEY=semperfi-secret
+BACKUP_OBJECT_LOCK_MODE=GOVERNANCE
+BACKUP_RETENTION_DAYS=365
+
+# ---------- SSRF / Conectores ----------
+HTTP_ALLOWLIST=brasilapi.com.br,api.portaldatransparencia.gov.br,api-publica.datajud.cnj.jus.br,rdap.registro.br,dados.cvm.gov.br,servicodados.ibge.gov.br
+BRASILAPI_BASE_URL=https://brasilapi.com.br/api
+TRANSPARENCIA_BASE_URL=https://api.portaldatransparencia.gov.br/api-de-dados
+TRANSPARENCIA_API_TOKEN=
+DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br
+DATAJUD_API_KEY=
+
+# ---------- Rate limit ----------
+RATE_LIMIT_GLOBAL_PER_MIN=600
+RATE_LIMIT_USER_PER_MIN=120
+RATE_LIMIT_CONNECTOR_PER_MIN=60
+
+# ---------- AntiVirus ----------
+CLAMD_HOST=clamav
+CLAMD_PORT=3310
+
+# ---------- Observabilidade ----------
+PROMETHEUS_ENABLED=true
+OTEL_ENABLED=false
+OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
+SENTRY_DSN=
+
+# ---------- Secrets backend ----------
+SECRETS_BACKEND=env
+AWS_SECRETS_PREFIX=/semperfi/prod/
