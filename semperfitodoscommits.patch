+++ b/.github/workflows/deploy-development.yml
@@ -0,0 +1,94 @@
+name: deploy-development
+
+on:
+  push:
+    branches: [develop]
+    paths:
+      - "backend/**"
+      - "infra/docker/**"
+      - ".github/workflows/deploy-development.yml"
+      - ".github/workflows/reusable-build-image.yml"
+
+permissions:
+  contents: read
+
+concurrency:
+  group: deploy-development
+  cancel-in-progress: false
+
+jobs:
+  build:
+    uses: ./.github/workflows/reusable-build-image.yml
+    with:
+      environment: development
+      aws_region: "{{AWS_REGION}}"
+      aws_account_id: "{{AWS_ACCOUNT_ID_DEVELOPMENT}}"
+      ecr_repository_api: "semperfi-development-api"
+      ecr_repository_worker: "semperfi-development-worker"
+      role_name: "github-semperfi-development-deploy"
+    permissions:
+      contents: read
+      id-token: write
+
+  deploy:
+    name: Deploy to ECS (development)
+    needs: build
+    runs-on: ubuntu-latest
+    timeout-minutes: 30
+    environment: development
+    permissions:
+      contents: read
+      id-token: write
+    env:
+      AWS_REGION: "{{AWS_REGION}}"
+      ECS_CLUSTER: "semperfi-development"
+      ECS_SERVICE_API: "semperfi-development-api"
+      ECS_SERVICE_WORKER: "semperfi-development-worker"
+      ECS_SERVICE_BEAT: "semperfi-development-beat"
+      API_IMAGE_URI: ${{ needs.build.outputs.api_image_uri }}
+      WORKER_IMAGE_URI: ${{ needs.build.outputs.worker_image_uri }}
+    steps:
+      - uses: actions/checkout@REPLACE_WITH_VERIFIED_SHA  # v4.2.2
+        with: { persist-credentials: false }
+
+      - name: Configure AWS credentials (OIDC)
+        uses: aws-actions/configure-aws-credentials@REPLACE_WITH_VERIFIED_SHA  # v4.0.2
+        with:
+          role-to-assume: "arn:aws:iam::{{AWS_ACCOUNT_ID_DEVELOPMENT}}:role/github-semperfi-development-deploy"
+          aws-region: ${{ env.AWS_REGION }}
+          role-session-name: gha-deploy-dev-${{ github.run_id }}
+
+      - name: Deploy API
+        run: |
+          bash infra/scripts/deploy-ecs.sh \
+            "${ECS_CLUSTER}" "${ECS_SERVICE_API}" "${API_IMAGE_URI}"
+
+      - name: Deploy Worker
+        run: |
+          bash infra/scripts/deploy-ecs.sh \
+            "${ECS_CLUSTER}" "${ECS_SERVICE_WORKER}" "${WORKER_IMAGE_URI}"
+
+      - name: Deploy Beat
+        run: |
+          bash infra/scripts/deploy-ecs.sh \
+            "${ECS_CLUSTER}" "${ECS_SERVICE_BEAT}" "${WORKER_IMAGE_URI}"
+
+      - name: Wait stability
+        run: |
+          bash infra/scripts/wait-for-ecs-stable.sh \
+            "${ECS_CLUSTER}" "${ECS_SERVICE_API}" "${ECS_SERVICE_WORKER}" "${ECS_SERVICE_BEAT}"
+
+      - name: Smoke test
+        run: |
+          bash infra/scripts/smoke-test.sh "development"
+
+      - name: Summary
+        if: always()
+        run: |
+          {
+            echo "### Deploy development"
+            echo "- Commit: \`${GITHUB_SHA}\`"
+            echo "- API: \`${API_IMAGE_URI}\`"
+            echo "- Worker: \`${WORKER_IMAGE_URI}\`"
+            echo "- Cluster: \`${ECS_CLUSTER}\`"
+          } >> "$GITHUB_STEP_SUMMARY"
