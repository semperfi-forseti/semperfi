diff --git a/backend/app/core/pseudonymize.py b/backend/app/core/pseudonymize.py
new file mode 100644
index 0000000..b3c0314
--- /dev/null
+++ b/backend/app/core/pseudonymize.py
@@ -0,0 +1,29 @@
+"""Mascaramento + fingerprint determinístico (HMAC-SHA256) com salt secreto."""
+import hashlib
+import hmac
+import re
+
+from app.config import get_settings
+
+_NON_DIGIT = re.compile(r"\D+")
+
+
+def normalize_doc(value: str) -> str:
+    """Remove tudo que não é dígito (para CPF/CNPJ/telefone)."""
+    return _NON_DIGIT.sub("", value or "")
+
+
+def mask_doc(value: str) -> str:
+    """Mascara exibindo apenas os 2 primeiros e 2 últimos dígitos."""
+    v = (value or "").strip()
+    if len(v) <= 4:
+        return "*" * len(v)
+    return v[:2] + "*" * (len(v) - 4) + v[-2:]
+
+
+def fingerprint(value: str) -> str:
+    """HMAC-SHA256(value, salt) → 12 chars hex.
+    Determinístico para permitir join entre logs, sem permitir reidentificação."""
+    salt = get_settings().pseudonymization_salt.encode()
+    digest = hmac.new(salt, normalize_doc(value).encode(), hashlib.sha256).hexdigest()
+    return digest[:12]
diff --git a/backend/app/core/rbac.py b/backend/app/core/rbac.py
new file mode 100644
index 0000000..2d28cf5
--- /dev/null
+++ b/backend/app/core/rbac.py
@@ -0,0 +1,39 @@
+"""RBAC declarativo."""
+from collections.abc import Iterable
+
+ROLES = {
+    "admin": {"*"},
+    "advogado_responsavel": {
+        "investigation.create", "investigation.update", "investigation.approve",
+        "investigation.delete", "entity.create", "run.execute", "finding.validate",
+        "evidence.validate", "report.generate"
+    },
+    "investigador": {
+        "investigation.read", "entity.create", "run.execute",
+        "finding.read", "evidence.read"
+    },
+    "revisor": {
+        "investigation.read", "finding.validate", "evidence.validate",
+        "evidence.read", "audit.read"
+    },
+    "auditor": {
+        "investigation.read", "evidence.read", "audit.read", "report.generate"
+    },
+    "consulta": {
+        "investigation.read", "finding.read", "evidence.read"
+    },
+}
+
+
+def has_permission(role: str, perm: str) -> bool:
+    allowed = ROLES.get(role, set())
+    return "*" in allowed or perm in allowed
+
+
+def require(role: str, *perms: str) -> None:
+    if not all(has_permission(role, p) for p in perms):
+        raise PermissionError(f"Papel '{role}' não autorizado para: {perms}")
+
+
+def roles_with(perms: Iterable[str]) -> list[str]:
+    return [r for r in ROLES if all(has_permission(r, p) for p in perms)]
diff --git a/backend/app/core/security.py b/backend/app/core/security.py
new file mode 100644
index 0000000..1213549
--- /dev/null
+++ b/backend/app/core/security.py
@@ -0,0 +1,45 @@
+"""JWT (RS256) + hash de senha."""
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+
+from jose import JWTError, jwt
+from passlib.context import CryptContext
+
+from app.config import get_settings
+
+settings = get_settings()
+pwd_context = CryptContext(schemes=["bcrypt"], deprecated="auto")
+
+
+def _load_key(path: str) -> str:
+    p = Path(path)
+    return p.read_text() if p.exists() else settings.app_secret  # fallback dev
+
+
+def hash_password(plain: str) -> str:
+    return pwd_context.hash(plain)
+
+
+def verify_password(plain: str, hashed: str) -> bool:
+    return pwd_context.verify(plain, hashed)
+
+
+def create_access_token(*, subject: str, role: str, extra: dict | None = None) -> str:
+    now = datetime.now(timezone.utc)
+    payload = {
+        "sub": subject,
+        "role": role,
+        "iat": now,
+        "exp": now + timedelta(minutes=settings.jwt_ttl_minutes),
+        **(extra or {}),
+    }
+    key = _load_key(settings.jwt_private_key_path)
+    return jwt.encode(payload, key, algorithm=settings.jwt_algorithm)
+
+
+def decode_token(token: str) -> dict:
+    key = _load_key(settings.jwt_public_key_path)
+    try:
+        return jwt.decode(token, key, algorithms=[settings.jwt_algorithm])
+    except JWTError as e:
+        raise ValueError(f"Token inválido: {e}") from e
diff --git a/backend/app/database.py b/backend/app/database.py
new file mode 100644
index 0000000..221a1d3
--- /dev/null
+++ b/backend/app/database.py
@@ -0,0 +1,30 @@
+"""Sessão SQLAlchemy."""
+from collections.abc import Generator
+from sqlalchemy import create_engine
+from sqlalchemy.orm import DeclarativeBase, Session, sessionmaker
+
+from app.config import get_settings
+
+settings = get_settings()
+
+engine = create_engine(
+    settings.database_url,
+    pool_pre_ping=True,
+    pool_size=10,
+    max_overflow=20,
+    echo=False,
+)
+
+SessionLocal = sessionmaker(autocommit=False, autoflush=False, bind=engine)
+
+
+class Base(DeclarativeBase):
+    pass
+
+
+def get_db() -> Generator[Session, None, None]:
+    db = SessionLocal()
+    try:
+        yield db
+    finally:
+        db.close()
diff --git a/backend/app/main.py b/backend/app/main.py
new file mode 100644
index 0000000..5b16bbf
--- /dev/null
+++ b/backend/app/main.py
@@ -0,0 +1,54 @@
+"""FastAPI app — SEMPER-FI OSINT backend."""
+import logging
+
+import structlog
+from fastapi import FastAPI
+from fastapi.middleware.cors import CORSMiddleware
+
+from app.api import auth, entities, evidence, investigations, reports, runs, source_catalog
+from app.config import get_settings
+
+settings = get_settings()
+
+structlog.configure(
+    processors=[
+        structlog.contextvars.merge_contextvars,
+        structlog.processors.add_log_level,
+        structlog.processors.TimeStamper(fmt="iso"),
+        structlog.processors.JSONRenderer(),
+    ],
+    wrapper_class=structlog.make_filtering_bound_logger(logging.INFO),
+)
+log = structlog.get_logger()
+
+app = FastAPI(
+    title="SEMPER-FI OSINT Backend",
+    version="1.0.0",
+    description="Backend de investigações OSINT — coleta pública, cadeia de custódia, relatório técnico.",
+)
+
+app.add_middleware(
+    CORSMiddleware,
+    allow_origins=settings.cors_origins_list,
+    allow_credentials=True,
+    allow_methods=["GET", "POST", "PUT", "DELETE", "OPTIONS"],
+    allow_headers=["*"],
+)
+
+app.include_router(auth.router)
+app.include_router(source_catalog.router)
+app.include_router(investigations.router)
+app.include_router(entities.router)
+app.include_router(runs.router)
+app.include_router(evidence.router)
+app.include_router(reports.router)
+
+
+@app.get("/health")
+def health():
+    return {"status": "ok", "service": "semperfi-osint-backend", "env": settings.app_env}
+
+
+@app.on_event("startup")
+async def startup():
+    log.info("startup", env=settings.app_env, db=settings.database_url.split("@")[-1], bucket=settings.evidence_s3_bucket)
