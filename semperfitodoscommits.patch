+"""IBGE — contexto territorial (municípios, estados, regiões)."""
+from app.config import get_settings
+from app.connectors._http import request_json
+from app.connectors.base import BaseConnector, ConnectorResult
+
+settings = get_settings()
+
+
+class IBGEMunicipiosConnector(BaseConnector):
+    id = "ibge_municipios"
+    name = "IBGE — Municípios"
+
+    async def fetch(self, payload: dict) -> ConnectorResult:
+        nome = (payload.get("target") or "").strip()
+        if not nome:
+            return ConnectorResult(status="erro", summary="Município não informado", raw_data={}, source_id=self.id, source_name=self.name, evidence_candidate=False)
+        url = f"{settings.ibge_base_url}/localidades/municipios"
+        try:
+            data = await request_json("GET", url)
+        except Exception as e:
+            return ConnectorResult(status="erro", summary=f"Falha: {e}", raw_data={}, source_id=self.id, source_name=self.name, error_message=str(e), evidence_candidate=False)
+        match = next((m for m in data if m.get("nome", "").lower() == nome.lower()), None)
+        if not match:
+            return ConnectorResult(status="sem_resultado", summary=f"Município '{nome}' não encontrado", raw_data={}, source_id=self.id, source_name=self.name, source_url=url, confidence=0.9)
+        uf = match.get("microrregiao", {}).get("mesorregiao", {}).get("UF", {})
+        return ConnectorResult(
+            status="ok",
+            summary=f"{match['nome']}/{uf.get('sigla','')} — IBGE {match['id']}",
+            raw_data=match,
+            source_id=self.id, source_name=self.name, source_url=url,
+            confidence=0.95,
+            limitations="Apenas contexto territorial — não usar como rastreamento de pessoa.",
+        )
