@@ -0,0 +1,83 @@
+"""
+Sessões assinadas em cookie HttpOnly + Secure + SameSite.
+
+NUNCA armazenamos JWT em localStorage — sessão é sempre cookie.
+Mantemos o JTI em Redis para revogação imediata.
+"""
+import secrets
+import time
+from typing import Any
+
+import redis.asyncio as aioredis
+from itsdangerous import BadSignature, TimestampSigner
+
+from app.core.config import get_settings
+
+settings = get_settings()
+_signer = TimestampSigner(settings.session_secret.get_secret_value())
+_redis: aioredis.Redis | None = None
+
+
+def _r() -> aioredis.Redis:
+    global _redis
+    if _redis is None:
+        _redis = aioredis.from_url(settings.redis_url, decode_responses=True)
+    return _redis
+
+
+def make_session_token(*, user_id: str, tenant_id: str, role: str, mfa_verified: bool, reauth_at: int | None = None) -> tuple[str, str]:
+    """Gera token + jti. Persiste jti em Redis com payload mínimo."""
+    jti = secrets.token_urlsafe(24)
+    payload = {
+        "uid": user_id, "tid": tenant_id, "role": role,
+        "mfa": int(mfa_verified), "reauth": reauth_at or 0,
+        "iat": int(time.time()),
+    }
+    raw = ".".join(f"{k}:{v}" for k, v in payload.items())
+    token = _signer.sign(f"{jti}|{raw}").decode()
+    return token, jti
+
+
+async def store_session(jti: str, *, user_id: str, tenant_id: str, role: str, mfa_verified: bool, reauth_at: int | None) -> None:
+    s = settings
+    key = f"sess:{jti}"
+    await _r().hset(key, mapping={
+        "uid": user_id, "tid": tenant_id, "role": role,
+        "mfa": int(mfa_verified), "reauth": reauth_at or 0,
+        "iat": int(time.time()),
+    })
+    await _r().expire(key, s.session_max_age_seconds)
+
+
+async def revoke_session(jti: str) -> None:
+    await _r().delete(f"sess:{jti}")
+
+
+async def load_session_from_cookie(cookie_value: str) -> dict[str, Any] | None:
+    try:
+        raw = _signer.unsign(cookie_value, max_age=settings.session_max_age_seconds).decode()
+    except BadSignature:
+        return None
+    jti, *_ = raw.split("|", 1)
+    data = await _r().hgetall(f"sess:{jti}")
+    if not data:
+        return None
+    return {
+        "jti": jti,
+        "user_id": data["uid"], "tenant_id": data["tid"], "role": data["role"],
+        "mfa_verified": bool(int(data.get("mfa", 0))),
+        "reauth_at": int(data.get("reauth", 0)),
+        "issued_at": int(data.get("iat", 0)),
+    }
+
+
+async def mark_reauth(jti: str) -> None:
+    """Marca a sessão como tendo passado pelo step-up agora."""
+    now = int(time.time())
+    await _r().hset(f"sess:{jti}", "reauth", now)
+
+
+def reauth_is_fresh(reauth_at: int) -> bool:
+    if not reauth_at:
+        return False
+    return (int(time.time()) - reauth_at) <= settings.reauth_ttl_seconds
