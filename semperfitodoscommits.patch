diff --git a/backend/app/scripts/import_frontend.py b/backend/app/scripts/import_frontend.py
new file mode 100644
index 0000000..c2cc468
--- /dev/null
+++ b/backend/app/scripts/import_frontend.py
@@ -0,0 +1,60 @@
+"""
+Importador de JSON exportado pelo frontend (localStorage → DB).
+
+Uso: python -m app.scripts.import_frontend --file export.json --tenant <uuid>
+
+Mapeia coleções do export: clients, processes, deadlines, intimations, financial,
+investigations, osintEntities, files (metadados — os bytes precisam ser re-uploadados),
+audit (ignorado — auditoria server-side é re-construída).
+"""
+import argparse
+import asyncio
+import json
+import uuid
+
+from app.db.base import SessionLocal
+from app.models import Client, Deadline, Intimation, Investigation, Process
+from app.security.crypto import encrypt_str, fingerprint, mask_doc, normalize_doc
+
+
+async def import_data(path: str, tenant_id: str) -> dict:
+    with open(path) as f:
+        data = json.load(f)
+    counters: dict[str, int] = {}
+    async with SessionLocal() as db:
+        for c in data.get("clients", []):
+            db.add(Client(
+                id=c.get("id") or str(uuid.uuid4()), tenant_id=tenant_id,
+                name=c["name"], type=c["type"],
+                document_masked=mask_doc(c.get("document", "")) if c.get("document") else None,
+                document_fingerprint=fingerprint(c.get("document", "")) if c.get("document") else None,
+                document_encrypted=encrypt_str(normalize_doc(c.get("document", ""))) if c.get("document") else None,
+                email=c.get("email"), phone=c.get("phone"), address=c.get("address"),
+                responsible=c.get("responsible"), status=c.get("status", "ativo"), notes=c.get("notes"),
+            ))
+            counters["clients"] = counters.get("clients", 0) + 1
+        for p in data.get("processes", []):
+            db.add(Process(
+                id=p.get("id") or str(uuid.uuid4()), tenant_id=tenant_id,
+                number=p["number"], client_id=p.get("clientId"),
+                court=p.get("court"), area=p.get("area"), phase=p.get("phase"),
+                status=p.get("status", "ativo"), responsible=p.get("responsible"),
+                value=float(p.get("value", 0)), notes=p.get("notes"),
+            ))
+            counters["processes"] = counters.get("processes", 0) + 1
+        # adicione mapeadores para deadlines, intimations, financial, investigations conforme necessário
+        await db.commit()
+    return counters
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--file", required=True)
+    ap.add_argument("--tenant", required=True)
+    args = ap.parse_args()
+    result = asyncio.run(import_data(args.file, args.tenant))
+    print("Importado:", result)
+
+
+if __name__ == "__main__":
+    main()
