@@ -0,0 +1,109 @@
+"""Seed inicial: usuário admin + catálogo de fontes.
+
+Uso:
+  python -m app.scripts.seed
+"""
+import uuid
+from datetime import datetime, timezone
+
+from app.core.security import hash_password
+from app.database import SessionLocal
+from app.models import SourceCatalog, User
+
+SOURCES = [
+    {"id": "brasilapi_cnpj", "name": "BrasilAPI — CNPJ", "category": "empresarial",
+     "connector_type": "rest", "enabled": True, "requires_token": False,
+     "allowed_target_types": ["pessoa_juridica"],
+     "legal_notes": "Conveniência; validar dados decisivos em Receita Federal.",
+     "rate_limit_per_min": 60, "cache_ttl_minutes": 60, "confidence_weight": 0.7,
+     "terms_accepted": True},
+    {"id": "brasilapi_cep", "name": "BrasilAPI — CEP", "category": "territorial_cadastral",
+     "connector_type": "rest", "enabled": True, "requires_token": False,
+     "allowed_target_types": ["endereco"], "legal_notes": "Dados públicos de logradouros.",
+     "rate_limit_per_min": 60, "cache_ttl_minutes": 1440, "confidence_weight": 0.9,
+     "terms_accepted": True},
+    {"id": "brasilapi_ddd", "name": "BrasilAPI — DDD", "category": "territorial_cadastral",
+     "connector_type": "rest", "enabled": True, "requires_token": False,
+     "allowed_target_types": ["telefone"], "legal_notes": "Apenas contexto territorial.",
+     "rate_limit_per_min": 60, "cache_ttl_minutes": 10080, "confidence_weight": 0.9,
+     "terms_accepted": True},
+    {"id": "brasilapi_bancos", "name": "BrasilAPI — Bancos", "category": "empresarial",
+     "connector_type": "rest", "enabled": True, "requires_token": False,
+     "allowed_target_types": ["banco"], "legal_notes": "Cadastro COMPE.",
+     "rate_limit_per_min": 60, "cache_ttl_minutes": 10080, "confidence_weight": 0.95,
+     "terms_accepted": True},
+    {"id": "transparencia_ceis", "name": "Portal Transparência — CEIS",
+     "category": "integridade_publica", "connector_type": "backend",
+     "enabled": False, "requires_token": True,
+     "allowed_target_types": ["pessoa_fisica", "pessoa_juridica"],
+     "legal_notes": "Cadastro de Empresas Inidôneas e Suspensas. Token obrigatório.",
+     "rate_limit_per_min": 90, "cache_ttl_minutes": 720, "confidence_weight": 0.95,
+     "terms_accepted": False},
+    {"id": "transparencia_cnep", "name": "Portal Transparência — CNEP",
+     "category": "integridade_publica", "connector_type": "backend",
+     "enabled": False, "requires_token": True,
+     "allowed_target_types": ["pessoa_fisica", "pessoa_juridica"],
+     "legal_notes": "Cadastro Nacional de Empresas Punidas.",
+     "rate_limit_per_min": 90, "cache_ttl_minutes": 720, "confidence_weight": 0.95,
+     "terms_accepted": False},
+    {"id": "transparencia_cepim", "name": "Portal Transparência — CEPIM",
+     "category": "integridade_publica", "connector_type": "backend",
+     "enabled": False, "requires_token": True, "allowed_target_types": ["pessoa_juridica"],
+     "legal_notes": "Entidades Privadas Sem Fins Lucrativos Impedidas.",
+     "rate_limit_per_min": 90, "cache_ttl_minutes": 720, "confidence_weight": 0.95,
+     "terms_accepted": False},
+    {"id": "datajud_cnj", "name": "DataJud — metadados processuais",
+     "category": "judicial_publico", "connector_type": "backend",
+     "enabled": False, "requires_token": True,
+     "allowed_target_types": ["processo", "pessoa_fisica", "pessoa_juridica"],
+     "legal_notes": "Apenas metadados públicos; respeitar sigilo processual.",
+     "rate_limit_per_min": 120, "cache_ttl_minutes": 60, "confidence_weight": 0.9,
+     "terms_accepted": False},
+    {"id": "cvm_dados_abertos", "name": "CVM — Companhias Abertas",
+     "category": "mercado_companhias_abertas", "connector_type": "backend",
+     "enabled": False, "requires_token": False, "allowed_target_types": ["pessoa_juridica"],
+     "legal_notes": "Dados abertos da CVM (CSV).",
+     "rate_limit_per_min": 60, "cache_ttl_minutes": 1440, "confidence_weight": 0.95,
+     "terms_accepted": False},
+    {"id": "ibge_municipios", "name": "IBGE — Municípios",
+     "category": "territorial_cadastral", "connector_type": "rest",
+     "enabled": True, "requires_token": False,
+     "allowed_target_types": ["endereco", "municipio"],
+     "legal_notes": "Contexto territorial; nunca usar como rastreamento de pessoa.",
+     "rate_limit_per_min": 60, "cache_ttl_minutes": 10080, "confidence_weight": 0.95,
+     "terms_accepted": True},
+    {"id": "rdap_dns", "name": "RDAP/DNS — Domínios",
+     "category": "seguranca_digital_defensiva", "connector_type": "backend",
+     "enabled": False, "requires_token": False, "allowed_target_types": ["dominio"],
+     "legal_notes": "Apenas domínios próprios ou expressamente autorizados.",
+     "rate_limit_per_min": 30, "cache_ttl_minutes": 1440, "confidence_weight": 0.85,
+     "terms_accepted": False},
+]
+
+
+def main():
+    db = SessionLocal()
+    try:
+        # Catálogo
+        for src in SOURCES:
+            existing = db.get(SourceCatalog, src["id"])
+            if existing:
+                continue
+            db.add(SourceCatalog(**src, last_validated_at=datetime.now(timezone.utc)))
+
+        # Usuário admin (apenas se não existir)
+        if not db.query(User).filter_by(email="admin@semperfi.local").first():
+            db.add(User(
+                id=str(uuid.uuid4()), email="admin@semperfi.local", name="Admin Demo",
+                password_hash=hash_password("ChangeMe!2026"), role="admin", is_active=True,
+            ))
+            print("Usuário admin criado: admin@semperfi.local / ChangeMe!2026")
+
+        db.commit()
+        print(f"Seed concluído: {len(SOURCES)} fontes catalogadas.")
+    finally:
+        db.close()
+
+
+if __name__ == "__main__":
+    main()
