+#!/usr/bin/env bash
+set -euo pipefail
+
+echo "==> Verificando PostgreSQL"
+pg_isready -h postgres -U semperfi -d semperfi || echo "postgres ainda não está saudável"
+
+echo "==> Verificando Redis"
+redis-cli -h redis ping || echo "redis ainda não está saudável"
+
+echo "==> Verificando MinIO"
+curl -fsS http://minio:9000/minio/health/live > /dev/null && echo "minio: OK" || echo "minio: aguardando"
+
+echo "==> Verificando ClamAV"
+nc -z clamav 3310 && echo "clamav: OK" || echo "clamav: aguardando (signatures podem demorar)"
+
+echo "==> Serviços validados (avisos acima são esperados nos primeiros segundos)."
