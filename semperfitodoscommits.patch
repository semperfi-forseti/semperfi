--- /dev/null
+++ b/Makefile
@@ -0,0 +1,85 @@
+.PHONY: help bootstrap compose-up compose-down lint test ci tf-fmt tf-validate \
+        tf-init tf-plan tf-apply tf-destroy smoke-test logs deploy-development rollback openapi
+
+ENV ?= development
+ALLOWED_ENVS := development staging production
+
+help:
+	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-22s\033[0m %s\n", $$1, $$2}'
+
+bootstrap:  ## Instala dependências do backend e prepara ambiente local
+	cd backend && python -m pip install -e ".[dev]" || python -m pip install -r <(python -c "import tomllib; print('\n'.join(tomllib.loads(open('pyproject.toml','rb').read().decode()).get('project',{}).get('dependencies',[])))")
+
+compose-up:  ## Sobe stack completa (frontend estático + backend + dependências)
+	docker compose -f docker-compose.yml up -d
+	@echo "API: http://localhost:8000/docs"
+	@echo "Frontend: http://localhost:5500"
+
+compose-down:  ## Derruba stack completa
+	docker compose -f docker-compose.yml down
+
+lint:  ## Lint backend
+	$(MAKE) -C backend lint
+
+test:  ## Testes backend
+	$(MAKE) -C backend test
+
+ci:  ## Replica o que o GitHub Actions roda
+	$(MAKE) lint
+	$(MAKE) test
+	docker compose -f docker-compose.yml config > /dev/null
+	$(MAKE) tf-fmt
+	$(MAKE) tf-validate
+
+openapi:  ## Exporta openapi.json
+	$(MAKE) -C backend openapi
+
+# ---------- Terraform ----------
+_check_env:
+	@case " $(ALLOWED_ENVS) " in *" $(ENV) "*) ;; *) echo "ENV inválido: $(ENV) (use: $(ALLOWED_ENVS))"; exit 2 ;; esac
+
+tf-fmt:  ## terraform fmt -check
+	terraform -chdir=infra/terraform fmt -check -recursive
+
+tf-validate:  ## terraform validate em cada ambiente
+	@for env in $(ALLOWED_ENVS); do \
+		echo "==> validate $$env"; \
+		terraform -chdir=infra/terraform/environments/$$env init -backend=false -input=false; \
+		terraform -chdir=infra/terraform/environments/$$env validate; \
+	done
+
+tf-init: _check_env  ## terraform init (ENV=development|staging|production)
+	terraform -chdir=infra/terraform/environments/$(ENV) init -input=false
+
+tf-plan: _check_env  ## terraform plan
+	terraform -chdir=infra/terraform/environments/$(ENV) plan -input=false -out=tfplan
+
+tf-apply: _check_env  ## terraform apply (production exige flag CONFIRM=YES e nunca local)
+	@if [ "$(ENV)" = "production" ]; then \
+		echo "::error::production apply é restrito ao workflow GitHub com aprovação"; exit 1; \
+	fi
+	@if [ "$(CONFIRM)" != "YES" ]; then \
+		echo "::error::execute com CONFIRM=YES para confirmar"; exit 1; \
+	fi
+	terraform -chdir=infra/terraform/environments/$(ENV) apply tfplan
+
+tf-destroy: _check_env  ## terraform destroy (bloqueado em production)
+	@if [ "$(ENV)" = "production" ]; then echo "::error::destroy bloqueado em production"; exit 1; fi
+	@if [ "$(CONFIRM)" != "YES" ]; then echo "::error::execute com CONFIRM=YES para confirmar"; exit 1; fi
+	terraform -chdir=infra/terraform/environments/$(ENV) destroy
+
+# ---------- Operação ----------
+smoke-test: _check_env  ## Smoke test contra ambiente
+	bash infra/scripts/smoke-test.sh $(ENV)
+
+logs: _check_env  ## Cauda de logs do serviço (SERVICE=api|worker|beat)
+	@SERVICE=$${SERVICE:-api}; \
+	aws logs tail /ecs/semperfi/$(ENV)/semperfi-$(ENV)-$$SERVICE --follow --since 10m
+
+deploy-development:  ## Gatilho local de deploy em dev (use o GitHub Actions normalmente)
+	@echo "Use 'gh workflow run deploy-development.yml' ou faça push em develop"
+
+rollback:  ## Rollback: ENV=staging VERSION=sha256:abcd...
+	@if [ -z "$(VERSION)" ]; then echo "::error::passe VERSION=<digest>"; exit 1; fi
+	@echo "==> Rollback $(ENV) -> $(VERSION)"
+	@echo "Execute: bash infra/scripts/deploy-ecs.sh semperfi-$(ENV) semperfi-$(ENV)-api <repo>@$(VERSION)"
