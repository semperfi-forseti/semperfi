+  return (b/Math.pow(k,i)).toFixed(i?2:0)+' '+sizes[i];
+}
+
+// USAGE METERING — registra evento e debita carteira (incluídos antes de comprados)
+function consumeCredits(operationKey, refId, module='osint'){
+  const op = CREDIT_OPERATIONS[operationKey];
+  if (!op) return {ok:true, credits:0};
+  let credits = op.credits;
+  const before = totalCreditsAvailable();
+  if (before < credits){ return {ok:false, reason:'insufficient', need:credits, have:before}; }
+  const w = DB.creditWallet;
+  const includedAvail = Math.max(0,(w.includedMonthlyTotal||0)-(w.includedMonthlyUsed||0));
+  const fromIncluded = Math.min(includedAvail, credits);
+  const fromPurchased = credits - fromIncluded;
+  w.includedMonthlyUsed = (w.includedMonthlyUsed||0) + fromIncluded;
+  w.purchasedUsed = (w.purchasedUsed||0) + fromPurchased;
+  DB.usageEvents.unshift({
+    id:uid('use'), at:Date.now(), user:SETTINGS.userName||'Carlos Mendes',
+    module, operation:operationKey, credits, balanceBefore:before, balanceAfter:before-credits,
+    status:'sucesso', refId
+  });
+  if (DB.usageEvents.length>500) DB.usageEvents.length=500;
+  saveDB();
+  audit('billing','consumo_creditos',`${operationKey}:${credits}`,'sucesso');
+  return {ok:true, credits, balanceAfter:before-credits};
+}
+
+// DILIGENCE WALLET — fórmula: max(15% custo, R$ 4,90)
+function calcDiligenceFee(cost){ return Math.max(cost*0.15, 4.90); }
+function totalDiligenceCost(cost){ return cost + calcDiligenceFee(cost); }
+
+function spendDiligence(cost, description, refId){
+  const total = totalDiligenceCost(cost);
+  if (DB.diligenceWallet.balance < total) return {ok:false, reason:'insufficient', need:total, have:DB.diligenceWallet.balance};
+  DB.diligenceWallet.balance -= total;
+  DB.diligenceWallet.totalSpent = (DB.diligenceWallet.totalSpent||0) + total;
+  DB.billingLedger.unshift({
+    id:uid('bil'), type:'diligencia', amount:total, status:'simulado',
+    description, createdAt:Date.now(), referenceId:refId,
+    breakdown:{cost, fee:calcDiligenceFee(cost)}
+  });
+  saveDB();
+  audit('billing','diligencia',description,'sucesso');
+  return {ok:true, balanceAfter:DB.diligenceWallet.balance};
+}
