+++ b/backend/app/connectors/base.py
@@ -0,0 +1,34 @@
+"""
+Contrato de conector OSINT.
+
+Cada conector implementa `fetch(payload)` e devolve um `ConnectorResult`
+padronizado, que o worker grava como `OsintRun` + cria evidência se
+`evidence_candidate=True`.
+"""
+from abc import ABC, abstractmethod
+from dataclasses import dataclass, field
+from datetime import datetime, timezone
+from typing import Any
+
+
+@dataclass
+class ConnectorResult:
+    status: str  # ok|erro|sem_resultado|bloqueado
+    summary: str
+    raw_data: Any
+    source_id: str
+    source_name: str
+    source_url: str | None = None
+    collected_at: datetime = field(default_factory=lambda: datetime.now(timezone.utc))
+    confidence: float = 0.5
+    limitations: str = ""
+    evidence_candidate: bool = True
+    error_message: str | None = None
+
+
+class BaseConnector(ABC):
+    id: str
+    name: str
+
+    @abstractmethod
+    async def fetch(self, payload: dict) -> ConnectorResult: ...
