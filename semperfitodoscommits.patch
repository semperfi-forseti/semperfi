+++ b/backend/app/security/crypto.py
@@ -0,0 +1,75 @@
+"""
+Criptografia de campo (Fernet com rotação de chaves) +
+Mascaramento + Fingerprint determinístico.
+"""
+import hashlib
+import hmac
+import re
+
+from cryptography.fernet import Fernet, MultiFernet
+
+from app.core.config import get_settings
+
+_NON_DIGIT = re.compile(r"\D+")
+_fernet_cache: MultiFernet | None = None
+
+
+def _fernet() -> MultiFernet:
+    global _fernet_cache
+    if _fernet_cache is None:
+        keys = get_settings().fernet_keys_list
+        if not keys:
+            raise RuntimeError("FERNET_KEYS não configurado (gere com Fernet.generate_key()).")
+        _fernet_cache = MultiFernet([Fernet(k.encode() if isinstance(k, str) else k) for k in keys])
+    return _fernet_cache
+
+
+def encrypt_bytes(plain: bytes) -> bytes:
+    return _fernet().encrypt(plain)
+
+
+def decrypt_bytes(token: bytes) -> bytes:
+    return _fernet().decrypt(token)
+
+
+def encrypt_str(plain: str) -> bytes:
+    return encrypt_bytes(plain.encode("utf-8"))
+
+
+def decrypt_str(token: bytes) -> str:
+    return decrypt_bytes(token).decode("utf-8")
+
+
+def rotate(token: bytes) -> bytes:
+    """Re-encripta com a chave ATIVA (primeira da lista)."""
+    return _fernet().rotate(token)
+
+
+# ---------- pseudonimização ----------
+def normalize_doc(value: str) -> str:
+    return _NON_DIGIT.sub("", value or "")
+
+
+def mask_doc(value: str) -> str:
+    v = (value or "").strip()
+    if len(v) <= 4:
+        return "*" * len(v)
+    return v[:2] + "*" * (len(v) - 4) + v[-2:]
+
+
+def fingerprint(value: str) -> str:
+    """HMAC-SHA256(salt, normalize(value))[:12] — determinístico e não-reversível."""
+    salt = get_settings().pseudonymization_salt.get_secret_value().encode()
+    digest = hmac.new(salt, normalize_doc(value).encode(), hashlib.sha256).hexdigest()
+    return digest[:12]
+
+
+def mask_ip(ip: str | None) -> str | None:
+    """Mascaramento de IP para logs (mantém /16 IPv4 e /48 IPv6)."""
+    if not ip:
+        return None
+    if ":" in ip:
+        parts = ip.split(":")
+        return ":".join(parts[:3]) + ":****" if len(parts) > 3 else ip
+    octets = ip.split(".")
+    return ".".join(octets[:2]) + ".0.0" if len(octets) == 4 else ip
