@@ -0,0 +1,25 @@
+"""Cadeia de hash — encadeamento canônico e detecção de adulteração."""
+from app.audit.chain import GENESIS, chain_next, sha256_hex, verify_segment
+
+
+def test_chain_is_canonical_json_invariant():
+    a = chain_next(GENESIS, {"x": 1, "y": 2})
+    b = chain_next(GENESIS, {"y": 2, "x": 1})
+    assert a == b
+
+
+def test_tampering_detected():
+    e1 = {"action": "criacao"}
+    e2 = {"action": "validacao"}
+    h1 = chain_next(GENESIS, e1)
+    h2 = chain_next(h1, e2)
+    events = [{**e1, "previous_hash": GENESIS, "current_hash": h1},
+              {**e2, "previous_hash": h1, "current_hash": h2}]
+    assert verify_segment(events) == (True, None, "ok")
+    events[1]["action"] = "ALTERADO"
+    ok, idx, _ = verify_segment(events)
+    assert not ok and idx == 1
+
+
+def test_sha256_hex_consistency():
+    assert sha256_hex("abc") == sha256_hex(b"abc")
