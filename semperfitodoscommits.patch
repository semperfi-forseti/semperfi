+"""
+Agente Revisor — auditor cruzado das saídas dos demais agentes.
+
+Determinístico (não usa LLM). Checa:
+  - presença de campos obrigatórios (fontes, evidence_ids, limitações, confiança);
+  - ausência de termos proibidos (acusação, conclusão de ilícito, atribuição de culpa);
+  - coerência mínima: confiança ∈ [0,1]; pelo menos 1 evidência referenciada para findings factuais;
+  - hierarquia probatória: nenhum conteúdo que pule de 'indício' direto a 'conclusão'.
+
+Saída: dicionário com {ok: bool, issues: [{code, severity, message}], score}.
+Issues HIGH bloqueiam a promoção a FINAL.
+"""
+import re
+from typing import Any
+
+FORBIDDEN_PATTERNS = [
+    (r"\b(culpado|culpada|culpáveis?)\b", "atribuicao_de_culpa"),
+    (r"\b(criminoso|criminosa|criminosos)\b", "atribuicao_criminal"),
+    (r"\b(é\s+(o|a)\s+responsável)\b", "atribuicao_responsabilidade"),
+    (r"\b(praticou|cometeu)\s+(o\s+)?(crime|delito|fraude|estelionato)\b", "conclusao_de_ilicito"),
+    (r"\b(diagnostic(o|ar))\s+(psiqu|psicol)", "diagnostico_psiquico"),
+]
+
+REQUIRED_FIELDS = ("fontes", "evidence_ids", "limitations", "confidence",
+                   "model_name", "model_version", "prompt_version")
+
+
+def review_agent_output(output: dict[str, Any], *, factual: bool = True) -> dict[str, Any]:
+    issues: list[dict[str, Any]] = []
+
+    for field in REQUIRED_FIELDS:
+        if field not in output:
+            issues.append({"code": "missing_field", "severity": "high",
+                           "message": f"Campo obrigatório ausente: {field}"})
+
+    conf = output.get("confidence")
+    if conf is None or not isinstance(conf, (int, float)) or not (0.0 <= float(conf) <= 1.0):
+        issues.append({"code": "confidence_out_of_range", "severity": "high",
+                       "message": "confidence deve estar em [0,1]."})
+
+    if factual:
+        evs = output.get("evidence_ids") or []
+        if not evs:
+            issues.append({"code": "no_evidence_ref", "severity": "high",
+                           "message": "Conteúdo factual exige pelo menos uma evidência referenciada."})
+
+    summary = (output.get("summary") or "") + " " + (output.get("conclusion") or "")
+    for pattern, code in FORBIDDEN_PATTERNS:
+        if re.search(pattern, summary, flags=re.IGNORECASE):
+            issues.append({"code": f"forbidden:{code}", "severity": "critical",
+                           "message": f"Termo proibido detectado ({code})."})
+
+    limitations = (output.get("limitations") or "").strip()
+    if len(limitations) < 20:
+        issues.append({"code": "weak_limitations", "severity": "medium",
+                       "message": "Seção 'limitations' insuficiente (<20 caracteres)."})
+
+    # score: 1.0 sem issues; -0.1 por medium, -0.3 por high, -0.6 por critical (mín 0)
+    weights = {"low": 0.05, "medium": 0.1, "high": 0.3, "critical": 0.6}
+    score = 1.0 - sum(weights.get(i["severity"], 0.2) for i in issues)
+    score = max(0.0, min(1.0, score))
+
+    blocks_final = any(i["severity"] in {"high", "critical"} for i in issues)
+    return {
+        "ok": not blocks_final,
+        "blocks_final": blocks_final,
+        "issues": issues,
+        "score": round(score, 3),
+        "reviewed_fields": list(REQUIRED_FIELDS),
+    }
