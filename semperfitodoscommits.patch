@@ -0,0 +1,60 @@
+"""Configuração via variáveis de ambiente (Pydantic Settings)."""
+from functools import lru_cache
+from pydantic import Field
+from pydantic_settings import BaseSettings, SettingsConfigDict
+
+
+class Settings(BaseSettings):
+    model_config = SettingsConfigDict(env_file=".env", env_file_encoding="utf-8", extra="ignore")
+
+    # App
+    app_env: str = "development"
+    app_secret: str = "change-me"
+    jwt_private_key_path: str = "./keys/jwt_private.pem"
+    jwt_public_key_path: str = "./keys/jwt_public.pem"
+    jwt_algorithm: str = "RS256"
+    jwt_ttl_minutes: int = 60
+
+    cors_allowed_origins: str = "http://localhost:3000"
+
+    # Database
+    database_url: str = "postgresql+psycopg://semperfi:semperfi@localhost:5432/semperfi"
+
+    # Redis / Celery
+    redis_url: str = "redis://localhost:6379/0"
+    celery_broker_url: str = "redis://localhost:6379/1"
+    celery_result_backend: str = "redis://localhost:6379/2"
+
+    # S3 / MinIO
+    evidence_s3_endpoint: str = "http://localhost:9000"
+    evidence_s3_bucket: str = "semperfi-evidence"
+    evidence_s3_region: str = "us-east-1"
+    evidence_s3_access_key: str = "semperfi"
+    evidence_s3_secret_key: str = "semperfi-secret"
+    evidence_s3_object_lock_mode: str = "COMPLIANCE"  # ou GOVERNANCE
+    evidence_s3_default_retention_days: int = 1825  # 5 anos
+
+    # Connectors
+    brasilapi_base_url: str = "https://brasilapi.com.br/api"
+    transparencia_base_url: str = "https://api.portaldatransparencia.gov.br/api-de-dados"
+    transparencia_api_token: str = ""
+    datajud_base_url: str = "https://api-publica.datajud.cnj.jus.br"
+    datajud_api_key: str = ""
+    cvm_base_url: str = "https://dados.cvm.gov.br/dados"
+    ibge_base_url: str = "https://servicodados.ibge.gov.br/api/v1"
+    rdap_base_url: str = "https://rdap.registro.br"
+
+    pseudonymization_salt: str = Field(default="change-me", min_length=8)
+
+    # TSA (opcional)
+    tsa_url: str = ""
+    tsa_cert_path: str = ""
+
+    @property
+    def cors_origins_list(self) -> list[str]:
+        return [o.strip() for o in self.cors_allowed_origins.split(",") if o.strip()]
+
+
+@lru_cache
+def get_settings() -> Settings:
+    return Settings()
