+"""Endpoints de evidência: listar, validar, criar manual."""
+import base64
+import uuid
+from datetime import datetime, timezone
+
+from fastapi import APIRouter, Depends, HTTPException
+from sqlalchemy.orm import Session
+
+from app.api.deps import db_session, requires
+from app.models import Evidence, EvidenceEvent, Investigation
+from app.schemas.investigation import EvidenceManualCreate, EvidenceOut
+from app.services.audit import write_event
+from app.services.evidence_vault import presigned_url, store_evidence, verify_integrity
+from app.services.hash_chain import GENESIS, chain_next
+
+router = APIRouter(prefix="/api/osint", tags=["evidence"])
+
+
+@router.get("/investigations/{inv_id}/evidence", response_model=list[EvidenceOut])
+def list_evidence(
+    inv_id: str,
+    db: Session = Depends(db_session),
+    user: dict = Depends(requires("evidence.read")),
+):
+    return db.query(Evidence).filter_by(investigation_id=inv_id).order_by(Evidence.collected_at.desc()).all()
+
+
+@router.post("/evidence/manual", response_model=EvidenceOut, status_code=201)
+def create_manual_evidence(
+    data: EvidenceManualCreate,
+    db: Session = Depends(db_session),
+    user: dict = Depends(requires("entity.create")),  # ou role específica
+):
+    inv = db.get(Investigation, data.investigation_id)
+    if not inv:
+        raise HTTPException(404, "Investigação não encontrada")
+    if not data.content_text and not data.content_b64:
+        raise HTTPException(400, "Forneça content_text ou content_b64")
+
+    content = data.content_text.encode("utf-8") if data.content_text else base64.b64decode(data.content_b64)
+    stored = store_evidence(
+        investigation_id=inv.id, content=content,
+        retain_until=inv.retention_until,
+        content_type="text/plain" if data.content_text else "application/octet-stream",
+    )
+    last_ev = db.query(EvidenceEvent).order_by(EvidenceEvent.timestamp.desc()).first()
+    previous_hash = last_ev.current_hash if last_ev else GENESIS
+    payload = {"sha256": stored.sha256, "source": data.source_name, "method": "captura_manual"}
+    current_hash = chain_next(previous_hash, payload)
+
+    ev = Evidence(
+        id=str(uuid.uuid4()),
+        investigation_id=inv.id,
+        source_name=data.source_name, source_type=data.source_type,
+        source_url=data.source_url, collection_method="captura_manual",
+        collected_at_utc=datetime.now(timezone.utc), actor_id=user["id"],
+        raw_storage_key=stored.key, sha256=stored.sha256,
+        previous_event_hash=previous_hash, event_hash=current_hash,
+        validation_status="pendente", retention_until=inv.retention_until,
+    )
+    db.add(ev)
+    db.flush()
+    db.add(EvidenceEvent(
+        id=str(uuid.uuid4()), evidence_id=ev.id, investigation_id=inv.id,
+        action="criacao_manual", actor_id=user["id"],
+        previous_hash=previous_hash, current_hash=current_hash, details=payload,
+    ))
+    db.commit()
+    db.refresh(ev)
+    write_event(db, actor_id=user["id"], actor_role=user["role"], module="osint", action="inclusao_evidencia", target_id=inv.id, metadata={"evidence_id": ev.id, "method": "manual"})
+    return ev
+
+
+@router.post("/evidence/{ev_id}/validate", response_model=EvidenceOut)
+def validate_evidence(
+    ev_id: str,
+    db: Session = Depends(db_session),
+    user: dict = Depends(requires("evidence.validate")),
+):
+    ev = db.get(Evidence, ev_id)
+    if not ev:
+        raise HTTPException(404)
+    if ev.validation_status == "validada":
+        raise HTTPException(400, "Já validada")
+    # Verifica integridade ANTES de validar (proteção crítica)
+    if not verify_integrity(ev.raw_storage_key, ev.sha256):
+        raise HTTPException(409, "Hash da evidência diverge do armazenado — não validar")
+
+    previous_hash = ev.event_hash
+    payload = {"action": "validacao", "reviewer": user["id"], "at": datetime.now(timezone.utc).isoformat()}
+    current_hash = chain_next(previous_hash, payload)
+    ev.validation_status = "validada"
+    ev.reviewer_id = user["id"]
+    ev.event_hash = current_hash
+    db.add(EvidenceEvent(
+        id=str(uuid.uuid4()), evidence_id=ev.id, investigation_id=ev.investigation_id,
+        action="validacao_humana", actor_id=user["id"],
+        previous_hash=previous_hash, current_hash=current_hash, details=payload,
+    ))
+    db.commit()
+    db.refresh(ev)
+    write_event(db, actor_id=user["id"], actor_role=user["role"], module="osint", action="validacao_evidencia", target_id=ev.investigation_id, metadata={"evidence_id": ev.id})
+    return ev
+
+
+@router.get("/evidence/{ev_id}/download")
+def download_evidence(
+    ev_id: str,
+    db: Session = Depends(db_session),
+    user: dict = Depends(requires("evidence.read")),
+):
+    ev = db.get(Evidence, ev_id)
+    if not ev:
+        raise HTTPException(404)
+    # URL pré-assinada (TTL curto) para download direto do S3.
+    return {"url": presigned_url(ev.raw_storage_key, expires_seconds=300)}
