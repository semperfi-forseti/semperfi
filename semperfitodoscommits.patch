diff --git a/backend/app/schemas/investigation.py b/backend/app/schemas/investigation.py
new file mode 100644
index 0000000..2133de3
--- /dev/null
+++ b/backend/app/schemas/investigation.py
@@ -0,0 +1,112 @@
+"""Schemas de investigação, entidade, achado, run, evidência."""
+from datetime import datetime
+from typing import Literal
+from pydantic import BaseModel, Field
+
+Category = Literal[
+    "processual", "patrimonial", "societaria", "fraude",
+    "compliance", "reputacao", "prova_digital", "ciberseguranca_defensiva"
+]
+LegalBasis = Literal[
+    "consentimento", "cumprimento_obrigacao", "exercicio_regular_de_direito",
+    "legitimo_interesse", "tutela_de_saude", "protecao_credito", "dever_legal"
+]
+Scope = Literal[
+    "empresarial", "judicial_publico", "integridade_publica",
+    "mercado_companhias_abertas", "territorial_cadastral",
+    "prova_digital", "seguranca_digital_defensiva"
+]
+Status = Literal[
+    "rascunho", "aguardando_aprovacao", "em_coleta",
+    "pendente_revisao", "concluida", "arquivada", "bloqueada"
+]
+
+
+class InvestigationCreate(BaseModel):
+    title: str = Field(min_length=3, max_length=255)
+    objective: str = Field(min_length=50)
+    hypothesis: str | None = None
+    category: Category
+    legal_basis: LegalBasis
+    legitimate_interest_assessment: str = Field(min_length=20)
+    authorization_reference: str = Field(min_length=3)
+    client_id: str | None = None
+    process_id: str | None = None
+    purpose: str
+    scope: list[Scope] = Field(min_length=1)
+    questions: list[str] = []
+    risk_level: Literal["baixo", "medio", "alto"] = "medio"
+    priority: Literal["baixa", "media", "alta", "critica"] = "media"
+    retention_years: int = Field(default=5, ge=1, le=20)
+    declaration_of_legitimate_purpose: bool  # obrigatório True
+
+
+class InvestigationOut(BaseModel):
+    id: str
+    title: str
+    objective: str
+    category: str
+    status: str
+    owner_id: str
+    scope: list[str]
+    created_at: datetime
+    updated_at: datetime
+    retention_until: datetime
+
+    class Config:
+        from_attributes = True
+
+
+class EntityCreate(BaseModel):
+    entity_type: Literal[
+        "pessoa_fisica", "pessoa_juridica", "processo", "dominio",
+        "endereco", "telefone", "municipio", "banco", "documento", "pagina_web"
+    ]
+    display_name: str
+    document: str | None = None  # CPF/CNPJ/etc — será criptografado e fingerprinted
+    aliases: list[str] = []
+    notes: str | None = None
+
+
+class RunRequest(BaseModel):
+    connector_id: str
+    target_entity_id: str
+    purpose: str = Field(min_length=5)
+    payload: dict = {}
+
+
+class RunOut(BaseModel):
+    id: str
+    connector_id: str
+    status: str
+    started_at: datetime
+    finished_at: datetime | None
+    result_summary: str | None
+    error_message: str | None
+    correlation_id: str
+
+    class Config:
+        from_attributes = True
+
+
+class EvidenceManualCreate(BaseModel):
+    investigation_id: str
+    source_name: str
+    source_url: str | None = None
+    source_type: str = "captura_manual"
+    content_text: str | None = None
+    content_b64: str | None = None  # alternativa para binário
+
+
+class EvidenceOut(BaseModel):
+    id: str
+    investigation_id: str
+    source_name: str
+    sha256: str
+    event_hash: str
+    validation_status: str
+    collected_at: datetime
+    retention_until: datetime
+
+    class Config:
+        from_attributes = True
