-        raise HTTPException(status_code=status.HTTP_401_UNAUTHORIZED, detail=str(e)) from e
-    return {"id": payload["sub"], "role": payload["role"]}
+async def require_mfa(session: dict = Depends(current_session)) -> dict:
+    s = get_settings()
+    if session["role"] in s.mfa_required_roles_set and not session["mfa_verified"]:
+        raise RequireMFA()
+    return session
 
 
