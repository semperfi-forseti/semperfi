+"""Tipos base dos agentes."""
+from dataclasses import dataclass, field
+from typing import Any, Callable, Awaitable
+
+
+@dataclass
+class AgentTool:
+    name: str
+    description: str
+    handler: Callable[[dict], Awaitable[dict]]
+
+
+@dataclass
+class AgentSpec:
+    agent_id: str
+    name: str
+    model_name: str
+    model_version: str
+    prompt_version: str
+    tools: list[AgentTool] = field(default_factory=list)
+    forbidden_outputs: list[str] = field(default_factory=lambda: [
+        "acusacao", "conclusao_de_ilicito", "atribuicao_de_culpa", "diagnostico_psiquico",
+    ])
