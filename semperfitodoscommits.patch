+"""RBAC declarativo."""
+from app.core.rbac import has_permission, require
+
+
+def test_admin_has_everything():
+    assert has_permission("admin", "investigation.create")
+    assert has_permission("admin", "qualquer.coisa.inventada")
+
+
+def test_consulta_cannot_create():
+    assert not has_permission("consulta", "investigation.create")
+    assert has_permission("consulta", "investigation.read")
+
+
+def test_require_raises():
+    import pytest
+    with pytest.raises(PermissionError):
+        require("consulta", "evidence.validate")
+
+
+def test_revisor_validates_not_creates():
+    assert has_permission("revisor", "evidence.validate")
+    assert not has_permission("revisor", "run.execute")
