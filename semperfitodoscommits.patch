+"""
+CVM — Dados Abertos (companhias abertas).
+
+Os dados são publicados como CSVs em https://dados.cvm.gov.br/dados.
+Em produção, fazer ingestão periódica para Postgres (não consultar o CSV ao vivo).
+Este conector é um esboço para o caso de leitura sob demanda.
+"""
+import csv
+import io
+
+import httpx
+
+from app.config import get_settings
+from app.connectors._http import DEFAULT_TIMEOUT, USER_AGENT
+from app.connectors.base import BaseConnector, ConnectorResult
+from app.core.pseudonymize import normalize_doc
+
+settings = get_settings()
+
+
+class CVMCiaAbertaConnector(BaseConnector):
+    id = "cvm_dados_abertos"
+    name = "CVM — Companhias Abertas"
+
+    async def fetch(self, payload: dict) -> ConnectorResult:
+        cnpj = normalize_doc(payload.get("target", ""))
+        # CSV consolidado das companhias abertas (cadastro)
+        url = f"{settings.cvm_base_url}/CIA_ABERTA/CAD/DADOS/cad_cia_aberta.csv"
+        try:
+            async with httpx.AsyncClient(timeout=DEFAULT_TIMEOUT) as cli:
+                r = await cli.get(url, headers={"User-Agent": USER_AGENT})
+                r.raise_for_status()
+                text = r.content.decode("latin-1")
+        except Exception as e:
+            return ConnectorResult(status="erro", summary=f"Falha: {e}", raw_data={}, source_id=self.id, source_name=self.name, source_url=url, error_message=str(e), evidence_candidate=False)
+
+        reader = csv.DictReader(io.StringIO(text), delimiter=";")
+        match = next((row for row in reader if normalize_doc(row.get("CNPJ_CIA", "")) == cnpj), None)
+        if not match:
+            return ConnectorResult(status="sem_resultado", summary="CNPJ não consta como companhia aberta", raw_data={"found": False}, source_id=self.id, source_name=self.name, source_url=url, confidence=0.95)
+        return ConnectorResult(
+            status="ok",
+            summary=f"Companhia aberta: {match.get('DENOM_SOCIAL','—')} — situação {match.get('SIT','—')}",
+            raw_data=match,
+            source_id=self.id, source_name=self.name, source_url=url,
+            confidence=0.95,
+        )
