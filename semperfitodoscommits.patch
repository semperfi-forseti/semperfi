@@ -0,0 +1,163 @@
+"""Upload de evidência + finalize + verify + legal hold (com reauth)."""
+import uuid
+from datetime import datetime, timezone
+
+from fastapi import APIRouter, Depends, File, Form, UploadFile
+from sqlalchemy import select
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from app.api.deps import current_session, get_db, request_ip_masked, require_reauth
+from app.audit.chain import GENESIS, chain_next
+from app.audit.service import AuditService
+from app.core.errors import NotFound, PolicyDenied, TenantIsolationViolation, ValidationFailed
+from app.db.outbox import enqueue
+from app.evidence.mime import detect_real_mime, is_whitelisted
+from app.evidence.vault import EvidenceVault
+from app.models import ApprovalRequest, Evidence, EvidenceEvent, Investigation
+from app.policies import PolicyEngine, PolicyRequest
+
+router = APIRouter(prefix="/evidences", tags=["evidences"])
+
+MAX_BYTES = 50 * 1024 * 1024  # 50 MB no dev; em prod ajustar
+
+
+@router.post("/uploads", status_code=201)
+async def upload_evidence(
+    investigation_id: str = Form(...),
+    source_name: str = Form(...),
+    source_url: str | None = Form(None),
+    file: UploadFile = File(...),
+    session: dict = Depends(current_session),
+    db: AsyncSession = Depends(get_db),
+):
+    inv = await db.get(Investigation, investigation_id)
+    if not inv or inv.tenant_id != session["tenant_id"]:
+        raise TenantIsolationViolation()
+    dec = await PolicyEngine(db).evaluate(PolicyRequest(
+        action="evidence.create", resource="evidence",
+        actor_id=session["user_id"], actor_role=session["role"],
+        tenant_id=session["tenant_id"], mfa_verified=session["mfa_verified"],
+        investigation_id=investigation_id,
+    ))
+    if not dec.allowed:
+        raise PolicyDenied(dec.reason, details={"code": dec.code})
+
+    content = await file.read()
+    if len(content) > MAX_BYTES:
+        raise ValidationFailed("Arquivo excede limite.")
+    real_mime = detect_real_mime(content)
+    if not is_whitelisted(real_mime):
+        raise ValidationFailed(f"MIME '{real_mime}' não permitido.")
+
+    retain = datetime.combine(inv.retention_until, datetime.min.time(), tzinfo=timezone.utc)
+    stored = EvidenceVault.store(
+        tenant_id=session["tenant_id"], investigation_id=investigation_id,
+        content=content, mime_type=real_mime, retain_until=retain,
+        extra_metadata={"source": source_name, "uploaded_by": session["user_id"]},
+    )
+    # Hash chain
+    last_ev = (await db.execute(
+        select(EvidenceEvent.current_hash).order_by(EvidenceEvent.created_at.desc()).limit(1)
+    )).scalar_one_or_none()
+    prev = last_ev or GENESIS
+    payload = {"sha256": stored.sha256, "source": source_name, "uploaded_at": datetime.now(timezone.utc).isoformat()}
+    cur = chain_next(prev, payload)
+
+    ev = Evidence(
+        id=str(uuid.uuid4()), tenant_id=session["tenant_id"], investigation_id=investigation_id,
+        source_name=source_name, source_type="manual_upload", source_url=source_url,
+        collection_method="upload_autenticado",
+        collected_at=datetime.now(timezone.utc), collected_at_utc=datetime.now(timezone.utc),
+        collector_actor_id=session["user_id"],
+        s3_bucket=stored.bucket, s3_key=stored.key, s3_version_id=stored.version_id,
+        s3_etag=stored.etag, object_lock_mode=stored.object_lock_mode,
+        retain_until=retain, mime_type=real_mime, size_bytes=len(content),
+        sha256=stored.sha256, previous_event_hash=prev, event_hash=cur,
+        validation_status="pendente", av_status="pendente",
+    )
+    db.add(ev)
+    db.add(EvidenceEvent(id=str(uuid.uuid4()), tenant_id=session["tenant_id"],
+                          evidence_id=ev.id, investigation_id=investigation_id,
+                          action="upload", actor_id=session["user_id"],
+                          occurred_at=datetime.now(timezone.utc),
+                          previous_hash=prev, current_hash=cur, details=payload))
+    # Despacha pipeline AV → metadata → OCR
+    await enqueue(db, task_name="app.workers.tasks.evidence_pipeline.scan_av",
+                  queue="cpu_heavy", tenant_id=session["tenant_id"],
+                  payload={"evidence_id": ev.id})
+    await enqueue(db, task_name="app.workers.tasks.evidence_pipeline.extract_metadata",
+                  queue="cpu_heavy", tenant_id=session["tenant_id"],
+                  payload={"evidence_id": ev.id})
+    await AuditService(db).write(action="evidence.upload", resource="evidence", resource_id=ev.id,
+                                 tenant_id=session["tenant_id"], actor_id=session["user_id"],
+                                 actor_role=session["role"], metadata={"sha256_prefix": stored.sha256[:16]})
+    await db.commit()
+    return {"id": ev.id, "sha256": stored.sha256, "mime": real_mime, "size": len(content)}
+
+
+@router.post("/{eid}/finalize")
+async def finalize(eid: str, session: dict = Depends(current_session), db: AsyncSession = Depends(get_db)):
+    ev = await db.get(Evidence, eid)
+    if not ev or ev.tenant_id != session["tenant_id"]:
+        raise TenantIsolationViolation()
+    if ev.av_status != "ok":
+        raise ValidationFailed("Pipeline AV ainda não concluído ou infectado.")
+    return {"status": "ok", "mime": ev.mime_type, "sha256": ev.sha256}
+
+
+@router.post("/{eid}/verify")
+async def verify(eid: str, session: dict = Depends(current_session), db: AsyncSession = Depends(get_db)):
+    """Recalcula hash a partir do S3 antes de validar."""
+    ev = await db.get(Evidence, eid)
+    if not ev or ev.tenant_id != session["tenant_id"]:
+        raise TenantIsolationViolation()
+    EvidenceVault.verify_integrity(ev.s3_key, ev.sha256)
+    prev = ev.event_hash
+    payload = {"action": "validacao", "reviewer": session["user_id"], "at": datetime.now(timezone.utc).isoformat()}
+    cur = chain_next(prev, payload)
+    ev.validation_status = "validada"
+    ev.reviewer_id = session["user_id"]
+    ev.event_hash = cur
+    db.add(EvidenceEvent(id=str(uuid.uuid4()), tenant_id=session["tenant_id"], evidence_id=ev.id,
+                          investigation_id=ev.investigation_id, action="validacao_humana",
+                          actor_id=session["user_id"], occurred_at=datetime.now(timezone.utc),
+                          previous_hash=prev, current_hash=cur, details=payload))
+    await AuditService(db).write(action="evidence.verify", resource="evidence", resource_id=ev.id,
+                                 tenant_id=session["tenant_id"], actor_id=session["user_id"], actor_role=session["role"])
+    await db.commit()
+    return {"status": "validada", "event_hash": cur}
+
+
+@router.post("/{eid}/legal-hold")
+async def legal_hold(eid: str, enable: bool,
+                     session: dict = Depends(require_reauth),  # exige reauth step-up
+                     db: AsyncSession = Depends(get_db)):
+    ev = await db.get(Evidence, eid)
+    if not ev or ev.tenant_id != session["tenant_id"]:
+        raise TenantIsolationViolation()
+    # Dupla confirmação: cria ApprovalRequest; gestor diferente decide
+    ap = ApprovalRequest(
+        id=str(uuid.uuid4()), tenant_id=session["tenant_id"],
+        resource_type="evidence_legal_hold", resource_id=ev.id,
+        action=f"legal_hold:{'on' if enable else 'off'}",
+        requested_by=session["user_id"], status="pending",
+    )
+    db.add(ap)
+    await AuditService(db).write(action="evidence.legal_hold_request", resource="evidence",
+                                 resource_id=ev.id, tenant_id=session["tenant_id"],
+                                 actor_id=session["user_id"], actor_role=session["role"],
+                                 metadata={"enable": enable, "approval_id": ap.id})
+    await db.commit()
+    return {"status": "approval_required", "approval_id": ap.id}
+
+
+@router.get("/{eid}/download")
+async def download(eid: str, session: dict = Depends(require_reauth), db: AsyncSession = Depends(get_db)):
+    ev = await db.get(Evidence, eid)
+    if not ev or ev.tenant_id != session["tenant_id"]:
+        raise TenantIsolationViolation()
+    url = EvidenceVault.presigned_get(ev.s3_key, expires_seconds=60)
+    await AuditService(db).write(action="evidence.download", resource="evidence", resource_id=ev.id,
+                                 tenant_id=session["tenant_id"], actor_id=session["user_id"], actor_role=session["role"])
+    await db.commit()
+    return {"url": url, "expires_in": 60}
