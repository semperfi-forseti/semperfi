+"""
+Transactional Outbox.
+
+Padrão: ao executar uma operação de negócio que precisa disparar uma
+tarefa assíncrona, insere-se um registro em `outbox_messages` na MESMA
+transação. Um relay (Celery beat) varre e despacha as mensagens.
+
+Garantia: ou ambos persistem (negócio + outbox) ou nada — evita perda
+de mensagem em caso de falha entre commit e enqueue.
+"""
+import uuid
+from typing import Any
+
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from app.models.outbox import OutboxMessage
+
+
+async def enqueue(
+    session: AsyncSession,
+    *,
+    task_name: str,
+    payload: dict[str, Any],
+    queue: str = "default",
+    tenant_id: str | None = None,
+    correlation_id: str | None = None,
+) -> str:
+    msg = OutboxMessage(
+        id=str(uuid.uuid4()),
+        tenant_id=tenant_id,
+        task_name=task_name,
+        queue=queue,
+        payload=payload,
+        correlation_id=correlation_id,
+        status="pending",
+    )
+    session.add(msg)
+    await session.flush()
+    return msg.id
