+    app.add_middleware(CORSMiddleware, allow_origins=s.cors_origins_list,
+                       allow_credentials=True,
+                       allow_methods=["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"],
+                       allow_headers=["*"], expose_headers=["X-Correlation-Id"])
+    app.add_middleware(SecurityHeadersMiddleware)
+    app.add_middleware(CSRFMiddleware)
+    install_exception_handlers(app)
+
+    @app.middleware("http")
+    async def _metrics(request: Request, call_next):
+        route = request.url.path
+        with REQ_LATENCY.labels(request.method, route).time():
+            response = await call_next(request)
+        REQ_COUNTER.labels(request.method, route, response.status_code).inc()
+        return response
+
+    @app.get("/health/live", tags=["health"])
+    async def liveness() -> dict:
+        return {"status": "live"}
+
+    @app.get("/health/ready", tags=["health"])
+    async def readiness() -> dict:
+        # Em prod, checar DB/Redis aqui.
+        return {"status": "ready"}
+
+    if s.prometheus_enabled:
+        @app.get("/metrics", include_in_schema=False)
+        async def metrics() -> Response:
+            return metrics_endpoint()
+
+    if s.otel_enabled:
+        configure_otel(app)
+    configure_sentry(s.sentry_dsn)
+
+    app.include_router(v1_router)
+    return app
+
+
+app = create_app()
