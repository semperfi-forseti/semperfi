@@ -0,0 +1,74 @@
+import uuid
+
+from fastapi import APIRouter, Depends
+from pydantic import BaseModel, Field
+from sqlalchemy import select
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from app.api.deps import current_session, get_db
+from app.audit.service import AuditService
+from app.core.errors import NotFound, PolicyDenied, TenantIsolationViolation
+from app.models import Process, ProcessMovement
+from app.policies import PolicyEngine, PolicyRequest
+
+router = APIRouter(prefix="/processes", tags=["processes"])
+
+
+class ProcessIn(BaseModel):
+    number: str = Field(min_length=5, max_length=40)
+    client_id: str | None = None
+    court: str | None = None
+    area: str | None = None
+    phase: str | None = None
+    responsible: str | None = None
+    value: float = 0.0
+    notes: str | None = None
+
+
+async def _policy(db, sess, action, rid=None):
+    dec = await PolicyEngine(db).evaluate(PolicyRequest(
+        action=action, resource="process", resource_id=rid,
+        actor_id=sess["user_id"], actor_role=sess["role"], tenant_id=sess["tenant_id"],
+        mfa_verified=sess["mfa_verified"],
+    ))
+    if not dec.allowed:
+        raise PolicyDenied(dec.reason, details={"code": dec.code})
+
+
+@router.get("")
+async def list_processes(session: dict = Depends(current_session), db: AsyncSession = Depends(get_db),
+                          limit: int = 50, offset: int = 0):
+    await _policy(db, session, "process.read")
+    rows = (await db.execute(
+        select(Process).where(Process.tenant_id == session["tenant_id"], Process.is_deleted.is_(False))
+        .order_by(Process.created_at.desc()).limit(limit).offset(offset)
+    )).scalars().all()
+    return [{"id": p.id, "number": p.number, "court": p.court, "area": p.area,
+             "phase": p.phase, "status": p.status, "value": p.value} for p in rows]
+
+
+@router.post("", status_code=201)
+async def create_process(data: ProcessIn, session: dict = Depends(current_session), db: AsyncSession = Depends(get_db)):
+    await _policy(db, session, "process.create")
+    p = Process(id=str(uuid.uuid4()), tenant_id=session["tenant_id"], **data.model_dump())
+    db.add(p)
+    await AuditService(db).write(action="process.create", resource="process", resource_id=p.id,
+                                 tenant_id=session["tenant_id"], actor_id=session["user_id"], actor_role=session["role"])
+    await db.commit()
+    return {"id": p.id}
+
+
+@router.get("/{pid}")
+async def get_process(pid: str, session: dict = Depends(current_session), db: AsyncSession = Depends(get_db)):
+    await _policy(db, session, "process.read", pid)
+    p = await db.get(Process, pid)
+    if not p or p.is_deleted:
+        raise NotFound()
+    if p.tenant_id != session["tenant_id"]:
+        raise TenantIsolationViolation()
+    movs = (await db.execute(select(ProcessMovement).where(ProcessMovement.process_id == pid)
+                              .order_by(ProcessMovement.date.desc()))).scalars().all()
+    return {"id": p.id, "number": p.number, "court": p.court, "area": p.area,
+            "phase": p.phase, "status": p.status, "value": p.value,
+            "movements": [{"id": m.id, "date": m.date.isoformat(), "type": m.type,
+                          "description": m.description, "source": m.source} for m in movs]}
