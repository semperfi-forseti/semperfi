+  const evidenceBytes = (DB.files||[]).reduce((s,f)=>s+(f.size||0),0)
+                     + (DB.evidence||[]).reduce((s,e)=>s+(e.size||0),0);
+  return {
+    storedProcesses: (DB.processes||[]).length,
+    monitoredProcesses: (DB.processes||[]).filter(p=>p.monitored && p.status!=='arquivado').length,
