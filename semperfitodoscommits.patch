@@ -0,0 +1,203 @@
+"""
+Agente Coordenador — orquestra uma pipeline declarativa de agentes.
+
+Princípios:
+  - Toda etapa passa por PolicyEngine.evaluate ANTES de ser enfileirada.
+  - O coordenador NÃO produz conteúdo factual: apenas decide a próxima etapa,
+    encadeia entradas/saídas e marca status.
+  - Saída final é sempre DRAFT até revisão humana (mesmo o relatório).
+  - Cada transição vai para audit_events e step_history.
+"""
+import uuid
+from dataclasses import dataclass
+from datetime import datetime, timezone
+from typing import Any
+
+from sqlalchemy import select
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from app.audit.service import AuditService
+from app.db.outbox import enqueue
+from app.models import AgentDAGRun, AgentRun
+
+
+@dataclass(frozen=True)
+class PipelineStep:
+    step_id: str            # nome lógico (ex: "coleta")
+    agent_id: str           # id no registry
+    requires: tuple[str, ...] = ()
+    blocking: bool = True   # se False, falha não interrompe pipeline
+
+
+@dataclass(frozen=True)
+class PipelineSpec:
+    pipeline_id: str
+    version: str
+    description: str
+    steps: tuple[PipelineStep, ...]
+
+
+# Pipeline padrão TACER + revisão cruzada + compliance.
+DEFAULT_INVESTIGATION_PIPELINE = PipelineSpec(
+    pipeline_id="investigation_full",
+    version="1.0",
+    description="Coleta → metadados → timeline → correlação → inconsistência → relatório → revisão jurídica → compliance.",
+    steps=(
+        PipelineStep("coleta", "coleta"),
+        PipelineStep("metadados", "metadados", requires=("coleta",)),
+        PipelineStep("timeline", "timeline", requires=("metadados",)),
+        PipelineStep("correlacao", "correlacao", requires=("timeline",)),
+        PipelineStep("inconsistencia", "inconsistencia", requires=("correlacao",)),
+        PipelineStep("relatorio", "relatorio", requires=("inconsistencia",)),
+        PipelineStep("revisao_juridica", "revisao_juridica", requires=("relatorio",)),
+        PipelineStep("revisao_cruzada", "reviewer", requires=("relatorio",)),
+        PipelineStep("compliance", "compliance", requires=("relatorio",), blocking=False),
+    ),
+)
+
+OSINT_LIGHT_PIPELINE = PipelineSpec(
+    pipeline_id="osint_light",
+    version="1.0",
+    description="Coleta + metadados + relatório curto + compliance.",
+    steps=(
+        PipelineStep("coleta", "coleta"),
+        PipelineStep("metadados", "metadados", requires=("coleta",)),
+        PipelineStep("relatorio", "relatorio", requires=("metadados",)),
+        PipelineStep("compliance", "compliance", requires=("relatorio",), blocking=False),
+    ),
+)
+
+_PIPELINES: dict[str, PipelineSpec] = {
+    DEFAULT_INVESTIGATION_PIPELINE.pipeline_id: DEFAULT_INVESTIGATION_PIPELINE,
+    OSINT_LIGHT_PIPELINE.pipeline_id: OSINT_LIGHT_PIPELINE,
+}
+
+
+def get_pipeline(pipeline_id: str) -> PipelineSpec:
+    if pipeline_id not in _PIPELINES:
+        raise KeyError(f"Pipeline '{pipeline_id}' não registrada.")
+    return _PIPELINES[pipeline_id]
+
+
+def list_pipelines() -> list[dict[str, Any]]:
+    return [
+        {
+            "pipeline_id": p.pipeline_id, "version": p.version,
+            "description": p.description,
+            "steps": [{"step_id": s.step_id, "agent_id": s.agent_id, "blocking": s.blocking} for s in p.steps],
+        }
+        for p in _PIPELINES.values()
+    ]
+
+
+def _ready_steps(spec: PipelineSpec, history: list[dict]) -> list[PipelineStep]:
+    """Retorna passos cujos requisitos já concluíram (FINAL ou DRAFT_OK) e ainda não foram executados."""
+    done = {h["step_id"] for h in history if h.get("status") in {"FINAL", "DRAFT", "DRAFT_OK"}}
+    failed_blocking = {h["step_id"] for h in history if h.get("status") == "FAILED" and h.get("blocking", True)}
+    if failed_blocking:
+        return []
+    ready: list[PipelineStep] = []
+    for step in spec.steps:
+        if step.step_id in done:
+            continue
+        if any(h["step_id"] == step.step_id and h.get("status") == "RUNNING" for h in history):
+            continue
+        if all(req in done for req in step.requires):
+            ready.append(step)
+    return ready
+
+
+async def advance_dag(dag_run_id: str, db: AsyncSession) -> dict[str, Any]:
+    """
+    Avança um DAGRun: enfileira passos prontos e marca terminal quando nada mais sobra.
+    Chamado pelo worker após cada AgentRun terminar.
+    """
+    dag = await db.get(AgentDAGRun, dag_run_id)
+    if not dag:
+        return {"status": "not_found"}
+    if dag.status in {"completed", "failed", "blocked"}:
+        return {"status": dag.status}
+
+    spec = get_pipeline(dag.pipeline_id)
+    history = list(dag.step_history or [])
+
+    # Sincroniza histórico com AgentRuns existentes
+    if dag.agent_run_ids:
+        rows = (await db.execute(select(AgentRun).where(AgentRun.id.in_(dag.agent_run_ids)))).scalars().all()
+        for ar in rows:
+            for h in history:
+                if h.get("agent_run_id") == ar.id and h.get("status") != ar.status:
+                    h["status"] = ar.status
+                    h["updated_at"] = datetime.now(timezone.utc).isoformat()
+
+    # Verifica condições terminais
+    failed_blocking = any(h.get("status") == "FAILED" and h.get("blocking", True) for h in history)
+    if failed_blocking:
+        dag.status = "failed"
+        dag.finished_at = datetime.now(timezone.utc)
+        dag.step_history = history
+        await AuditService(db).write(
+            action="agent_dag.failed", resource="agent_dag_run", resource_id=dag.id,
+            tenant_id=dag.tenant_id, result="erro",
+            metadata={"pipeline": dag.pipeline_id},
+        )
+        return {"status": "failed"}
+
+    ready = _ready_steps(spec, history)
+    if not ready:
+        all_done = all(
+            any(h["step_id"] == s.step_id and h.get("status") in {"FINAL", "DRAFT", "DRAFT_OK"} for h in history)
+            for s in spec.steps if s.blocking
+        )
+        if all_done:
+            dag.status = "completed"
+            dag.finished_at = datetime.now(timezone.utc)
+            await AuditService(db).write(
+                action="agent_dag.completed", resource="agent_dag_run", resource_id=dag.id,
+                tenant_id=dag.tenant_id, metadata={"pipeline": dag.pipeline_id},
+            )
+        else:
+            dag.status = "partial"
+        dag.step_history = history
+        return {"status": dag.status}
+
+    # Enfileira novos passos
+    spawned: list[str] = []
+    for step in ready:
+        spec_agent = step.agent_id  # apenas log
+        from app.agents.registry import get_agent
+        agent_spec = get_agent(spec_agent)
+        run = AgentRun(
+            id=str(uuid.uuid4()), tenant_id=dag.tenant_id,
+            investigation_id=dag.investigation_id, agent_id=step.agent_id,
+            model_name=agent_spec.model_name, model_version=agent_spec.model_version,
+            prompt_version=agent_spec.prompt_version,
+            input_payload={"dag_run_id": dag.id, "step_id": step.step_id},
+            output_payload={}, evidence_ids=[], status="DRAFT",
+            started_at=datetime.now(timezone.utc),
+        )
+        db.add(run)
+        await db.flush()
+        history.append({
+            "step_id": step.step_id, "agent_id": step.agent_id, "agent_run_id": run.id,
+            "status": "RUNNING", "blocking": step.blocking,
+            "started_at": datetime.now(timezone.utc).isoformat(),
+        })
+        dag.agent_run_ids = list(dag.agent_run_ids or []) + [run.id]
+        await enqueue(
+            db, task_name="app.workers.tasks.agents.run", queue="agents",
+            tenant_id=dag.tenant_id, payload={"agent_run_id": run.id, "dag_run_id": dag.id},
+            correlation_id=dag.correlation_id,
+        )
+        spawned.append(run.id)
+
+    dag.status = "running"
+    if not dag.started_at:
+        dag.started_at = datetime.now(timezone.utc)
+    dag.current_step = ",".join(s.step_id for s in ready)
+    dag.step_history = history
+    await AuditService(db).write(
+        action="agent_dag.advanced", resource="agent_dag_run", resource_id=dag.id,
+        tenant_id=dag.tenant_id, metadata={"spawned": len(spawned), "steps": [s.step_id for s in ready]},
+    )
+    return {"status": "running", "spawned": spawned}
