+"""
+RDAP / DNS — consulta apenas em domínios PRÓPRIOS ou expressamente
+autorizados (segurança digital defensiva). O motor de políticas
+deve impedir uso fora desse contexto.
+"""
+from app.config import get_settings
+from app.connectors._http import request_json
+from app.connectors.base import BaseConnector, ConnectorResult
+
+settings = get_settings()
+
+
+class RDAPConnector(BaseConnector):
+    id = "rdap_dns"
+    name = "RDAP — Registro de Domínio"
+
+    async def fetch(self, payload: dict) -> ConnectorResult:
+        domain = (payload.get("target") or "").strip().lower()
+        if not domain:
+            return ConnectorResult(status="erro", summary="Domínio não informado", raw_data={}, source_id=self.id, source_name=self.name, evidence_candidate=False)
+        # Registro.br para domínios .br; fallback para IANA.
+        url = f"{settings.rdap_base_url}/domain/{domain}"
+        try:
+            data = await request_json("GET", url)
+        except Exception as e:
+            return ConnectorResult(status="erro", summary=f"Falha: {e}", raw_data={}, source_id=self.id, source_name=self.name, source_url=url, error_message=str(e), evidence_candidate=False)
+        return ConnectorResult(
+            status="ok",
+            summary=f"RDAP {domain} — eventos: {len(data.get('events', []))}",
+            raw_data=data,
+            source_id=self.id, source_name=self.name, source_url=url,
+            confidence=0.85,
+            limitations="Apenas para domínios próprios ou autorizados.",
+        )
