@@ -0,0 +1,70 @@
+"""Tasks Celery: backup full diário, verificação periódica, restore dry-run semanal."""
+import asyncio
+
+from sqlalchemy import select
+
+from app.audit.service import AuditService
+from app.backup.service import restore_dry_run, run_full_backup, verify_backup
+from app.db.base import SessionLocal
+from app.models import BackupRun
+from app.workers.celery_app import celery_app
+
+
+@celery_app.task(name="app.workers.tasks.backup.run_full", bind=True)
+def run_full(self) -> dict:
+    return asyncio.run(_run_full())
+
+
+async def _run_full() -> dict:
+    async with SessionLocal() as session:
+        try:
+            r = await run_full_backup(session)
+            return {"backup_id": r.backup_id, "size": r.size_bytes, "kek": r.kek_id}
+        except Exception as exc:
+            await AuditService(session).write(
+                action="backup.failed", resource="backup_run",
+                result="erro", metadata={"error": str(exc)[:300]},
+            )
+            await session.commit()
+            return {"error": str(exc)[:300]}
+
+
+@celery_app.task(name="app.workers.tasks.backup.verify_recent", bind=True)
+def verify_recent(self, limit: int = 5, deep: bool = True) -> dict:
+    return asyncio.run(_verify_recent(limit, deep))
+
+
+async def _verify_recent(limit: int, deep: bool) -> dict:
+    ok = bad = 0
+    async with SessionLocal() as session:
+        rows = (await session.execute(
+            select(BackupRun).where(BackupRun.status.in_(("success", "verified")))
+            .order_by(BackupRun.started_at.desc()).limit(limit)
+        )).scalars().all()
+        for br in rows:
+            try:
+                await verify_backup(br.id, session, deep=deep)
+                ok += 1
+            except Exception:
+                bad += 1
+        return {"verified": ok, "failed": bad}
+
+
+@celery_app.task(name="app.workers.tasks.backup.weekly_restore_dry_run", bind=True)
+def weekly_restore_dry_run(self) -> dict:
+    return asyncio.run(_dry_run())
+
+
+async def _dry_run() -> dict:
+    async with SessionLocal() as session:
+        latest = (await session.execute(
+            select(BackupRun).where(BackupRun.status.in_(("success", "verified")))
+            .order_by(BackupRun.started_at.desc()).limit(1)
+        )).scalars().first()
+        if not latest:
+            return {"status": "no_backup"}
+        try:
+            res = await restore_dry_run(latest.id, session)
+            return res
+        except Exception as exc:
+            return {"backup_id": latest.id, "error": str(exc)[:300]}
