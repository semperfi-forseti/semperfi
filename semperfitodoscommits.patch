new file mode 100644
index 0000000..addb196
--- /dev/null
+++ b/backend/tests/test_hash_chain.py
@@ -0,0 +1,36 @@
+"""Hash chain: encadeamento, detecção de adulteração."""
+from app.services.hash_chain import GENESIS, chain_next, sha256_hex, verify_chain
+
+
+def test_genesis_chain():
+    h = chain_next(GENESIS, {"a": 1})
+    assert len(h) == 64
+    assert h != GENESIS
+
+
+def test_chain_is_deterministic():
+    a = chain_next(GENESIS, {"x": "y", "n": 1})
+    b = chain_next(GENESIS, {"n": 1, "x": "y"})  # ordem inversa
+    assert a == b, "Canonical JSON deve ser key-sorted"
+
+
+def test_chain_detects_tampering():
+    e1 = {"action": "criacao", "payload": "abc"}
+    e2 = {"action": "validacao", "payload": "xyz"}
+    h1 = chain_next(GENESIS, e1)
+    h2 = chain_next(h1, e2)
+    events = [
+        {**e1, "previous_hash": GENESIS, "current_hash": h1},
+        {**e2, "previous_hash": h1, "current_hash": h2},
+    ]
+    ok, idx = verify_chain(events)
+    assert ok and idx is None
+
+    # Adultera o segundo evento
+    events[1]["payload"] = "adulterado"
+    ok, idx = verify_chain(events)
+    assert not ok and idx == 1
+
+
+def test_sha256_hex_consistency():
+    assert sha256_hex("abc") == sha256_hex(b"abc")
diff --git a/backend/tests/test_policy.py b/backend/tests/test_policy.py
new file mode 100644
index 0000000..2de23b1
--- /dev/null
+++ b/backend/tests/test_policy.py
@@ -0,0 +1,85 @@
+"""Motor de políticas — barreira ANTES da coleta."""
+from datetime import datetime, timedelta, timezone
+
+import pytest
+from sqlalchemy import create_engine
+from sqlalchemy.orm import sessionmaker
+
+from app.database import Base
+from app.models import Investigation, OsintEntity, SourceCatalog
+from app.services.policy_engine import FORBIDDEN_KEYWORDS, evaluate_run
+
+
+@pytest.fixture
+def db():
+    engine = create_engine("sqlite:///:memory:")
+    Base.metadata.create_all(engine)
+    Session = sessionmaker(bind=engine)
+    s = Session()
+    yield s
+    s.close()
+
+
+def _make_investigation(db, *, status="em_coleta", scope=("empresarial",)):
+    inv = Investigation(
+        id="inv-1", title="T", objective="o" * 60, category="compliance",
+        legal_basis="legitimo_interesse", legitimate_interest_assessment="x" * 30,
+        authorization_reference="ref-1", owner_id="u1", status=status,
+        scope=list(scope), retention_until=datetime.now(timezone.utc) + timedelta(days=30),
+    )
+    db.add(inv)
+    db.add(SourceCatalog(
+        id="brasilapi_cnpj", name="BrasilAPI CNPJ", category="empresarial",
+        connector_type="rest", enabled=True, requires_token=False,
+        allowed_target_types=["pessoa_juridica"], terms_accepted=True,
+    ))
+    db.add(OsintEntity(
+        id="e-1", investigation_id="inv-1", entity_type="pessoa_juridica",
+        display_name="ABC", normalized_name="ABC",
+    ))
+    db.commit()
+    return inv
+
+
+def test_allows_when_in_scope(db):
+    _make_investigation(db)
+    d = evaluate_run(db, investigation_id="inv-1", connector_id="brasilapi_cnpj", target_entity_id="e-1")
+    assert d.allowed
+    assert d.audit_action == "execucao_coleta"
+
+
+def test_blocks_when_status_is_rascunho(db):
+    _make_investigation(db, status="rascunho")
+    d = evaluate_run(db, investigation_id="inv-1", connector_id="brasilapi_cnpj", target_entity_id="e-1")
+    assert not d.allowed
+    assert "rascunho" in d.reason
+
+
+def test_blocks_when_scope_does_not_include_source_category(db):
+    _make_investigation(db, scope=("judicial_publico",))
+    d = evaluate_run(db, investigation_id="inv-1", connector_id="brasilapi_cnpj", target_entity_id="e-1")
+    assert not d.allowed
+    assert "fora do escopo" in d.reason
+
+
+def test_blocks_forbidden_tags(db):
+    _make_investigation(db)
+    d = evaluate_run(
+        db, investigation_id="inv-1", connector_id="brasilapi_cnpj",
+        target_entity_id="e-1",
+        requested_action_tags={"reconhecimento_facial"},
+    )
+    assert not d.allowed
+    assert "vedada" in d.reason
+
+
+def test_concluded_investigation_is_read_only(db):
+    _make_investigation(db, status="concluida")
+    d = evaluate_run(db, investigation_id="inv-1", connector_id="brasilapi_cnpj", target_entity_id="e-1")
+    assert not d.allowed
+
+
+def test_forbidden_keywords_present():
+    assert "reconhecimento_facial" in FORBIDDEN_KEYWORDS
+    assert "captcha_bypass" in FORBIDDEN_KEYWORDS
+    assert "vazamento" in FORBIDDEN_KEYWORDS
