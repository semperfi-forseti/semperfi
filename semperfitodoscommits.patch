+[project]
+name = "semperfi-osint-backend"
+version = "1.0.0"
+description = "Backend OSINT do SEMPER-FI — coleta pública, cadeia de custódia, relatório técnico"
+requires-python = ">=3.11"
+dependencies = [
+  "fastapi==0.115.0",
+  "uvicorn[standard]==0.30.6",
+  "pydantic==2.9.2",
+  "pydantic-settings==2.5.2",
+  "sqlalchemy==2.0.35",
+  "alembic==1.13.3",
+  "psycopg[binary]==3.2.3",
+  "httpx==0.27.2",
+  "celery[redis]==5.4.0",
+  "redis==5.1.1",
+  "boto3==1.35.36",
+  "python-jose[cryptography]==3.3.0",
+  "passlib[bcrypt]==1.7.4",
+  "structlog==24.4.0",
+  "prometheus-client==0.21.0",
+  "tenacity==9.0.0",
+  "python-multipart==0.0.12",
+]
+
+[project.optional-dependencies]
+dev = [
+  "pytest==8.3.3",
+  "pytest-asyncio==0.24.0",
+  "pytest-cov==5.0.0",
+  "ruff==0.6.9",
+  "mypy==1.11.2",
+  "httpx==0.27.2",
