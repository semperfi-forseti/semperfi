+"""Relatórios versionados — gerar, aprovar (com reauth), baixar."""
+import uuid
+from datetime import datetime, timezone
+
+from fastapi import APIRouter, Depends
+from pydantic import BaseModel
+from sqlalchemy import select
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from app.api.deps import current_session, get_db, require_reauth
+from app.audit.service import AuditService
+from app.core.errors import NotFound, PolicyDenied, TenantIsolationViolation
+from app.db.outbox import enqueue
+from app.evidence.vault import EvidenceVault
+from app.models import Report, ReportApproval
+from app.policies import PolicyEngine, PolicyRequest
+
+router = APIRouter(prefix="/reports", tags=["reports"])
+
+
+class ReportIn(BaseModel):
+    investigation_id: str
+    title: str
+    evidence_ids: list[str] = []
+    sections: dict = {}
+
+
+@router.post("", status_code=202)
+async def create_report(data: ReportIn, session: dict = Depends(current_session), db: AsyncSession = Depends(get_db)):
+    dec = await PolicyEngine(db).evaluate(PolicyRequest(
+        action="report.create", resource="report",
+        actor_id=session["user_id"], actor_role=session["role"],
+        tenant_id=session["tenant_id"], mfa_verified=session["mfa_verified"],
+        investigation_id=data.investigation_id,
+    ))
+    if not dec.allowed:
+        raise PolicyDenied(dec.reason, details={"code": dec.code})
+    # próxima versão para essa investigação
+    prev_max = (await db.execute(
+        select(Report.version).where(Report.investigation_id == data.investigation_id).order_by(Report.version.desc()).limit(1)
+    )).scalar_one_or_none()
+    rpt = Report(
+        id=str(uuid.uuid4()), tenant_id=session["tenant_id"],
+        investigation_id=data.investigation_id, version=(prev_max or 0) + 1,
+        title=data.title, status="DRAFT",
+        evidence_ids=data.evidence_ids, sections=data.sections,
+        generated_by=session["user_id"],
+    )
+    db.add(rpt)
+    await enqueue(db, task_name="app.workers.tasks.reports.generate", queue="cpu_heavy",
+                  tenant_id=session["tenant_id"], payload={"report_id": rpt.id})
+    await AuditService(db).write(action="report.submit", resource="report", resource_id=rpt.id,
+                                 tenant_id=session["tenant_id"], actor_id=session["user_id"], actor_role=session["role"])
+    await db.commit()
+    return {"id": rpt.id, "version": rpt.version, "status": rpt.status}
+
+
+@router.post("/{rid}/approve")
+async def approve_report(rid: str, decision: str = "approve",
+                         session: dict = Depends(require_reauth),  # reauth obrigatório
+                         db: AsyncSession = Depends(get_db)):
+    rpt = await db.get(Report, rid)
+    if not rpt or rpt.tenant_id != session["tenant_id"]:
+        raise TenantIsolationViolation()
+    dec = await PolicyEngine(db).evaluate(PolicyRequest(
+        action="report.approve_final", resource="report", resource_id=rid,
+        actor_id=session["user_id"], actor_role=session["role"],
+        tenant_id=session["tenant_id"], mfa_verified=True, reauth_verified=True,
+    ))
+    if not dec.allowed:
+        raise PolicyDenied(dec.reason, details={"code": dec.code})
+    ap = ReportApproval(id=str(uuid.uuid4()), tenant_id=session["tenant_id"],
+                        report_id=rid, approver_id=session["user_id"],
+                        decision=decision, decided_at=datetime.now(timezone.utc),
+                        reauth_token_jti=session["jti"])
+    db.add(ap)
+    rpt.status = "FINAL" if decision == "approve" else "ARCHIVED"
+    await AuditService(db).write(action="report.approve", resource="report", resource_id=rid,
+                                 tenant_id=session["tenant_id"], actor_id=session["user_id"],
+                                 actor_role=session["role"], metadata={"decision": decision})
+    await db.commit()
+    return {"status": rpt.status, "approval_id": ap.id}
+
+
+@router.get("/{rid}/download")
+async def download_report(rid: str, session: dict = Depends(require_reauth), db: AsyncSession = Depends(get_db)):
+    rpt = await db.get(Report, rid)
+    if not rpt or rpt.tenant_id != session["tenant_id"]:
+        raise TenantIsolationViolation()
+    if not rpt.s3_key:
+        raise NotFound("PDF ainda não gerado.")
+    url = EvidenceVault.presigned_get(rpt.s3_key, expires_seconds=120)
+    await AuditService(db).write(action="report.download", resource="report", resource_id=rid,
+                                 tenant_id=session["tenant_id"], actor_id=session["user_id"], actor_role=session["role"])
+    await db.commit()
+    return {"url": url, "expires_in": 120, "sha256": rpt.sha256}
