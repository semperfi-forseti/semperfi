+    const buf = await file.arrayBuffer();
+    const hashBuf = await crypto.subtle.digest('SHA-256', buf);
+    const hash = Array.from(new Uint8Array(hashBuf)).map(b=>b.toString(16).padStart(2,'0')).join('');
+    const stored = dbCreate('files', {name:file.name,type:file.type,size:file.size,hash,uploadedAt:Date.now(),metadata:{kind},processId:null,clientId:id});
+    const c = dbGet('clients', id); ensureClientExtended(c);
+    c.documents.push({kind, fileId:stored.id, addedAt:Date.now()});
+    saveDB(); audit('clients','documento_arquivado',id,'sucesso');
+    toast(`Documento arquivado (SHA-256: ${hash.slice(0,16)}...)`,'success');
