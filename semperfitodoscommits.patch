+// ENTITLEMENTS — limites efetivos do plano + add-ons
+function getEntitlements(){
+  const plan = PLANS.find(p=>p.key===DB.subscription.planKey) || PLANS[1];
+  const limits = {
+    seats:plan.seats||0,
+    storedProcesses:plan.storedProcesses||0,
