+"""Registro central de conectores disponíveis."""
+from app.connectors.base import BaseConnector
+from app.connectors.brasilapi import (
+    BrasilApiBancosConnector,
+    BrasilApiCEPConnector,
+    BrasilApiCNPJConnector,
+    BrasilApiDDDConnector,
+)
+from app.connectors.cvm import CVMCiaAbertaConnector
+from app.connectors.datajud import DataJudConnector
+from app.connectors.ibge import IBGEMunicipiosConnector
+from app.connectors.rdap import RDAPConnector
+from app.connectors.transparencia import (
+    TransparenciaCEISConnector,
+    TransparenciaCEPIMConnector,
+    TransparenciaCNEPConnector,
+)
+
+_CONNECTORS: dict[str, BaseConnector] = {
+    c.id: c() for c in [
+        BrasilApiCNPJConnector, BrasilApiCEPConnector,
+        BrasilApiDDDConnector, BrasilApiBancosConnector,
+        TransparenciaCEISConnector, TransparenciaCNEPConnector, TransparenciaCEPIMConnector,
+        DataJudConnector, CVMCiaAbertaConnector,
+        IBGEMunicipiosConnector, RDAPConnector,
+    ]
+}
+
+
+def get_connector(connector_id: str) -> BaseConnector:
+    if connector_id not in _CONNECTORS:
+        raise KeyError(f"Conector '{connector_id}' não registrado")
+    return _CONNECTORS[connector_id]
+
+
+def list_connectors() -> list[str]:
+    return list(_CONNECTORS.keys())
