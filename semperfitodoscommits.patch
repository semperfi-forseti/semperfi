+function addPoliticalEntry(id, tipo){
+  const c = dbGet('clients', id); ensureClientExtended(c);
+  if (tipo==='candidato'){
+    const ano = prompt('Ano da candidatura:'); if (!ano) return;
+    const cargo = prompt('Cargo pretendido:'); if (!cargo) return;
+    const partido = prompt('Partido (sigla):')||'';
+    const situacao = prompt('Situação (eleito/não eleito/suplente/renúncia):')||'';
+    const fonte = prompt('Fonte (URL ou descrição):')||'TSE';
+    c.politicalHistory.push({ano,cargo,partido,situacao,fonte});
+  } else {
+    const cargo = prompt('Cargo público:'); if (!cargo) return;
+    const orgao = prompt('Órgão:')||'';
+    const periodo = prompt('Período (ex: 2019-2022):')||'';
+    const fonte = prompt('Fonte:')||'Portal da Transparência';
+    c.publicOffices.push({cargo,orgao,periodo,fonte});
+  }
+  saveDB(); audit('clients','edicao_perfil_politico',id);
+  renderClient360();
+}
