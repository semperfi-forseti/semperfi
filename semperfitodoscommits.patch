+++ b/backend/app/connectors/manual.py
@@ -0,0 +1,55 @@
+"""Conectores manuais: upload de documento + captura de fonte pública."""
+from typing import Any
+
+from app.connectors.base import BaseConnector, ConnectorContext, ConnectorResult, NormalizedResult
+from app.core.errors import ValidationFailed
+
+
+class ManualUpload:
+    """O upload em si é feito por /v1/evidences/uploads → este conector apenas registra."""
+    connector_id = "manual_upload"
+    name = "Upload Manual de Documento"
+    category = "prova_digital"
+    version = "1.0"
+    allowed_target_types = ("documento",)
+
+    async def validate_input(self, payload: dict) -> None:
+        if "evidence_id" not in payload:
+            raise ValidationFailed("Use o endpoint de upload e informe evidence_id aqui.")
+
+    async def execute(self, payload: dict, ctx: ConnectorContext) -> ConnectorResult:
+        return ConnectorResult(
+            status="ok", summary=f"Upload manual: {payload.get('filename','arquivo')}",
+            raw_data={"evidence_id": payload["evidence_id"]},
+            source_id=self.connector_id, source_name=self.name,
+            confidence=0.7, connector_version=self.version,
+        )
+
+    async def normalize(self, raw: Any) -> NormalizedResult:
+        return NormalizedResult(primary_id=raw.get("evidence_id"), entity_type="documento", fields=raw)
+
+
+class ManualCapture:
+    connector_id = "manual_capture"
+    name = "Captura Manual de Fonte Pública"
+    category = "prova_digital"
+    version = "1.0"
+    allowed_target_types = ("pagina_web", "documento")
+
+    async def validate_input(self, payload: dict) -> None:
+        if not payload.get("source_url"):
+            raise ValidationFailed("Campo 'source_url' obrigatório.")
+        if not payload.get("content"):
+            raise ValidationFailed("Campo 'content' obrigatório.")
+
+    async def execute(self, payload: dict, ctx: ConnectorContext) -> ConnectorResult:
+        return ConnectorResult(
+            status="ok", summary=f"Captura manual de {payload['source_url']}",
+            raw_data={"source_url": payload["source_url"], "content_preview": str(payload["content"])[:500]},
+            source_id=self.connector_id, source_name=self.name, source_url=payload["source_url"],
+            confidence=0.6, connector_version=self.version,
+            limitations="Captura sob responsabilidade do operador.",
+        )
+
+    async def normalize(self, raw: Any) -> NormalizedResult:
+        return NormalizedResult(primary_id=raw.get("source_url"), entity_type="pagina_web", fields=raw)
