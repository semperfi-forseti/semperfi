+"""Gera relatório investigativo e devolve metadados + hash do documento."""
+import json
+from datetime import datetime, timezone
+
+from fastapi import APIRouter, Depends, HTTPException
+from sqlalchemy.orm import Session
+
+from app.api.deps import db_session, requires
+from app.models import AuditEvent, Evidence, Investigation, OsintEntity, OsintFinding, OsintRun
+from app.services.audit import write_event
+from app.services.hash_chain import sha256_hex
+
+router = APIRouter(prefix="/api/osint/investigations", tags=["reports"])
+
+
+@router.post("/{inv_id}/report")
+def generate_report(
+    inv_id: str,
+    db: Session = Depends(db_session),
+    user: dict = Depends(requires("report.generate")),
+):
+    inv = db.get(Investigation, inv_id)
+    if not inv:
+        raise HTTPException(404)
+
+    ents = db.query(OsintEntity).filter_by(investigation_id=inv_id).all()
+    runs = db.query(OsintRun).filter_by(investigation_id=inv_id).all()
+    finds = db.query(OsintFinding).filter_by(investigation_id=inv_id).all()
+    evid = db.query(Evidence).filter_by(investigation_id=inv_id).all()
+    events = db.query(AuditEvent).filter(AuditEvent.module == "osint", AuditEvent.target_id == inv_id).order_by(AuditEvent.timestamp).all()
+
+    body = {
+        "investigation_id": inv.id,
+        "generated_at": datetime.now(timezone.utc).isoformat(),
+        "title": inv.title, "owner_id": inv.owner_id,
+        "ents": len(ents), "runs": len(runs), "finds": len(finds), "evid": len(evid),
+        "last_audit_hash": events[-1].current_hash if events else None,
+    }
+    report_hash = sha256_hex(json.dumps(body, sort_keys=True, ensure_ascii=False))
+    verification = "-".join([report_hash[:4].upper(), report_hash[4:8].upper(), report_hash[8:12].upper()])
+
+    write_event(db, actor_id=user["id"], actor_role=user["role"], module="osint", action="geracao_relatorio", target_id=inv_id, metadata={"report_hash": report_hash[:16], "verification": verification})
+
+    return {
+        "investigation": {
+            "id": inv.id, "title": inv.title, "status": inv.status,
+            "scope": inv.scope, "owner_id": inv.owner_id, "created_at": inv.created_at,
+        },
+        "counts": {"entities": len(ents), "runs": len(runs), "findings": len(finds), "evidence": len(evid), "events": len(events)},
+        "manifest": body,
+        "report_hash": report_hash,
+        "verification_code": verification,
+    }
diff --git a/backend/app/api/runs.py b/backend/app/api/runs.py
new file mode 100644
index 0000000..442c682
--- /dev/null
+++ b/backend/app/api/runs.py
@@ -0,0 +1,73 @@
+"""Despacha uma coleta — política → fila."""
+import uuid
+from datetime import datetime, timezone
+
+from fastapi import APIRouter, Depends, HTTPException
+from sqlalchemy.orm import Session
+
+from app.api.deps import db_session, requires
+from app.models import OsintRun
+from app.schemas.investigation import RunRequest, RunOut
+from app.services.audit import write_event
+from app.services.policy_engine import evaluate_run
+from app.workers.tasks import execute_run as execute_run_task
+
+router = APIRouter(prefix="/api/osint/investigations/{inv_id}/runs", tags=["runs"])
+
+
+@router.post("", response_model=RunOut, status_code=202)
+def submit_run(
+    inv_id: str,
+    data: RunRequest,
+    db: Session = Depends(db_session),
+    user: dict = Depends(requires("run.execute")),
+):
+    # Política primeiro — barreira ANTES de criar a tarefa.
+    decision = evaluate_run(
+        db, investigation_id=inv_id,
+        connector_id=data.connector_id, target_entity_id=data.target_entity_id,
+    )
+    correlation_id = uuid.uuid4().hex[:16]
+    if not decision.allowed:
+        write_event(
+            db, actor_id=user["id"], actor_role=user["role"],
+            module="osint", action=decision.audit_action,
+            target_id=inv_id, result="bloqueada",
+            metadata={"connector": data.connector_id, "reason": decision.reason},
+            correlation_id=correlation_id,
+        )
+        raise HTTPException(403, f"Política bloqueou: {decision.reason}")
+
+    run = OsintRun(
+        id=str(uuid.uuid4()),
+        investigation_id=inv_id,
+        connector_id=data.connector_id,
+        target_entity_id=data.target_entity_id,
+        purpose=data.purpose,
+        scope_snapshot=[],  # ideal: snapshot do escopo no momento
+        request_fingerprint=uuid.uuid4().hex,
+        status="enfileirada",
+        actor_id=user["id"],
+        correlation_id=correlation_id,
+    )
+    db.add(run)
+    db.commit()
+    db.refresh(run)
+
+    execute_run_task.delay(
+        run_id=run.id, investigation_id=inv_id,
+        connector_id=data.connector_id, target_entity_id=data.target_entity_id,
+        payload=data.payload, actor_id=user["id"], actor_role=user["role"],
+        correlation_id=correlation_id,
+    )
+    return run
+
+
+@router.get("")
+def list_runs(
+    inv_id: str,
+    db: Session = Depends(db_session),
+    user: dict = Depends(requires("investigation.read")),
+):
+    runs = db.query(OsintRun).filter_by(investigation_id=inv_id).order_by(OsintRun.started_at.desc()).limit(100).all()
+    return [{"id": r.id, "connector_id": r.connector_id, "status": r.status, "started_at": r.started_at, "finished_at": r.finished_at, "summary": r.result_summary} for r in runs]
