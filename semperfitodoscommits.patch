@@ -0,0 +1,126 @@
+"""
+Geração de relatório PDF investigativo.
+
+Sai como DRAFT; após aprovação humana → FINAL e PDF vai para S3 Object Lock.
+"""
+from datetime import datetime, timezone
+
+from sqlalchemy import select
+
+from app.audit.chain import sha256_hex
+from app.audit.service import AuditService
+from app.db.base import SessionLocal
+from app.evidence.vault import EvidenceVault
+from app.models import Evidence, Finding, Investigation, Report, TimelineEvent
+
+
+REPORT_HTML_TEMPLATE = """\
+<!doctype html><html lang="pt-BR"><head><meta charset="utf-8">
+<title>Relatório Investigativo OSINT — {title}</title>
+<style>
+body{{font-family:Arial,sans-serif;color:#111;padding:36px}}
+h1{{border-bottom:3px double #000;padding-bottom:6px;font-size:22px}}
+h2{{font-size:15px;border-left:4px solid #00a0b8;padding-left:8px;margin-top:24px}}
+table{{width:100%;border-collapse:collapse;font-size:11px;margin:8px 0}}
+th,td{{border:1px solid #888;padding:6px;text-align:left;vertical-align:top}}
+th{{background:#eee}}
+.manifest{{font-family:monospace;font-size:10px;padding:12px;background:#f5f5f5;word-break:break-all}}
+.warn{{background:#fff8dc;border:1px solid #d4a574;padding:10px;font-size:11px;margin-top:18px}}
+@page{{size:A4;margin:18mm;@bottom-center{{content:"Relatório — Página " counter(page) " / " counter(pages)}}}}
+</style></head><body>
+<h1>SEMPER-FI · Relatório Investigativo OSINT</h1>
+<div class="meta">Investigação <code>{inv_id}</code> · gerado em {now} · versão {version}</div>
+
+<h2>1. Objeto</h2><p>{title}</p>
+<h2>2. Finalidade</h2><p>{purpose}</p>
+<h2>3. Escopo</h2><p>{scope}</p>
+<h2>4. Fundamento jurídico</h2><p>{legal_basis} — autorização: {authorization}</p>
+<h2>5. Metodologia TACER</h2><p>Target → Acquire → Correlate → Evaluate → Report.</p>
+
+<h2>6. Fontes consultadas ({n_sources})</h2>{sources_table}
+<h2>7. Timeline ({n_timeline})</h2>{timeline_table}
+<h2>8. Entidades</h2><p>(ver relatório completo)</p>
+<h2>9. Achados ({n_findings})</h2>{findings_table}
+<h2>10. Evidências ({n_evidence})</h2>{evidence_table}
+
+<h2>11. Limitações</h2>
+<ul><li>Coleta restrita a fontes públicas autorizadas.</li>
+<li>Vínculos pendentes não constituem fato.</li>
+<li>"Sem resultado" não significa inexistência.</li></ul>
+
+<h2>12. Conclusão técnica</h2><p>{conclusion}</p>
+
+<h2>13. Manifesto de integridade</h2>
+<div class="manifest">
+Investigação: {inv_id}<br>
+Versão do relatório: {version}<br>
+Evidências referenciadas: {n_evidence}<br>
+Hash do relatório (preliminar): {report_hash}<br>
+Aprovador: <em>(pendente)</em>
+</div>
+
+<div class="warn"><strong>Aviso:</strong> Este relatório organiza dados de fontes públicas e registros técnicos.
+Não substitui validação jurídica, contraditório, perícia oficial ou decisão judicial.</div>
+</body></html>"""
+
+
+async def build_report(report_id: str) -> dict:
+    async with SessionLocal() as session:
+        rpt = await session.get(Report, report_id)
+        if not rpt:
+            return {"status": "not_found"}
+        inv = await session.get(Investigation, rpt.investigation_id)
+        findings = (await session.execute(select(Finding).where(Finding.investigation_id == inv.id))).scalars().all()
+        evidence = (await session.execute(select(Evidence).where(Evidence.investigation_id == inv.id))).scalars().all()
+        timeline = (await session.execute(select(TimelineEvent).where(TimelineEvent.investigation_id == inv.id))).scalars().all()
+
+        sources_html = "<table><tr><th>Conector</th><th>Evidências</th></tr>" + \
+            "".join(f"<tr><td>{e.source_name}</td><td>{e.id}</td></tr>" for e in evidence) + "</table>"
+        timeline_html = "<table><tr><th>Quando</th><th>Tipo</th><th>Descrição</th></tr>" + \
+            "".join(f"<tr><td>{t.occurred_at.isoformat()}</td><td>{t.event_type}</td><td>{t.description}</td></tr>" for t in timeline) + "</table>"
+        findings_html = "<table><tr><th>Classe</th><th>Título</th><th>Confiança</th><th>Validado</th></tr>" + \
+            "".join(f"<tr><td>{f.classification}</td><td>{f.title}</td><td>{f.confidence_score:.2f}</td><td>{'Sim' if f.human_validated else 'Não'}</td></tr>" for f in findings) + "</table>"
+        evidence_html = "<table><tr><th>ID</th><th>Fonte</th><th>SHA-256</th><th>Status</th></tr>" + \
+            "".join(f"<tr><td>{e.id}</td><td>{e.source_name}</td><td><code>{e.sha256[:32]}...</code></td><td>{e.validation_status}</td></tr>" for e in evidence) + "</table>"
+
+        now = datetime.now(timezone.utc).isoformat()
+        html = REPORT_HTML_TEMPLATE.format(
+            title=rpt.title, inv_id=inv.id, now=now, version=rpt.version,
+            purpose=inv.purpose or "—", scope="(via investigation_scopes)",
+            legal_basis=inv.legal_basis, authorization=inv.authorization_reference,
+            n_sources=len({e.source_name for e in evidence}), sources_table=sources_html,
+            n_timeline=len(timeline), timeline_table=timeline_html,
+            n_findings=len(findings), findings_table=findings_html,
+            n_evidence=len(evidence), evidence_table=evidence_html,
+            conclusion=(rpt.sections or {}).get("conclusion", "(a ser preenchida pelo perito responsável)"),
+            report_hash="(será calculado abaixo)",
+        )
+
+        # Render PDF (WeasyPrint — instalado no Dockerfile do worker)
+        try:
+            from weasyprint import HTML  # noqa: WPS433
+            pdf_bytes = HTML(string=html).write_pdf()
+        except Exception:
+            pdf_bytes = html.encode("utf-8")  # fallback dev
+
+        sha = sha256_hex(pdf_bytes)
+        # Sobe para S3 Object Lock com retenção igual à da investigação
+        retain = datetime.combine(inv.retention_until, datetime.min.time(), tzinfo=timezone.utc)
+        stored = EvidenceVault.store(
+            tenant_id=inv.tenant_id, investigation_id=inv.id, content=pdf_bytes,
+            mime_type="application/pdf", retain_until=retain,
+            extra_metadata={"report_id": rpt.id, "version": str(rpt.version)},
+        )
+        rpt.s3_bucket = stored.bucket
+        rpt.s3_key = stored.key
+        rpt.s3_version_id = stored.version_id
+        rpt.sha256 = sha
+        # DRAFT até aprovação humana
+        rpt.status = "DRAFT"
+
+        await AuditService(session).write(
+            action="report.generate", resource="report", resource_id=rpt.id,
+            tenant_id=inv.tenant_id, metadata={"version": rpt.version, "sha256_prefix": sha[:16]},
+        )
+        await session.commit()
+        return {"status": "DRAFT", "report_id": rpt.id, "sha256": sha}
