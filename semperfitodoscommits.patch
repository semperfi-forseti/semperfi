@@ -0,0 +1,22 @@
+"""Pseudonimização: máscara + fingerprint."""
+from app.core.pseudonymize import fingerprint, mask_doc, normalize_doc
+
+
+def test_normalize_strips_punctuation():
+    assert normalize_doc("123.456.789-00") == "12345678900"
+    assert normalize_doc("12.345.678/0001-90") == "12345678000190"
+
+
+def test_mask_keeps_only_edges():
+    assert mask_doc("12345678900") == "12*******00"
+
+
+def test_fingerprint_is_deterministic_and_short():
+    a = fingerprint("123.456.789-00")
+    b = fingerprint("12345678900")  # equivale após normalização
+    assert a == b
+    assert len(a) == 12
+
+
+def test_fingerprint_differs_for_different_inputs():
+    assert fingerprint("11111111111") != fingerprint("22222222222")
