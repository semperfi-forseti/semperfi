+async function osintConnectorExecute(connectorId, payload, investigationId){
+  const cfg = window.SEMPERFI_OSINT_CONFIG;
+  const connector = DB.sourceCatalog.find(s=>s.id===connectorId);
+  if (!connector) throw new Error('Conector não encontrado');
+  if (!connector.enabled) throw new Error(`Conector ${connector.name} está desativado`);
+
+  if (cfg.mode === 'production'){
+    if (!cfg.apiBaseUrl) throw new Error('Backend não configurado: defina apiBaseUrl');
+    const res = await fetch(`${cfg.apiBaseUrl}/api/osint/runs`, {
+      method:'POST', headers:{'Content-Type':'application/json'},
+      body: JSON.stringify({ connectorId, payload, investigationId })
+    });
+    if (!res.ok) throw new Error('Backend erro '+res.status);
+    return await res.json();
+  }
+  if (cfg.mode === 'demo' && cfg.enableMockData){
+    return mockConnectorResponse(connectorId, payload);
+  }
+  throw new Error('Modo inválido ou sem backend');
+}
+
+function mockConnectorResponse(connectorId, payload){
+  const now = new Date();
+  const base = { status:'ok', collectedAt: toLocalISO(now), source: connectorId, sourceUrl: 'https://demo.semperfi.local/'+connectorId, confidence:0.7, limitations:'Resposta demonstrativa — não representa coleta real.', evidenceCandidate:true };
+  const mocks = {
+    brasilapi_cnpj: { ...base, summary:'CNPJ ativo, situação cadastral regular (mock)', rawData:{ cnpj:payload?.target||'00.000.000/0001-00', razao_social:'EMPRESA DEMONSTRATIVA LTDA', situacao_cadastral:'ATIVA', cnae_principal:'6201-5/00', porte:'DEMAIS', data_abertura:'2010-01-15', qsa:[{nome:'Sócio Demonstrativo A', qualificacao:'Sócio-Administrador'}], endereco:'Av. Paulista, 1000 - São Paulo/SP' } },
+    brasilapi_cep: { ...base, summary:'CEP localizado (mock)', rawData:{ cep:payload?.target, logradouro:'Av. Demonstrativa', bairro:'Centro', cidade:'São Paulo', uf:'SP' } },
+    brasilapi_ddd: { ...base, summary:'DDD localizado (mock)', rawData:{ ddd:payload?.target, estado:'SP', cidades:['São Paulo','Campinas','Santos'] } },
+    transparencia_ceis: { ...base, summary:'Nenhum registro em CEIS (mock)', rawData:{ encontrados:0, observacao:'Consulta demonstrativa. Em produção, requer token + backend.' } },
+    transparencia_cnep: { ...base, summary:'Nenhum registro em CNEP (mock)', rawData:{ encontrados:0 } },
+    datajud_cnj: { ...base, summary:'Metadados processuais (mock)', rawData:{ processos_encontrados:2, exemplos:[{numero:'0000000-00.2024.8.26.0100', tribunal:'TJSP', classe:'Procedimento Comum Cível'}] } },
+    cvm_dados_abertos: { ...base, summary:'Não consta como companhia aberta (mock)', rawData:{ encontrado:false } },
+    ibge_municipios: { ...base, summary:'Contexto territorial (mock)', rawData:{ municipio:payload?.target||'São Paulo', uf:'SP', populacao_estimada:12325232, regiao:'Sudeste' } },
+    captura_manual: { ...base, summary:'Captura manual registrada', rawData:payload },
+    upload_documento: { ...base, summary:'Documento registrado', rawData:payload }
+  };
+  return mocks[connectorId] || { ...base, summary:'Conector sem mock definido', rawData:{ connectorId, payload } };
+}
