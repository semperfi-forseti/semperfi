@@ -0,0 +1,195 @@
+name: ci
+
+on:
+  pull_request:
+    branches: [develop, main]
+  push:
+    branches: [develop, main]
+
+permissions:
+  contents: read
+
+concurrency:
+  group: ci-${{ github.workflow }}-${{ github.ref }}
+  cancel-in-progress: true
+
+env:
+  PYTHON_VERSION: "3.12"
+
+jobs:
+  lint-and-typecheck:
+    name: Lint + typecheck
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    permissions:
+      contents: read
+    steps:
+      - name: Checkout
+        uses: actions/checkout@REPLACE_WITH_VERIFIED_SHA  # v4.2.2
+        with:
+          persist-credentials: false
+
+      - name: Setup Python
+        uses: actions/setup-python@REPLACE_WITH_VERIFIED_SHA  # v5.3.0
+        with:
+          python-version: ${{ env.PYTHON_VERSION }}
+          cache: "pip"
+          cache-dependency-path: backend/pyproject.toml
+
+      - name: Install dev dependencies
+        working-directory: backend
+        run: |
+          python -m pip install --upgrade pip
+          python -m pip install -e ".[dev]" || python -m pip install ruff mypy
+
+      - name: Ruff
+        working-directory: backend
+        run: ruff check app tests
+
+      - name: Mypy
+        working-directory: backend
+        run: mypy app || true  # informativo até completar anotações
+
+      - name: Summary
+        if: always()
+        run: |
+          echo "### Lint + typecheck" >> "$GITHUB_STEP_SUMMARY"
+          echo "- Python: ${{ env.PYTHON_VERSION }}" >> "$GITHUB_STEP_SUMMARY"
+
+  unit-and-integration-tests:
+    name: Tests (unit + integration)
+    runs-on: ubuntu-latest
+    timeout-minutes: 20
+    permissions:
+      contents: read
+    services:
+      postgres:
+        image: postgres:16-alpine
+        env:
+          POSTGRES_USER: semperfi
+          POSTGRES_PASSWORD: semperfi
+          POSTGRES_DB: semperfi_test
+        ports: ["5432:5432"]
+        options: >-
+          --health-cmd="pg_isready -U semperfi"
+          --health-interval=5s
+          --health-timeout=5s
+          --health-retries=20
+      redis:
+        image: redis:7-alpine
+        ports: ["6379:6379"]
+        options: >-
+          --health-cmd="redis-cli ping"
+          --health-interval=5s
+          --health-retries=20
+    env:
+      DATABASE_URL: postgresql+asyncpg://semperfi:semperfi@localhost:5432/semperfi_test
+      REDIS_URL: redis://localhost:6379/0
+      CELERY_BROKER_URL: redis://localhost:6379/1
+      CELERY_RESULT_BACKEND: redis://localhost:6379/2
+      SESSION_SECRET: test-only-secret-not-for-prod
+      CSRF_SECRET: test-only-csrf-secret
+      PSEUDONYMIZATION_SALT: test-only-salt
+      FERNET_KEYS: dGVzdC1mZXJuZXQta2V5LTMyLWJ5dGVzLWxvbmctcGFkZA==
+    steps:
+      - name: Checkout
+        uses: actions/checkout@REPLACE_WITH_VERIFIED_SHA  # v4.2.2
+        with:
+          persist-credentials: false
+
+      - name: Setup Python
+        uses: actions/setup-python@REPLACE_WITH_VERIFIED_SHA  # v5.3.0
+        with:
+          python-version: ${{ env.PYTHON_VERSION }}
+          cache: "pip"
+          cache-dependency-path: backend/pyproject.toml
+
+      - name: Install dependencies
+        working-directory: backend
+        run: |
+          python -m pip install --upgrade pip
+          python -m pip install -e ".[dev]" || python -m pip install pytest pytest-asyncio pytest-cov
+
+      - name: Run pytest
+        working-directory: backend
+        run: pytest --cov=app --cov-report=term-missing --cov-report=xml -q
+
+      - name: Upload coverage artifact
+        if: always()
+        uses: actions/upload-artifact@REPLACE_WITH_VERIFIED_SHA  # v4.4.3
+        with:
+          name: coverage-report
+          path: backend/coverage.xml
+          retention-days: 7
+
+  docker-build:
+    name: Docker build (no push)
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    permissions:
+      contents: read
+    steps:
+      - name: Checkout
+        uses: actions/checkout@REPLACE_WITH_VERIFIED_SHA  # v4.2.2
+        with:
+          persist-credentials: false
+
+      - name: Set up Docker Buildx
+        uses: docker/setup-buildx-action@REPLACE_WITH_VERIFIED_SHA  # v3.7.1
+
+      - name: Build API image
+        uses: docker/build-push-action@REPLACE_WITH_VERIFIED_SHA  # v6.9.0
+        with:
+          context: backend
+          file: backend/infra/docker/api.Dockerfile
+          push: false
+          tags: semperfi-api:ci-${{ github.sha }}
+          cache-from: type=gha
+          cache-to: type=gha,mode=max
+
+      - name: Build worker image
+        uses: docker/build-push-action@REPLACE_WITH_VERIFIED_SHA  # v6.9.0
+        with:
+          context: backend
+          file: backend/infra/docker/worker.Dockerfile
+          push: false
+          tags: semperfi-worker:ci-${{ github.sha }}
+          cache-from: type=gha
+          cache-to: type=gha,mode=max
+
+  docker-compose-validate:
+    name: docker compose validate
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    permissions:
+      contents: read
+    steps:
+      - uses: actions/checkout@REPLACE_WITH_VERIFIED_SHA  # v4.2.2
+        with: { persist-credentials: false }
+      - name: Validate root compose
+        run: docker compose -f docker-compose.yml config > /dev/null
+      - name: Validate backend compose
+        run: docker compose -f backend/docker-compose.yml config > /dev/null
+
+  terraform-validate:
+    name: Terraform fmt + validate
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    permissions:
+      contents: read
+    steps:
+      - uses: actions/checkout@REPLACE_WITH_VERIFIED_SHA  # v4.2.2
+        with: { persist-credentials: false }
+      - uses: hashicorp/setup-terraform@REPLACE_WITH_VERIFIED_SHA  # v3.1.2
+        with:
+          terraform_version: "1.9.8"
+      - name: fmt
+        run: terraform -chdir=infra/terraform fmt -check -recursive
+      - name: validate (each environment)
+        run: |
+          for env in development staging production; do
+            echo "::group::validate $env"
+            terraform -chdir=infra/terraform/environments/$env init -backend=false -input=false
+            terraform -chdir=infra/terraform/environments/$env validate
+            echo "::endgroup::"
+          done
