+"""Entidades investigadas (alvos)."""
+from datetime import datetime
+from sqlalchemy import JSON, DateTime, Float, ForeignKey, String, Text, func
+from sqlalchemy.orm import Mapped, mapped_column
+
+from app.database import Base
+
+
+class OsintEntity(Base):
+    __tablename__ = "osint_entities"
+
+    id: Mapped[str] = mapped_column(String(36), primary_key=True)
+    investigation_id: Mapped[str] = mapped_column(String(36), ForeignKey("investigations.id", ondelete="CASCADE"), index=True)
+
+    entity_type: Mapped[str] = mapped_column(String(40), index=True)
+    # pessoa_fisica|pessoa_juridica|processo|dominio|endereco|telefone|municipio|banco|documento|pagina_web
+    display_name: Mapped[str] = mapped_column(String(255))
+    normalized_name: Mapped[str] = mapped_column(String(255), index=True)
+
+    # IMPORTANTE: nunca armazenar identificador em claro fora de coluna criptografada.
+    # Aqui usamos apenas máscara visual + fingerprint determinístico.
+    document_masked: Mapped[str | None] = mapped_column(String(64), nullable=True)
+    document_fingerprint: Mapped[str | None] = mapped_column(String(64), nullable=True, index=True)
+    # Em produção: usar campo criptografado (pgcrypto / app-level KMS) para o valor original.
+    document_encrypted: Mapped[bytes | None] = mapped_column(nullable=True)
+
