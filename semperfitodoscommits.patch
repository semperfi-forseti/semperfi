@@ -0,0 +1,57 @@
+"""Serviço de auditoria — sempre append, com hash encadeado."""
+import uuid
+
+from sqlalchemy import select
+from sqlalchemy.orm import Session
+
+from app.models.audit import AuditEvent
+from app.services.hash_chain import GENESIS, chain_next
+
+
+def write_event(
+    db: Session,
+    *,
+    actor_id: str,
+    actor_role: str,
+    module: str,
+    action: str,
+    target_id: str | None = None,
+    result: str = "sucesso",
+    metadata: dict | None = None,
+    correlation_id: str | None = None,
+) -> AuditEvent:
+    """Grava evento auditado encadeado. NUNCA atualiza; sempre cria novo."""
+    last = db.execute(
+        select(AuditEvent).order_by(AuditEvent.timestamp.desc()).limit(1)
+    ).scalar_one_or_none()
+    previous_hash = last.current_hash if last else GENESIS
+
+    payload = {
+        "actor_id": actor_id,
+        "actor_role": actor_role,
+        "module": module,
+        "action": action,
+        "target_id": target_id or "",
+        "result": result,
+        "metadata": metadata or {},
+        "correlation_id": correlation_id or uuid.uuid4().hex[:16],
+    }
+    current_hash = chain_next(previous_hash, payload)
+
+    ev = AuditEvent(
+        id=str(uuid.uuid4()),
+        actor_id=actor_id,
+        actor_role=actor_role,
+        module=module,
+        action=action,
+        target_id=target_id,
+        result=result,
+        correlation_id=payload["correlation_id"],
+        metadata_json=metadata or {},
+        previous_hash=previous_hash,
+        current_hash=current_hash,
+    )
+    db.add(ev)
+    db.commit()
+    db.refresh(ev)
+    return ev
