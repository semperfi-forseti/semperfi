+"""
+Runtime de conector: circuit breaker + cache Redis + hash de payload.
+
+Cada conector envolve sua chamada externa em `with_runtime(...)` para
+herdar comportamentos consistentes.
+"""
+import hashlib
+import json
+from collections.abc import Awaitable, Callable
+from typing import Any
+
+import redis.asyncio as aioredis
+from purgatory import AsyncCircuitBreakerFactory
+
+from app.core.config import get_settings
+
+_redis: aioredis.Redis | None = None
+_breakers = AsyncCircuitBreakerFactory(default_threshold=5, default_ttl=30)
+
+
+def _r() -> aioredis.Redis:
+    global _redis
+    if _redis is None:
+        _redis = aioredis.from_url(get_settings().redis_url, decode_responses=True)
+    return _redis
+
+
+def payload_fingerprint(payload: dict) -> str:
+    j = json.dumps(payload, sort_keys=True, ensure_ascii=False, separators=(",", ":"))
+    return hashlib.sha256(j.encode()).hexdigest()
+
+
+async def cache_get(key: str) -> dict | None:
+    raw = await _r().get(f"conn:{key}")
+    return json.loads(raw) if raw else None
+
+
+async def cache_set(key: str, value: dict, ttl_seconds: int) -> None:
+    await _r().setex(f"conn:{key}", ttl_seconds, json.dumps(value, ensure_ascii=False))
+
+
+async def with_breaker(name: str, fn: Callable[[], Awaitable[Any]]) -> Any:
+    async with await _breakers.get_breaker(name):
+        return await fn()
