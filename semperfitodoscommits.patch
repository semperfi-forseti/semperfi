@@ -0,0 +1,137 @@
+"""Endpoints de coordenação (DAG de agentes) e compliance."""
+import uuid
+from datetime import datetime, timezone
+
+from fastapi import APIRouter, Depends, Query
+from pydantic import BaseModel
+from sqlalchemy import select
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from app.agents.coordinator import advance_dag, get_pipeline, list_pipelines
+from app.api.deps import current_session, get_db
+from app.audit.service import AuditService
+from app.core.errors import PolicyDenied
+from app.core.tenant import get_correlation_id
+from app.models import AgentDAGRun, ComplianceFinding
+from app.policies import PolicyEngine, PolicyRequest
+
+router = APIRouter(prefix="/orchestration", tags=["orchestration"])
+
+
+class DAGRequest(BaseModel):
+    pipeline_id: str = "investigation_full"
+    investigation_id: str | None = None
+
+
+@router.get("/pipelines")
+async def pipelines(session: dict = Depends(current_session)):
+    return list_pipelines()
+
+
+@router.post("/dag-runs", status_code=202)
+async def start_dag(
+    data: DAGRequest, session: dict = Depends(current_session),
+    db: AsyncSession = Depends(get_db),
+):
+    dec = await PolicyEngine(db).evaluate(PolicyRequest(
+        action="agent.dag_run", resource="agent_dag_run",
+        actor_id=session["user_id"], actor_role=session["role"],
+        tenant_id=session["tenant_id"], mfa_verified=session["mfa_verified"],
+        investigation_id=data.investigation_id,
+    ))
+    if not dec.allowed:
+        raise PolicyDenied(dec.reason, details={"code": dec.code})
+
+    spec = get_pipeline(data.pipeline_id)
+    dag = AgentDAGRun(
+        id=str(uuid.uuid4()), tenant_id=session["tenant_id"],
+        investigation_id=data.investigation_id,
+        pipeline_id=spec.pipeline_id, pipeline_version=spec.version,
+        requested_by=session["user_id"], status="pending",
+        correlation_id=get_correlation_id() or uuid.uuid4().hex[:16],
+    )
+    db.add(dag)
+    await db.flush()
+    await advance_dag(dag.id, db)
+    await AuditService(db).write(
+        action="agent_dag.started", resource="agent_dag_run", resource_id=dag.id,
+        tenant_id=session["tenant_id"], actor_id=session["user_id"],
+        actor_role=session["role"], metadata={"pipeline": spec.pipeline_id},
+    )
+    await db.commit()
+    return {"id": dag.id, "status": dag.status, "pipeline": spec.pipeline_id}
+
+
+@router.get("/dag-runs/{dag_id}")
+async def get_dag(
+    dag_id: str, session: dict = Depends(current_session),
+    db: AsyncSession = Depends(get_db),
+):
+    dag = await db.get(AgentDAGRun, dag_id)
+    if not dag or dag.tenant_id != session["tenant_id"]:
+        return {"error": "not_found"}
+    return {
+        "id": dag.id, "pipeline_id": dag.pipeline_id, "version": dag.pipeline_version,
+        "status": dag.status, "current_step": dag.current_step,
+        "step_history": dag.step_history, "agent_run_ids": dag.agent_run_ids,
+        "started_at": dag.started_at.isoformat() if dag.started_at else None,
+        "finished_at": dag.finished_at.isoformat() if dag.finished_at else None,
+        "correlation_id": dag.correlation_id,
+        "error_message": dag.error_message,
+    }
+
+
+@router.get("/compliance-findings")
+async def list_findings(
+    session: dict = Depends(current_session), db: AsyncSession = Depends(get_db),
+    investigation_id: str | None = None,
+    severity: str | None = Query(None, regex="^(info|low|medium|high|critical)$"),
+    status: str | None = None,
+    limit: int = Query(100, ge=1, le=500),
+):
+    q = select(ComplianceFinding).where(ComplianceFinding.tenant_id == session["tenant_id"])
+    if investigation_id:
+        q = q.where(ComplianceFinding.investigation_id == investigation_id)
+    if severity:
+        q = q.where(ComplianceFinding.severity == severity)
+    if status:
+        q = q.where(ComplianceFinding.status == status)
+    q = q.order_by(ComplianceFinding.created_at.desc()).limit(limit)
+    rows = (await db.execute(q)).scalars().all()
+    return [{
+        "id": f.id, "rule_id": f.rule_id, "framework": f.framework,
+        "severity": f.severity, "category": f.category, "status": f.status,
+        "description": f.description, "suggested_action": f.suggested_action,
+        "investigation_id": f.investigation_id, "agent_run_id": f.agent_run_id,
+        "created_at": f.created_at.isoformat(),
+    } for f in rows]
+
+
+class FindingUpdate(BaseModel):
+    status: str
+    resolution_note: str | None = None
+
+
+@router.patch("/compliance-findings/{finding_id}")
+async def update_finding(
+    finding_id: str, data: FindingUpdate,
+    session: dict = Depends(current_session), db: AsyncSession = Depends(get_db),
+):
+    if data.status not in {"aberto", "em_remediacao", "aceito_risco", "falso_positivo", "resolvido"}:
+        raise PolicyDenied("status inválido", details={"code": "BAD_STATUS"})
+    f = await db.get(ComplianceFinding, finding_id)
+    if not f or f.tenant_id != session["tenant_id"]:
+        return {"error": "not_found"}
+    if session["role"] not in {"admin", "gestor", "auditor"}:
+        raise PolicyDenied("Permissão insuficiente", details={"code": "FORBIDDEN_ROLE"})
+    f.status = data.status
+    f.resolution_note = data.resolution_note
+    f.resolved_by = session["user_id"]
+    f.resolved_at = datetime.now(timezone.utc)
+    await AuditService(db).write(
+        action="compliance.update", resource="compliance_finding", resource_id=f.id,
+        tenant_id=session["tenant_id"], actor_id=session["user_id"], actor_role=session["role"],
+        metadata={"new_status": data.status, "rule_id": f.rule_id},
+    )
+    await db.commit()
+    return {"id": f.id, "status": f.status}
