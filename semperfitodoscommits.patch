+  github_repository   = var.github_repository
+  environment         = "development"
+}
+
+module "ecr" {
+  source           = "../../modules/ecr"
+  environment      = "development"
+  repository_names = ["api", "worker"]
+}
+
+module "iam" {
+  source      = "../../modules/iam"
+  environment = "development"
+}
+
+output "ecr_repositories" { value = module.ecr.repository_urls }
+output "role_deploy_arn" { value = module.oidc.role_deploy_arn }
