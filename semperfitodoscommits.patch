+"""
+Keystore com envelope encryption.
+
+Modelo:
+  - KEK (Key Encryption Key): material vive no backend externo (AWS KMS / GCP KMS /
+    HashiCorp Vault). Em dev, fallback `local_fernet` permite operar sem KMS.
+  - DEK (Data Encryption Key): AES-256 gerada por payload, usada para AES-256-GCM,
+    e armazenada **wrapped** (encriptada pela KEK) junto do payload.
+
+API exposta:
+  keystore.generate_dek()                    -> bytes
+  keystore.wrap_dek(dek, kek_id=None)        -> bytes (wrapped)
+  keystore.unwrap_dek(wrapped, kek_id=None)  -> bytes
+  keystore.encrypt(payload, aad=b"")         -> EnvelopeBlob
+  keystore.decrypt(envelope, aad=b"")        -> bytes
+  keystore.active_kek_id()                   -> str
+  keystore.fingerprint(kek_id)               -> hex (SHA-256 do material wrapped — não reverso da chave em si)
+
+DEKs nunca persistem em claro. KEKs nunca trafegam fora do KMS quando backend
+real. Em modo local_fernet, KEKs ficam em FERNET_KEYS (já existente).
+"""
+from __future__ import annotations
+
+import base64
+import hashlib
+import json
+import os
+from dataclasses import dataclass
+from typing import Any
+
+from cryptography.hazmat.primitives.ciphers.aead import AESGCM
+from cryptography.fernet import Fernet, MultiFernet
+
+from app.core.config import get_settings
+
+NONCE_LEN = 12  # AES-GCM padrão
+
+
+@dataclass(frozen=True)
+class EnvelopeBlob:
+    ciphertext_b64: str
+    dek_wrapped_b64: str
+    nonce_b64: str
+    kek_id: str
+    algorithm: str = "AES-256-GCM"
+    aad_sha256: str | None = None
+
+    def to_dict(self) -> dict[str, Any]:
+        return {
+            "ciphertext": self.ciphertext_b64,
+            "dek_wrapped": self.dek_wrapped_b64,
+            "nonce": self.nonce_b64,
+            "kek_id": self.kek_id,
+            "algorithm": self.algorithm,
+            "aad_sha256": self.aad_sha256,
+        }
+
+    @classmethod
+    def from_dict(cls, d: dict[str, Any]) -> "EnvelopeBlob":
+        return cls(
+            ciphertext_b64=d["ciphertext"], dek_wrapped_b64=d["dek_wrapped"],
+            nonce_b64=d["nonce"], kek_id=d["kek_id"],
+            algorithm=d.get("algorithm", "AES-256-GCM"),
+            aad_sha256=d.get("aad_sha256"),
+        )
+
+
+class _LocalFernetKEK:
+    """KEK derivada do MultiFernet existente — apenas para dev/CI."""
+    def __init__(self) -> None:
+        keys = get_settings().fernet_keys_list
+        if not keys:
+            raise RuntimeError("FERNET_KEYS não configurado — keystore local exige fallback Fernet.")
+        self._mfernet = MultiFernet([Fernet(k.encode() if isinstance(k, str) else k) for k in keys])
+        primary = (keys[0].encode() if isinstance(keys[0], str) else keys[0])
+        self._kek_id = "local-fernet-" + hashlib.sha256(primary).hexdigest()[:12]
+
+    @property
+    def kek_id(self) -> str:
+        return self._kek_id
+
+    def wrap(self, dek: bytes) -> bytes:
+        return self._mfernet.encrypt(dek)
+
+    def unwrap(self, wrapped: bytes) -> bytes:
+        return self._mfernet.decrypt(wrapped)
+
+
+class _AwsKmsKEK:
+    def __init__(self, key_id: str) -> None:
+        import boto3
+        self._client = boto3.client("kms")
+        self._kek_id = key_id
+
+    @property
+    def kek_id(self) -> str:
+        return self._kek_id
+
+    def wrap(self, dek: bytes) -> bytes:
+        out = self._client.encrypt(KeyId=self._kek_id, Plaintext=dek)
+        return out["CiphertextBlob"]
+
+    def unwrap(self, wrapped: bytes) -> bytes:
+        out = self._client.decrypt(KeyId=self._kek_id, CiphertextBlob=wrapped)
+        return out["Plaintext"]
+
+
+_kek_singleton: Any = None
+
+
+def _kek():
+    """Resolve KEK conforme settings."""
+    global _kek_singleton
+    if _kek_singleton is not None:
+        return _kek_singleton
+    s = get_settings()
+    kms_key = getattr(s, "kms_kek_id", "") or os.getenv("KMS_KEK_ID", "")
+    backend = (getattr(s, "kms_backend", "") or os.getenv("KMS_BACKEND", "local_fernet")).lower()
+    if backend == "aws_kms" and kms_key:
+        _kek_singleton = _AwsKmsKEK(kms_key)
+    else:
+        _kek_singleton = _LocalFernetKEK()
+    return _kek_singleton
+
+
+def active_kek_id() -> str:
+    return _kek().kek_id
+
+
+def generate_dek() -> bytes:
+    """DEK aleatória de 256 bits."""
+    return os.urandom(32)
+
+
+def wrap_dek(dek: bytes) -> bytes:
+    return _kek().wrap(dek)
+
+
+def unwrap_dek(wrapped: bytes) -> bytes:
+    return _kek().unwrap(wrapped)
+
+
+def encrypt(payload: bytes, aad: bytes = b"") -> EnvelopeBlob:
+    dek = generate_dek()
+    nonce = os.urandom(NONCE_LEN)
+    ct = AESGCM(dek).encrypt(nonce, payload, aad if aad else None)
+    wrapped = wrap_dek(dek)
+    return EnvelopeBlob(
+        ciphertext_b64=base64.b64encode(ct).decode("ascii"),
+        dek_wrapped_b64=base64.b64encode(wrapped).decode("ascii"),
+        nonce_b64=base64.b64encode(nonce).decode("ascii"),
+        kek_id=active_kek_id(),
+        aad_sha256=hashlib.sha256(aad).hexdigest() if aad else None,
+    )
+
+
+def decrypt(envelope: EnvelopeBlob, aad: bytes = b"") -> bytes:
+    if envelope.aad_sha256 and envelope.aad_sha256 != hashlib.sha256(aad).hexdigest():
+        raise ValueError("AAD divergente — envelope rejeitado.")
+    dek = unwrap_dek(base64.b64decode(envelope.dek_wrapped_b64))
+    nonce = base64.b64decode(envelope.nonce_b64)
+    ct = base64.b64decode(envelope.ciphertext_b64)
+    return AESGCM(dek).decrypt(nonce, ct, aad if aad else None)
+
+
+def fingerprint(material: bytes) -> str:
+    return hashlib.sha256(material).hexdigest()
+
+
+def envelope_to_json(env: EnvelopeBlob) -> str:
+    return json.dumps(env.to_dict(), separators=(",", ":"))
+
+
+def envelope_from_json(s: str) -> EnvelopeBlob:
+    return EnvelopeBlob.from_dict(json.loads(s))
