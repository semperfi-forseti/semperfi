+async function handleFiles(files){
+  const prog = document.getElementById('uploadProgress');
+  for (const file of files){
+    if (file.size > 50*1024*1024){ toast(`${file.name}: arquivo > 50MB`,'error'); continue; }
+    prog.innerHTML = `<div style="padding:10px;margin-top:10px;background:var(--obsidian);border-radius:6px"><span class="spinner"></span> Processando ${file.name}...</div>`;
+    try {
+      const buf = await file.arrayBuffer();
+      const hashBuf = await crypto.subtle.digest('SHA-256', buf);
+      const hash = Array.from(new Uint8Array(hashBuf)).map(b=>b.toString(16).padStart(2,'0')).join('');
+      const meta = {};
+      if (file.type.startsWith('image/')){
+        const url = URL.createObjectURL(file);
+        const img = new Image(); img.src = url;
+        await new Promise(r=>img.onload=r);
+        meta.width = img.width; meta.height = img.height;
+        URL.revokeObjectURL(url);
+      }
+      dbCreate('files', { name:file.name, type:file.type, size:file.size, hash, uploadedAt:Date.now(), metadata:meta, processId:null, clientId:null });
+      toast(`${file.name} processado`,'success');
