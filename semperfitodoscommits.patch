+++ b/backend/app/evidence/vault.py
@@ -0,0 +1,140 @@
+"""
+EvidenceVault — S3 com Object Lock + SSE-KMS + versionamento.
+
+Chave imutável:
+  tenant_id/investigation_id/sha256[:2]/sha256.{uuid}.{ext}
+
+Retenção:
+  - GOVERNANCE Mode (operacional): retain_until aplicado ao PUT.
+  - COMPLIANCE Mode: requer aprovação dupla (gestor + custodiante).
+  - Legal Hold: aplicado/removido apenas por gestor com reauth.
+"""
+import uuid
+from dataclasses import dataclass
+from datetime import datetime
+
+import boto3
+from botocore.config import Config
+from botocore.exceptions import ClientError
+
+from app.audit.chain import sha256_hex
+from app.core.config import get_settings
+from app.core.errors import AppError, IntegrityError
+
+_s = get_settings()
+_s3 = boto3.client(
+    "s3",
+    endpoint_url=_s.evidence_s3_endpoint or None,
+    aws_access_key_id=_s.evidence_s3_access_key.get_secret_value() or None,
+    aws_secret_access_key=_s.evidence_s3_secret_key.get_secret_value() or None,
+    region_name=_s.evidence_s3_region,
+    config=Config(signature_version="s3v4", retries={"max_attempts": 3, "mode": "adaptive"}),
+)
+
+
+@dataclass(frozen=True)
+class S3StoredObject:
+    bucket: str
+    key: str
+    version_id: str | None
+    etag: str | None
+    size: int
+    sha256: str
+    mime_type: str
+    object_lock_mode: str
+    retain_until: datetime
+
+
+def _ext_from_mime(mime: str) -> str:
+    return {
+        "application/pdf": "pdf", "image/png": "png", "image/jpeg": "jpg",
+        "image/tiff": "tiff", "image/webp": "webp",
+        "application/json": "json", "text/plain": "txt", "text/csv": "csv",
+        "video/mp4": "mp4", "video/quicktime": "mov",
+    }.get(mime, "bin")
+
+
+class EvidenceVault:
+    @staticmethod
+    def build_key(*, tenant_id: str, investigation_id: str, sha256: str, mime_type: str) -> str:
+        ext = _ext_from_mime(mime_type)
+        return f"{tenant_id}/{investigation_id}/{sha256[:2]}/{sha256}.{uuid.uuid4().hex}.{ext}"
+
+    @staticmethod
+    def store(
+        *, tenant_id: str, investigation_id: str, content: bytes,
+        mime_type: str, retain_until: datetime,
+        object_lock_mode: str | None = None,
+        extra_metadata: dict[str, str] | None = None,
+    ) -> S3StoredObject:
+        sha = sha256_hex(content)
+        key = EvidenceVault.build_key(tenant_id=tenant_id, investigation_id=investigation_id,
+                                      sha256=sha, mime_type=mime_type)
+        mode = object_lock_mode or _s.evidence_s3_object_lock_mode
+        params = {
+            "Bucket": _s.evidence_s3_bucket, "Key": key, "Body": content,
+            "ContentType": mime_type,
+            "ObjectLockMode": mode,
+            "ObjectLockRetainUntilDate": retain_until,
+            "Metadata": {
+                "tenant-id": tenant_id, "investigation-id": investigation_id, "sha256": sha,
+                **(extra_metadata or {}),
+            },
+        }
+        if _s.evidence_sse_type == "aws:kms" and _s.evidence_kms_key_id:
+            params["ServerSideEncryption"] = "aws:kms"
+            params["SSEKMSKeyId"] = _s.evidence_kms_key_id
+        else:
+            params["ServerSideEncryption"] = "AES256"
+        try:
+            resp = _s3.put_object(**params)
+        except ClientError as e:
+            raise AppError(f"S3 erro: {e.response['Error']['Code']}") from e
+        return S3StoredObject(
+            bucket=_s.evidence_s3_bucket, key=key, version_id=resp.get("VersionId"),
+            etag=resp.get("ETag", "").strip('"'), size=len(content),
+            sha256=sha, mime_type=mime_type, object_lock_mode=mode, retain_until=retain_until,
+        )
+
+    @staticmethod
+    def get(key: str) -> bytes:
+        obj = _s3.get_object(Bucket=_s.evidence_s3_bucket, Key=key)
+        return obj["Body"].read()
+
+    @staticmethod
+    def head(key: str) -> dict:
+        return _s3.head_object(Bucket=_s.evidence_s3_bucket, Key=key)
+
+    @staticmethod
+    def presigned_get(key: str, *, expires_seconds: int = 60) -> str:
+        return _s3.generate_presigned_url(
+            "get_object", Params={"Bucket": _s.evidence_s3_bucket, "Key": key},
+            ExpiresIn=expires_seconds,
+        )
+
+    @staticmethod
+    def verify_integrity(key: str, expected_sha256: str) -> bool:
+        actual = sha256_hex(EvidenceVault.get(key))
+        if actual != expected_sha256:
+            raise IntegrityError(f"SHA-256 divergente em {key}")
+        return True
+
+    @staticmethod
+    def set_legal_hold(key: str, *, enable: bool) -> None:
+        _s3.put_object_legal_hold(
+            Bucket=_s.evidence_s3_bucket, Key=key,
+            LegalHold={"Status": "ON" if enable else "OFF"},
+        )
+
+    @staticmethod
+    def extend_retention(key: str, *, new_retain_until: datetime, version_id: str | None = None,
+                         bypass_governance: bool = False) -> None:
+        kw = {
+            "Bucket": _s.evidence_s3_bucket, "Key": key,
+            "Retention": {"Mode": _s.evidence_s3_object_lock_mode, "RetainUntilDate": new_retain_until},
+        }
+        if version_id:
+            kw["VersionId"] = version_id
+        if bypass_governance and _s.evidence_s3_object_lock_mode == "GOVERNANCE":
+            kw["BypassGovernanceRetention"] = True
+        _s3.put_object_retention(**kw)
