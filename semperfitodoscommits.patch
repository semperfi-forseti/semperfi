+++ b/backend/tests/integration/test_audit_chain_integrity.py
@@ -0,0 +1,29 @@
+"""Integração mínima: cadeia de auditoria sobrevive a múltiplas escritas."""
+import pytest
+
+from app.audit.chain import GENESIS, chain_next, verify_segment
+
+
+def test_long_chain_verifies():
+    events = []
+    prev = GENESIS
+    for i in range(100):
+        payload = {"i": i, "action": "test", "tenant": "t1"}
+        cur = chain_next(prev, payload)
+        events.append({**payload, "previous_hash": prev, "current_hash": cur})
+        prev = cur
+    ok, idx, _ = verify_segment(events)
+    assert ok and idx is None
+
+
+def test_long_chain_breaks_at_middle():
+    events = []
+    prev = GENESIS
+    for i in range(20):
+        payload = {"i": i}
+        cur = chain_next(prev, payload)
+        events.append({**payload, "previous_hash": prev, "current_hash": cur})
+        prev = cur
+    events[10]["i"] = 999  # adultera
+    ok, idx, _ = verify_segment(events)
+    assert not ok and idx == 10
