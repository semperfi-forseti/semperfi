+.PHONY: help lint test migrate seed run worker compose-up compose-down openapi clean
+
+help:
+	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-15s\033[0m %s\n", $$1, $$2}'
+
+lint:  ## Ruff + mypy
+	ruff check app tests
+	mypy app
+
+test:  ## pytest com cobertura
+	pytest --cov=app --cov-report=term-missing
+
+migrate:  ## Aplica migrações Alembic
+	alembic upgrade head
+
+migrate-new:  ## Gera nova migração: make migrate-new MSG="descrição"
+	alembic revision --autogenerate -m "$(MSG)"
+
+seed:  ## Popula tenant demo + admin + catálogo (sem dados reais)
+	python -m app.scripts.seed_demo
+
+run:  ## Sobe API em modo dev
+	uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload
+
+worker:  ## Sobe Celery worker (todas as 4 filas)
+	celery -A app.workers.celery_app worker -l info -Q critical,default,cpu_heavy,agents -c 4
+
+beat:  ## Sobe Celery beat (jobs periódicos)
+	celery -A app.workers.celery_app beat -l info
+
+compose-up:  ## Sobe infra (Postgres + Redis + MinIO + ClamAV)
+	docker compose -f docker-compose.yml up -d
+	@echo "Aguardando serviços..."
+	@sleep 5
+	@echo "Pronto. Próximo: make migrate && make seed"
+
+compose-down:  ## Derruba infra
+	docker compose -f docker-compose.yml down
+
+openapi:  ## Exporta openapi.json
+	python -c "from app.main import app; import json; open('openapi.json','w').write(json.dumps(app.openapi(), indent=2))"
+	@echo "openapi.json gerado"
+
+import-frontend:  ## Importa export JSON do frontend: make import-frontend FILE=export.json TENANT=demo
+	python -m app.scripts.import_frontend --file $(FILE) --tenant $(TENANT)
+
+clean:
+	find . -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true
+	rm -rf .pytest_cache .mypy_cache .ruff_cache htmlcov .coverage
