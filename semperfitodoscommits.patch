+"""
+Rate limit em Redis (sliding window). Por IP, user, tenant e conector.
+Suspensão suave: marca o request como `rate_limited` no contexto e
+deixa o PolicyEngine devolver Outcome.RATE_LIMITED.
+"""
+import time
+from dataclasses import dataclass
+
+import redis.asyncio as aioredis
+
+from app.core.config import get_settings
+
+_redis: aioredis.Redis | None = None
+
+
+def _r() -> aioredis.Redis:
+    global _redis
+    if _redis is None:
+        _redis = aioredis.from_url(get_settings().redis_url, decode_responses=True)
+    return _redis
+
+
+@dataclass(frozen=True)
+class LimitResult:
+    allowed: bool
+    used: int
+    limit: int
+    key: str
+
+
+async def hit(key: str, *, limit_per_min: int) -> LimitResult:
+    bucket = int(time.time() // 60)
+    rkey = f"rl:{key}:{bucket}"
+    count = await _r().incr(rkey)
+    if count == 1:
+        await _r().expire(rkey, 70)
+    return LimitResult(allowed=count <= limit_per_min, used=count, limit=limit_per_min, key=rkey)
+
+
+async def hit_ip(ip: str | None) -> LimitResult:
+    return await hit(f"ip:{ip or 'anon'}", limit_per_min=get_settings().rate_limit_global_per_min)
+
+
+async def hit_user(user_id: str | None) -> LimitResult:
+    return await hit(f"u:{user_id or 'anon'}", limit_per_min=get_settings().rate_limit_user_per_min)
+
+
+async def hit_tenant(tenant_id: str | None) -> LimitResult:
+    return await hit(f"t:{tenant_id or 'global'}", limit_per_min=get_settings().rate_limit_global_per_min)
+
+
+async def hit_connector(tenant_id: str | None, connector_id: str) -> LimitResult:
+    return await hit(f"c:{tenant_id}:{connector_id}", limit_per_min=get_settings().rate_limit_connector_per_min)
