+"""CRUD de clientes — multi-tenant + soft delete + auditoria."""
+import uuid
+from datetime import datetime, timezone
+
+from fastapi import APIRouter, Depends, Query
+from pydantic import BaseModel, EmailStr, Field
+from sqlalchemy import select
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from app.api.deps import current_session, get_db, request_ip_masked
+from app.audit.service import AuditService
+from app.core.errors import NotFound, TenantIsolationViolation
+from app.models import Client
+from app.policies import PolicyEngine, PolicyRequest
+from app.security.crypto import encrypt_str, fingerprint, mask_doc, normalize_doc
+
+router = APIRouter(prefix="/clients", tags=["clients"])
+
+
+class ClientIn(BaseModel):
+    name: str = Field(min_length=2, max_length=255)
+    type: str = Field(pattern=r"^(PF|PJ)$")
+    document: str | None = None
+    email: EmailStr | None = None
+    phone: str | None = None
+    address: str | None = None
+    responsible: str | None = None
+    status: str = "ativo"
+    notes: str | None = None
+
+
+class ClientOut(BaseModel):
+    id: str
+    name: str
+    type: str
+    document_masked: str | None
+    document_fingerprint: str | None
+    email: str | None
+    phone: str | None
+    address: str | None
+    responsible: str | None
+    status: str
+    notes: str | None
+
+    class Config:
+        from_attributes = True
+
+
+async def _policy(db: AsyncSession, sess: dict, action: str, resource_id: str | None = None) -> None:
+    dec = await PolicyEngine(db).evaluate(PolicyRequest(
+        action=action, resource="client", resource_id=resource_id,
+        actor_id=sess["user_id"], actor_role=sess["role"], tenant_id=sess["tenant_id"],
+        mfa_verified=sess["mfa_verified"], reauth_verified=False,
+    ))
+    if not dec.allowed:
+        from app.core.errors import PolicyDenied
+        raise PolicyDenied(dec.reason, details={"code": dec.code, "outcome": str(dec.outcome.value)})
+
+
+@router.get("", response_model=list[ClientOut])
+async def list_clients(session: dict = Depends(current_session), db: AsyncSession = Depends(get_db),
+                       limit: int = Query(50, ge=1, le=200), offset: int = Query(0, ge=0)):
+    await _policy(db, session, "client.read")
+    rows = (await db.execute(
+        select(Client)
+        .where(Client.tenant_id == session["tenant_id"], Client.is_deleted.is_(False))
+        .order_by(Client.created_at.desc()).limit(limit).offset(offset)
+    )).scalars().all()
+    return rows
+
+
+@router.post("", response_model=ClientOut, status_code=201)
+async def create_client(data: ClientIn, session: dict = Depends(current_session), db: AsyncSession = Depends(get_db)):
+    await _policy(db, session, "client.create")
+    c = Client(
+        id=str(uuid.uuid4()), tenant_id=session["tenant_id"],
+        name=data.name, type=data.type,
+        document_masked=mask_doc(data.document) if data.document else None,
+        document_fingerprint=fingerprint(data.document) if data.document else None,
+        document_encrypted=encrypt_str(normalize_doc(data.document)) if data.document else None,
+        email=data.email, phone=data.phone, address=data.address,
+        responsible=data.responsible, status=data.status, notes=data.notes,
+    )
+    db.add(c)
+    await AuditService(db).write(action="client.create", resource="client", resource_id=c.id,
+                                 tenant_id=session["tenant_id"], actor_id=session["user_id"],
+                                 actor_role=session["role"])
+    await db.commit()
+    await db.refresh(c)
+    return c
+
+
+@router.get("/{client_id}", response_model=ClientOut)
+async def get_client(client_id: str, session: dict = Depends(current_session), db: AsyncSession = Depends(get_db)):
+    await _policy(db, session, "client.read", client_id)
+    c = await db.get(Client, client_id)
+    if not c or c.is_deleted:
+        raise NotFound()
+    if c.tenant_id != session["tenant_id"]:
+        raise TenantIsolationViolation()
+    return c
+
+
+@router.delete("/{client_id}", status_code=204)
+async def delete_client(client_id: str, session: dict = Depends(current_session), db: AsyncSession = Depends(get_db)):
+    await _policy(db, session, "client.delete", client_id)
+    c = await db.get(Client, client_id)
+    if not c or c.is_deleted:
+        raise NotFound()
+    if c.tenant_id != session["tenant_id"]:
+        raise TenantIsolationViolation()
+    c.is_deleted = True
+    c.deleted_at = datetime.now(timezone.utc)
+    c.deleted_by = session["user_id"]
+    await AuditService(db).write(action="client.delete", resource="client", resource_id=client_id,
+                                 tenant_id=session["tenant_id"], actor_id=session["user_id"],
+                                 actor_role=session["role"])
+    await db.commit()
