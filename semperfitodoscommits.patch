+"""
+Verificador sistêmico.
+
+Combina:
+  - Auditoria: recomputa hash chain de audit_events.
+  - Evidência: recomputa hash chain de evidence_events.
+  - S3: amostra de N objetos, recomputa SHA-256 e compara ao DB.
+  - Backups: verifica metadados (Object Lock + tamanho); opcional deep.
+  - Schema drift: snapshot SHA-256 das tabelas críticas (lista de colunas/índices)
+    e compara à última varredura.
+
+Gera IntegrityReport com hash do próprio relatório (autenticidade do relatório).
+"""
+from __future__ import annotations
+
+import asyncio
+import hashlib
+import json
+import uuid
+from dataclasses import dataclass, field
+from datetime import datetime, timedelta, timezone
+from typing import Any
+
+from sqlalchemy import inspect, select, text
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from app.audit.chain import canonical_json, sha256_hex, verify_segment
+from app.audit.service import AuditService
+from app.core.tenant import get_correlation_id
+from app.evidence.vault import EvidenceVault
+from app.models import (
+    AuditEvent, BackupRun, Evidence, EvidenceEvent, IntegrityReport,
+)
+
+
+@dataclass
+class IntegrityResult:
+    overall: str  # ok | warning | violation
+    audit: dict[str, Any] = field(default_factory=dict)
+    evidence: dict[str, Any] = field(default_factory=dict)
+    s3: dict[str, Any] = field(default_factory=dict)
+    backups: dict[str, Any] = field(default_factory=dict)
+    schema: dict[str, Any] = field(default_factory=dict)
+
+
+async def _verify_audit_chain(db: AsyncSession, limit: int) -> dict[str, Any]:
+    rows = (await db.execute(
+        select(AuditEvent).order_by(AuditEvent.timestamp).limit(limit)
+    )).scalars().all()
+    events = [{
+        "tenant_id": r.tenant_id, "actor_id": r.actor_id, "actor_role": r.actor_role,
+        "action": r.action, "resource": r.resource, "resource_id": r.resource_id,
+        "result": r.result, "metadata": r.metadata_json, "correlation_id": r.correlation_id,
+        "previous_hash": r.previous_hash, "current_hash": r.current_hash,
+    } for r in rows]
+    ok, idx, msg = verify_segment(events)
+    return {"checked": len(events), "ok": ok, "broken_index": idx, "message": msg}
+
+
+async def _verify_evidence_chain(db: AsyncSession, limit: int) -> dict[str, Any]:
+    rows = (await db.execute(
+        select(EvidenceEvent).order_by(EvidenceEvent.created_at).limit(limit)
+    )).scalars().all()
+    events = [{
+        "evidence_id": r.evidence_id, "event_type": r.event_type, "actor_id": r.actor_id,
+        "payload": r.payload, "previous_hash": r.previous_hash, "current_hash": r.current_hash,
+    } for r in rows]
+    ok, idx, msg = verify_segment(events)
+    return {"checked": len(events), "ok": ok, "broken_index": idx, "message": msg}
+
+
+async def _verify_s3_sample(db: AsyncSession, sample: int) -> dict[str, Any]:
+    rows = (await db.execute(
+        select(Evidence).order_by(Evidence.created_at.desc()).limit(sample)
+    )).scalars().all()
+    checked = mismatches = 0
+    mismatch_ids: list[str] = []
+    for ev in rows:
+        try:
+            await asyncio.to_thread(EvidenceVault.verify_integrity, ev.s3_key, ev.sha256)
+            checked += 1
+        except Exception:
+            mismatches += 1
+            mismatch_ids.append(ev.id)
+            checked += 1
+    return {"checked": checked, "mismatches": mismatches, "mismatch_ids": mismatch_ids[:10]}
+
+
+async def _verify_backups(db: AsyncSession, sample: int) -> dict[str, Any]:
+    rows = (await db.execute(
+        select(BackupRun).where(BackupRun.status.in_(("success", "verified")))
+        .order_by(BackupRun.started_at.desc()).limit(sample)
+    )).scalars().all()
+    checked = failed = 0
+    from app.backup.service import verify_backup
+    failed_ids: list[str] = []
+    for br in rows:
+        try:
+            await verify_backup(br.id, db, deep=False)
+            checked += 1
+        except Exception:
+            failed += 1
+            checked += 1
+            failed_ids.append(br.id)
+    return {"checked": checked, "failed": failed, "failed_ids": failed_ids}
+
+
+async def _schema_snapshot(db: AsyncSession) -> dict[str, Any]:
+    """SHA-256 sobre lista canônica de (tabela → colunas, índices). Detecta drift."""
+    snap: dict[str, Any] = {}
+    res = await db.execute(text("""
+        SELECT table_name, column_name, data_type, is_nullable
+        FROM information_schema.columns
+        WHERE table_schema = 'public'
+        ORDER BY table_name, ordinal_position
+    """))
+    cols = [tuple(r) for r in res.fetchall()]
+    sha = sha256_hex(canonical_json({"cols": [list(c) for c in cols]}))
+    return {"sha256": sha, "table_count": len({c[0] for c in cols})}
+
+
+async def full_scan(
+    db: AsyncSession, *, audit_limit: int = 10000, evidence_limit: int = 10000,
+    s3_sample: int = 100, backup_sample: int = 5,
+) -> IntegrityResult:
+    audit = await _verify_audit_chain(db, audit_limit)
+    evidence = await _verify_evidence_chain(db, evidence_limit)
+    s3 = await _verify_s3_sample(db, s3_sample)
+    backups = await _verify_backups(db, backup_sample)
+    schema = await _schema_snapshot(db)
+
+    overall = "ok"
+    if not audit["ok"] or not evidence["ok"]:
+        overall = "violation"
+    elif s3["mismatches"] > 0 or backups["failed"] > 0:
+        overall = "violation"
+    elif audit["checked"] == 0:
+        overall = "warning"
+
+    return IntegrityResult(overall=overall, audit=audit, evidence=evidence,
+                            s3=s3, backups=backups, schema=schema)
+
+
+async def persist_report(res: IntegrityResult, db: AsyncSession) -> IntegrityReport:
+    started = datetime.now(timezone.utc) - timedelta(seconds=1)
+    details = {
+        "audit": res.audit, "evidence": res.evidence, "s3": res.s3,
+        "backups": res.backups, "schema": res.schema,
+    }
+    body_sha = sha256_hex(canonical_json(details))
+    rep = IntegrityReport(
+        id=str(uuid.uuid4()), scope="full",
+        started_at=started, finished_at=datetime.now(timezone.utc),
+        audit_events_checked=res.audit.get("checked", 0),
+        audit_chain_ok=res.audit.get("ok", True),
+        audit_broken_index=res.audit.get("broken_index"),
+        evidence_events_checked=res.evidence.get("checked", 0),
+        evidence_chain_ok=res.evidence.get("ok", True),
+        evidence_broken_index=res.evidence.get("broken_index"),
+        s3_objects_checked=res.s3.get("checked", 0),
+        s3_mismatches=res.s3.get("mismatches", 0),
+        backups_checked=res.backups.get("checked", 0),
+        backups_failed_verify=res.backups.get("failed", 0),
+        overall_status=res.overall, details=details,
+        report_sha256=body_sha,
+        correlation_id=get_correlation_id() or "system",
+    )
+    db.add(rep)
+    await AuditService(db).write(
+        action="integrity.scan", resource="integrity_report", resource_id=rep.id,
+        result="sucesso" if res.overall == "ok" else ("warning" if res.overall == "warning" else "violacao"),
+        metadata={
+            "overall": res.overall, "audit_ok": res.audit.get("ok"),
+            "evidence_ok": res.evidence.get("ok"), "s3_mismatches": res.s3.get("mismatches", 0),
+            "backups_failed": res.backups.get("failed", 0), "report_sha_prefix": body_sha[:16],
+        },
+    )
+    await db.commit()
+    return rep
