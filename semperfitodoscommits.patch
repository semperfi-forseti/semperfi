+"""
+Pipeline pesado: AV → MIME → metadados → OCR.
+
+Cada etapa é uma sub-task idempotente (key = evidence_id + etapa).
+Em produção, rodam em containers SEM REDE, com bind do arquivo apenas.
+"""
+import asyncio
+import socket
+from datetime import datetime, timezone
+
+from app.audit.service import AuditService
+from app.core.config import get_settings
+from app.db.base import SessionLocal
+from app.evidence.vault import EvidenceVault
+from app.models import Evidence
+from app.workers.celery_app import celery_app
+
+
+@celery_app.task(name="app.workers.tasks.evidence_pipeline.scan_av", bind=True, max_retries=2)
+def scan_av(self, *, evidence_id: str) -> dict:
+    return asyncio.run(_scan_av(evidence_id))
+
+
+async def _scan_av(evidence_id: str) -> dict:
+    async with SessionLocal() as session:
+        ev = await session.get(Evidence, evidence_id)
+        if not ev:
+            return {"status": "not_found"}
+        if ev.av_status == "ok":
+            return {"status": "skipped"}
+        s = get_settings()
+        try:
+            content = EvidenceVault.get(ev.s3_key)
+            # Conexão TCP simples ao clamd — em produção use python-clamd ou subprocess clamdscan
+            with socket.create_connection((s.clamd_host, s.clamd_port), timeout=15) as sock:
+                sock.sendall(b"zINSTREAM\0")
+                # Stream em chunks
+                for i in range(0, len(content), 1024 * 64):
+                    chunk = content[i:i+64*1024]
+                    sock.sendall(len(chunk).to_bytes(4, "big") + chunk)
+                sock.sendall((0).to_bytes(4, "big"))
+                resp = sock.recv(4096).decode(errors="ignore")
+            infected = "FOUND" in resp
+            ev.av_status = "infectado" if infected else "ok"
+            ev.av_engine_version = "ClamAV"
+            await AuditService(session).write(
+                action="evidence.av_scan", resource="evidence", resource_id=ev.id,
+                result="infectado" if infected else "limpo",
+                tenant_id=ev.tenant_id, metadata={"engine": ev.av_engine_version},
+            )
+            await session.commit()
+            return {"status": ev.av_status}
+        except Exception as e:  # noqa: BLE001
+            ev.av_status = "erro"
+            await session.commit()
+            raise
+
+
+@celery_app.task(name="app.workers.tasks.evidence_pipeline.extract_metadata", bind=True)
+def extract_metadata(self, *, evidence_id: str) -> dict:
+    """
+    Em produção, despachar para container forense isolado (sem rede, sem macros).
+    Aqui: stub que apenas registra o tipo MIME e tamanho.
+    Worker Dockerfile já instala ExifTool / qpdf / ffprobe / OCRmyPDF.
+    """
+    return asyncio.run(_extract(evidence_id))
+
+
+async def _extract(evidence_id: str) -> dict:
+    async with SessionLocal() as session:
+        ev = await session.get(Evidence, evidence_id)
+        if not ev or ev.av_status != "ok":
+            return {"status": "skipped"}
+        # Stub mínimo: em produção, sub-processar exiftool/qpdf/ffprobe e gravar JSON em EvidenceFile.
+        ev.extracted_metadata = {**(ev.extracted_metadata or {}), "size": ev.size_bytes, "mime": ev.mime_type,
+                                 "extracted_at": datetime.now(timezone.utc).isoformat()}
+        await AuditService(session).write(action="evidence.metadata", resource="evidence",
+                                          resource_id=evidence_id, tenant_id=ev.tenant_id)
+        await session.commit()
+        return {"status": "ok"}
+
+
+@celery_app.task(name="app.workers.tasks.evidence_pipeline.run_ocr", bind=True)
+def run_ocr(self, *, evidence_id: str) -> dict:
+    return {"status": "stub", "note": "OCRmyPDF/Tesseract instalados — implementar sub-process."}
diff --git a/backend/app/workers/tasks/ingest_connector.py b/backend/app/workers/tasks/ingest_connector.py
new file mode 100644
index 0000000..05d0e63
--- /dev/null
+++ b/backend/app/workers/tasks/ingest_connector.py
@@ -0,0 +1,124 @@
+"""Worker: executa um conector OSINT, persiste raw em S3, cria finding."""
+import asyncio
+import json
+import uuid
+from datetime import datetime, timedelta, timezone
+
+from sqlalchemy import select
+
+from app.audit.chain import GENESIS, chain_next, sha256_hex
+from app.audit.service import AuditService
+from app.connectors.base import ConnectorContext
+from app.connectors.registry import get_connector
+from app.db.base import SessionLocal
+from app.evidence.vault import EvidenceVault
+from app.models import ConnectorRun, Evidence, EvidenceEvent, Finding, Investigation
+from app.workers.celery_app import celery_app
+
+
+@celery_app.task(name="app.workers.tasks.ingest_connector.run", bind=True, max_retries=2, default_retry_delay=10)
+def run(self, *, run_id: str, connector_id: str, payload: dict, ctx: dict) -> dict:
+    return asyncio.run(_do_run(run_id=run_id, connector_id=connector_id, payload=payload, ctx=ctx))
+
+
+async def _do_run(*, run_id: str, connector_id: str, payload: dict, ctx: dict) -> dict:
+    async with SessionLocal() as session:
+        run_row = await session.get(ConnectorRun, run_id)
+        if not run_row:
+            return {"status": "skipped", "reason": "run_not_found"}
+        # Idempotência: se já finalizado, não reexecuta.
+        if run_row.status in {"ok", "erro", "sem_resultado", "bloqueada_por_politica"}:
+            return {"status": "skipped", "reason": "already_terminal"}
+
+        run_row.status = "em_execucao"
+        await session.commit()
+
+        connector = get_connector(connector_id)
+        ctx_obj = ConnectorContext(
+            tenant_id=ctx["tenant_id"], investigation_id=ctx["investigation_id"],
+            actor_id=ctx["actor_id"], correlation_id=ctx.get("correlation_id", "—"),
+            purpose=ctx.get("purpose", ""),
+        )
+
+        try:
+            await connector.validate_input(payload)
+            result = await connector.execute(payload, ctx_obj)
+        except Exception as e:  # noqa: BLE001
+            run_row.status = "erro"
+            run_row.error_code = type(e).__name__
+            run_row.error_message = str(e)[:500]
+            run_row.finished_at = datetime.now(timezone.utc)
+            await session.commit()
+            return {"status": "erro", "error": run_row.error_code}
+
+        run_row.status = result.status
+        run_row.result_summary = (result.summary or "")[:1000]
+        run_row.confidence = result.confidence
+        run_row.limitations = result.limitations
+        run_row.connector_version = result.connector_version
+        run_row.finished_at = datetime.now(timezone.utc)
+
+        # Snapshot bruto em S3 quando candidato
+        evidence = None
+        if result.evidence_candidate and result.status in {"ok", "sem_resultado"}:
+            inv = await session.get(Investigation, ctx_obj.investigation_id)
+            retain = datetime.combine(inv.retention_until, datetime.min.time(), tzinfo=timezone.utc)
+            raw_bytes = json.dumps(result.raw_data, ensure_ascii=False, sort_keys=True).encode()
+            stored = EvidenceVault.store(
+                tenant_id=ctx_obj.tenant_id, investigation_id=ctx_obj.investigation_id,
+                content=raw_bytes, mime_type="application/json", retain_until=retain,
+                extra_metadata={"connector": connector_id, "run_id": run_id},
+            )
+            run_row.raw_storage_key = stored.key
+            run_row.raw_payload_hash = stored.sha256
+
+            # Cria Evidence + evento encadeado
+            last_ev = (await session.execute(
+                select(EvidenceEvent.current_hash).order_by(EvidenceEvent.created_at.desc()).limit(1)
+            )).scalar_one_or_none()
+            prev = last_ev or GENESIS
+            ev_payload = {"sha256": stored.sha256, "source": result.source_name,
+                          "collected_at": result.collected_at.isoformat()}
+            cur = chain_next(prev, ev_payload)
+
+            evidence = Evidence(
+                id=str(uuid.uuid4()), tenant_id=ctx_obj.tenant_id,
+                investigation_id=ctx_obj.investigation_id, run_id=run_id,
+                source_name=result.source_name, source_type="api",
+                source_url=result.source_url, collection_method="agente_automatico",
+                collected_at=result.collected_at, collected_at_utc=result.collected_at.astimezone(timezone.utc),
+                collector_actor_id=ctx_obj.actor_id,
+                s3_bucket=stored.bucket, s3_key=stored.key, s3_version_id=stored.version_id,
+                s3_etag=stored.etag, object_lock_mode=stored.object_lock_mode,
+                retain_until=retain, legal_hold=False,
+                mime_type=stored.mime_type, size_bytes=stored.size,
+                sha256=stored.sha256, previous_event_hash=prev, event_hash=cur,
+                validation_status="pendente", av_status="ok",  # JSON nasce 'ok' (sem AV)
+                extracted_metadata={},
+            )
+            session.add(evidence)
+            session.add(EvidenceEvent(
+                id=str(uuid.uuid4()), tenant_id=ctx_obj.tenant_id, evidence_id=evidence.id,
+                investigation_id=ctx_obj.investigation_id, action="criacao",
+                actor_id=ctx_obj.actor_id, occurred_at=datetime.now(timezone.utc),
+                previous_hash=prev, current_hash=cur, details=ev_payload,
+            ))
+            # Cria Finding atrelado, classificado como 'dado_bruto'
+            session.add(Finding(
+                id=str(uuid.uuid4()), tenant_id=ctx_obj.tenant_id,
+                investigation_id=ctx_obj.investigation_id, entity_id=run_row.target_entity_id,
+                run_id=run_id, type=connector_id, title=(result.summary or connector_id)[:255],
+                statement=(result.summary or "")[:2000], source_count=1,
+                confidence_score=result.confidence, classification="dado_bruto",
+                human_validated=False, evidence_ids=[evidence.id],
+                method=connector_id, limitations=result.limitations,
+            ))
+
+        await AuditService(session).write(
+            action="connector.run", resource="connector_run", resource_id=run_id,
+            result=result.status, tenant_id=ctx_obj.tenant_id, actor_id=ctx_obj.actor_id,
+            correlation_id=ctx_obj.correlation_id,
+            metadata={"connector": connector_id, "summary": (result.summary or "")[:200]},
+        )
+        await session.commit()
+        return {"status": result.status, "evidence_id": evidence.id if evidence else None}
