+"""Catálogo de agentes disponíveis."""
+from app.agents.base import AgentSpec
+
+_AGENTS: dict[str, AgentSpec] = {
+    "coleta": AgentSpec(
+        agent_id="coleta", name="Agente de Coleta",
+        model_name="local-deterministic", model_version="1.0", prompt_version="2026-06",
+    ),
+    "metadados": AgentSpec(
+        agent_id="metadados", name="Agente de Metadados",
+        model_name="local-deterministic", model_version="1.0", prompt_version="2026-06",
+    ),
+    "timeline": AgentSpec(
+        agent_id="timeline", name="Agente de Timeline",
+        model_name="local-deterministic", model_version="1.0", prompt_version="2026-06",
+    ),
+    "correlacao": AgentSpec(
+        agent_id="correlacao", name="Agente de Correlação",
+        model_name="local-deterministic", model_version="1.0", prompt_version="2026-06",
+    ),
+    "inconsistencia": AgentSpec(
+        agent_id="inconsistencia", name="Agente de Inconsistência",
+        model_name="local-deterministic", model_version="1.0", prompt_version="2026-06",
+    ),
+    "relatorio": AgentSpec(
+        agent_id="relatorio", name="Agente de Relatório",
+        model_name="llm-premium", model_version="1.0", prompt_version="2026-06",
+    ),
+    "revisao_juridica": AgentSpec(
+        agent_id="revisao_juridica", name="Agente de Revisão Jurídica",
+        model_name="llm-premium", model_version="1.0", prompt_version="2026-06",
+    ),
+}
+
+
+def get_agent(agent_id: str) -> AgentSpec:
+    if agent_id not in _AGENTS:
+        raise KeyError(f"Agente '{agent_id}' não registrado.")
+    return _AGENTS[agent_id]
+
+
+def list_agents() -> list[str]:
+    return sorted(_AGENTS.keys())
diff --git a/backend/app/agents/runner.py b/backend/app/agents/runner.py
new file mode 100644
index 0000000..2b34981
--- /dev/null
+++ b/backend/app/agents/runner.py
@@ -0,0 +1,53 @@
+"""
+Executor de agentes supervisionados.
+
+Saída SEMPRE inicia como `DRAFT`. Aprovação humana (PolicyEngine +
+endpoint) é obrigatória para promover a `FINAL`. Saídas devem sempre
+incluir: fontes, evidence_ids, limitações, confiança, model_name, model_version,
+prompt_version.
+"""
+from datetime import datetime, timezone
+
+from sqlalchemy import select
+
+from app.agents.registry import get_agent
+from app.audit.service import AuditService
+from app.db.base import SessionLocal
+from app.models import AgentRun
+
+
+async def run_agent_supervised(agent_run_id: str) -> dict:
+    async with SessionLocal() as session:
+        run = await session.get(AgentRun, agent_run_id)
+        if not run:
+            return {"status": "not_found"}
+        if run.status in {"FINAL", "REJECTED"}:
+            return {"status": "skipped"}
+
+        spec = get_agent(run.agent_id)
+
+        # Stub: agentes determinísticos geram saída a partir de findings já existentes.
+        # Em produção, este é o ponto onde se chamaria o LLM com tools restritas.
+        output = {
+            "summary": f"[{spec.name}] análise preliminar baseada em dados estruturados.",
+            "fontes": [],
+            "evidence_ids": run.evidence_ids,
+            "limitations": "Saída automática — exige revisão humana antes de FINAL.",
+            "confidence": 0.5,
+            "model_name": spec.model_name,
+            "model_version": spec.model_version,
+            "prompt_version": spec.prompt_version,
+        }
+        run.output_payload = output
+        run.confidence = output["confidence"]
+        run.limitations = output["limitations"]
+        run.status = "DRAFT"  # explícito: nunca FINAL automaticamente
+        run.finished_at = datetime.now(timezone.utc)
+
+        await AuditService(session).write(
+            action="agent.run", resource="agent_run", resource_id=run.id,
+            tenant_id=run.tenant_id,
+            metadata={"agent_id": run.agent_id, "model": spec.model_name, "version": spec.model_version},
+        )
+        await session.commit()
+        return {"status": "DRAFT", "agent_run_id": run.id}
