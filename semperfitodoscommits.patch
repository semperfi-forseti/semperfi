+"""
+Cliente OIDC via Authlib.
+
+Em produção: Keycloak/Authentik/Clerk/Auth0. Em dev, fallback local
+(senha + bcrypt) só se LOCAL_AUTH_ENABLED=true.
+"""
+from typing import Any
+
+from authlib.integrations.httpx_client import AsyncOAuth2Client
+from authlib.jose import JsonWebKey, JsonWebToken
+
+from app.core.config import get_settings
+from app.core.errors import Unauthorized
+from app.security.ssrf import safe_get_json
+
+_jwks_cache: dict[str, Any] | None = None
+_discovery_cache: dict[str, Any] | None = None
+
+
+async def discovery() -> dict[str, Any]:
+    global _discovery_cache
+    if _discovery_cache is None:
+        s = get_settings()
+        if not s.oidc_issuer:
+            raise Unauthorized("OIDC não configurado.")
+        url = s.oidc_issuer.rstrip("/") + "/.well-known/openid-configuration"
+        _discovery_cache = await safe_get_json(url)
+    return _discovery_cache
+
+
+async def jwks() -> dict[str, Any]:
+    global _jwks_cache
+    if _jwks_cache is None:
+        d = await discovery()
+        _jwks_cache = await safe_get_json(d["jwks_uri"])
+    return _jwks_cache
+
+
+def authorization_url(redirect_uri: str, state: str, nonce: str) -> str:
+    s = get_settings()
+    cli = AsyncOAuth2Client(client_id=s.oidc_client_id, client_secret=s.oidc_client_secret.get_secret_value(),
+                            scope="openid email profile")
+    # Authlib gera a URL síncrona — discovery deve estar disponível
+    url, _ = cli.create_authorization_url(_discovery_cache["authorization_endpoint"], state=state, nonce=nonce, redirect_uri=redirect_uri)
+    return url
+
+
+async def exchange_code(code: str, redirect_uri: str) -> dict[str, Any]:
+    s = get_settings()
+    d = await discovery()
+    async with AsyncOAuth2Client(client_id=s.oidc_client_id, client_secret=s.oidc_client_secret.get_secret_value()) as cli:
+        token = await cli.fetch_token(d["token_endpoint"], code=code, redirect_uri=redirect_uri, grant_type="authorization_code")
+    return token
+
+
+async def validate_id_token(id_token: str) -> dict[str, Any]:
+    keys = JsonWebKey.import_key_set(await jwks())
+    claims = JsonWebToken(["RS256", "ES256"]).decode(id_token, keys)
+    claims.validate()
+    s = get_settings()
+    if s.oidc_audience and s.oidc_audience not in (claims.get("aud") or []):
+        raise Unauthorized("Audience inválido.")
+    return dict(claims)
