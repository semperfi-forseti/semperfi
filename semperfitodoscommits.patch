+"""Full integrity scan diário."""
+import asyncio
+
+from app.db.base import SessionLocal
+from app.integrity.verifier import full_scan, persist_report
+from app.workers.celery_app import celery_app
+
+
+@celery_app.task(name="app.workers.tasks.integrity_full.run", bind=True)
+def run(self) -> dict:
+    return asyncio.run(_run())
+
+
