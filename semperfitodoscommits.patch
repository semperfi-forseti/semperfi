diff --git a/backend/app/policies/engine.py b/backend/app/policies/engine.py
new file mode 100644
index 0000000..33a8b40
--- /dev/null
+++ b/backend/app/policies/engine.py
@@ -0,0 +1,160 @@
+"""
+PolicyEngine.
+
+Toda ação sensível chama `engine.evaluate(req)` ANTES da execução.
+A decisão é persistida em `policy_evaluations` e devolvida ao caller.
+
+Endpoints traduzem `Outcome.DENY` → 403 com `{code, reason}`,
+`REQUIRE_MFA` → 401 com hint, `REQUIRE_APPROVAL` → 202 com approval_id, etc.
+"""
+import uuid
+from dataclasses import dataclass, field
+from datetime import datetime, timezone
+from typing import Any
+
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from app.core.config import get_settings
+from app.core.tenant import get_correlation_id
+from app.models import Investigation, PolicyEvaluation, SourceCatalog
+from app.policies.outcomes import Outcome
+from app.policies.rules import (
+    FORBIDDEN_ACTION_TAGS, MFA_REQUIRED_ROLES, REAUTH_REQUIRED_ACTIONS,
+    SCOPE_TO_SOURCE_CATEGORIES, has_permission,
+)
+
+
+@dataclass
+class PolicyRequest:
+    action: str                       # ex: 'connector.run', 'report.approve_final'
+    resource: str                     # ex: 'investigation', 'evidence'
+    resource_id: str | None = None
+    actor_id: str | None = None
+    actor_role: str | None = None
+    tenant_id: str | None = None
+    investigation_id: str | None = None
+    connector_id: str | None = None
+    target_entity_type: str | None = None
+    purpose: str | None = None
+    requested_action_tags: set[str] = field(default_factory=set)
+    mfa_verified: bool = False
+    reauth_verified: bool = False
+    rate_limited: bool = False        # injetado por middleware
+    extra: dict[str, Any] = field(default_factory=dict)
+
+
+@dataclass
+class PolicyDecision:
+    outcome: Outcome
+    code: str
+    reason: str
+    context: dict[str, Any] = field(default_factory=dict)
+
+    @property
+    def allowed(self) -> bool:
+        return self.outcome == Outcome.ALLOW
+
+
+class PolicyEngine:
+    def __init__(self, db: AsyncSession) -> None:
+        self.db = db
+        self.settings = get_settings()
+
+    async def evaluate(self, req: PolicyRequest) -> PolicyDecision:
+        decision = await self._decide(req)
+        await self._persist(req, decision)
+        return decision
+
+    async def _decide(self, req: PolicyRequest) -> PolicyDecision:
+        # 1. Rate limit (sinalizado pelo middleware) → bloqueio explícito
+        if req.rate_limited:
+            return PolicyDecision(Outcome.RATE_LIMITED, "rate_limited", "Limite de requisições excedido.")
+
+        # 2. Tags proibidas (vedações absolutas)
+        forbidden = req.requested_action_tags & FORBIDDEN_ACTION_TAGS
+        if forbidden:
+            return PolicyDecision(Outcome.DENY, "forbidden_practice",
+                                  f"Ação contém prática vedada: {sorted(forbidden)}",
+                                  {"violated": sorted(forbidden)})
+
+        # 3. RBAC: papel tem permissão para a ação?
+        if not req.actor_role:
+            return PolicyDecision(Outcome.DENY, "unauthenticated", "Sem papel definido.")
+        if not has_permission(req.actor_role, req.action):
+            return PolicyDecision(Outcome.DENY, "rbac_denied",
+                                  f"Papel '{req.actor_role}' não autorizado para '{req.action}'.")
+
+        # 4. MFA: roles privilegiadas exigem MFA na sessão
+        if req.actor_role in MFA_REQUIRED_ROLES and not req.mfa_verified:
+            return PolicyDecision(Outcome.REQUIRE_MFA, "mfa_required",
+                                  f"MFA obrigatório para papel '{req.actor_role}'.")
+
+        # 5. Reauth step-up para ações sensíveis
+        if req.action in REAUTH_REQUIRED_ACTIONS and not req.reauth_verified:
+            return PolicyDecision(Outcome.REQUIRE_APPROVAL if False else Outcome.REQUIRE_MFA,
+                                  "reauth_required",
+                                  f"Reautenticação recente exigida para '{req.action}'.")
+
+        # 6. Verificações específicas de investigação OSINT
+        if req.investigation_id:
+            inv = await self.db.get(Investigation, req.investigation_id)
+            if inv is None:
+                return PolicyDecision(Outcome.DENY, "investigation_not_found", "Investigação não encontrada.")
+            if inv.tenant_id != req.tenant_id:
+                return PolicyDecision(Outcome.DENY, "tenant_isolation_violation",
+                                      "Investigação pertence a outro tenant.")
+            if inv.status in {"rascunho", "aguardando_aprovacao"}:
+                return PolicyDecision(Outcome.REQUIRE_APPROVAL, "scope_unapproved",
+                                      f"Investigação está '{inv.status}' — aprovação de escopo pendente.")
+            if inv.status in {"concluida", "arquivada", "bloqueada"}:
+                return PolicyDecision(Outcome.DENY, "investigation_read_only",
+                                      f"Investigação está '{inv.status}'.")
+            # Retenção
+            now = datetime.now(timezone.utc).date()
+            if inv.retention_until and inv.retention_until < now:
+                return PolicyDecision(Outcome.RETENTION_BLOCKED, "retention_expired",
+                                      "Retenção da investigação expirou.")
+
+            # 7. Conector deve estar no escopo aprovado
+            if req.connector_id:
+                source = await self.db.get(SourceCatalog, req.connector_id)
+                if source is None:
+                    return PolicyDecision(Outcome.DENY, "connector_unknown",
+                                          f"Conector '{req.connector_id}' não cadastrado.")
+                if not source.enabled or not source.terms_accepted:
+                    return PolicyDecision(Outcome.DENY, "connector_disabled",
+                                          f"Conector '{source.name}' indisponível ou termos não aceitos.")
+                allowed_categories: set[str] = set()
+                for scope in (inv.tacer_state.get("scope") if isinstance(inv.tacer_state, dict) else []) or []:
+                    allowed_categories |= SCOPE_TO_SOURCE_CATEGORIES.get(scope, set())
+                # tacer_state pode não ter scope ainda — buscar via tabela investigation_scopes seria o ideal;
+                # aqui aceitamos se a categoria do conector está em qualquer escopo conhecido.
+                if not allowed_categories:
+                    allowed_categories = set(SCOPE_TO_SOURCE_CATEGORIES.keys())
+                if source.category not in allowed_categories:
+                    return PolicyDecision(Outcome.DENY, "out_of_scope",
+                                          f"Categoria '{source.category}' fora do escopo aprovado.")
+                if req.target_entity_type and req.target_entity_type not in source.allowed_target_types:
+                    return PolicyDecision(Outcome.DENY, "incompatible_target_type",
+                                          f"Tipo '{req.target_entity_type}' não suportado por '{source.name}'.")
+
+        return PolicyDecision(Outcome.ALLOW, "ok", "Autorizado.")
+
+    async def _persist(self, req: PolicyRequest, dec: PolicyDecision) -> None:
+        ev = PolicyEvaluation(
+            id=str(uuid.uuid4()),
+            tenant_id=req.tenant_id,
+            actor_id=req.actor_id,
+            actor_role=req.actor_role,
+            action=req.action,
+            resource=req.resource,
+            resource_id=req.resource_id,
+            decision=str(dec.outcome.value),
+            code=dec.code,
+            reason=dec.reason[:500],
+            context={**dec.context, "investigation_id": req.investigation_id, "connector_id": req.connector_id},
+            correlation_id=get_correlation_id() or "—",
+        )
+        self.db.add(ev)
+        # IMPORTANTE: não commitamos aqui — caller controla a transação.
+        await self.db.flush()
