+"""Evidência preservada + eventos encadeados (hash chain)."""
+from datetime import datetime
+from sqlalchemy import JSON, DateTime, ForeignKey, String, Text, func
+from sqlalchemy.orm import Mapped, mapped_column
+
+from app.database import Base
+
+
+class Evidence(Base):
+    __tablename__ = "evidence"
+
+    id: Mapped[str] = mapped_column(String(36), primary_key=True)
+    investigation_id: Mapped[str] = mapped_column(String(36), ForeignKey("investigations.id", ondelete="CASCADE"), index=True)
+    finding_id: Mapped[str | None] = mapped_column(String(36), ForeignKey("osint_findings.id", ondelete="SET NULL"), nullable=True)
+    entity_id: Mapped[str | None] = mapped_column(String(36), ForeignKey("osint_entities.id", ondelete="SET NULL"), nullable=True)
+    run_id: Mapped[str | None] = mapped_column(String(36), ForeignKey("osint_runs.id", ondelete="SET NULL"), nullable=True)
+
+    source_name: Mapped[str] = mapped_column(String(120))
+    source_type: Mapped[str] = mapped_column(String(60))
+    source_url: Mapped[str | None] = mapped_column(Text, nullable=True)
+    collection_method: Mapped[str] = mapped_column(String(60))
+
+    collected_at: Mapped[datetime] = mapped_column(DateTime(timezone=True), server_default=func.now())
+    collected_at_utc: Mapped[datetime] = mapped_column(DateTime(timezone=True))
+    actor_id: Mapped[str] = mapped_column(String(36), index=True)
+
+    # Conteúdo vai para S3; aqui ficam apenas as chaves.
+    raw_storage_key: Mapped[str] = mapped_column(String(255))
+    visual_snapshot_key: Mapped[str | None] = mapped_column(String(255), nullable=True)
+    original_file_key: Mapped[str | None] = mapped_column(String(255), nullable=True)
+
+    sha256: Mapped[str] = mapped_column(String(64), index=True)
+    previous_event_hash: Mapped[str] = mapped_column(String(64))
+    event_hash: Mapped[str] = mapped_column(String(64), index=True)
+    timestamp_token_ref: Mapped[str | None] = mapped_column(String(255), nullable=True)  # carimbo do tempo
+
+    validation_status: Mapped[str] = mapped_column(String(30), default="pendente", index=True)  # pendente|validada|refutada
+    reviewer_id: Mapped[str | None] = mapped_column(String(36), nullable=True)
+    notes: Mapped[str | None] = mapped_column(Text, nullable=True)
+    retention_until: Mapped[datetime] = mapped_column(DateTime(timezone=True))
+
+
+class EvidenceEvent(Base):
+    """Cadeia de eventos sobre a evidência (hash-chained, append-only)."""
+    __tablename__ = "evidence_events"
+
+    id: Mapped[str] = mapped_column(String(36), primary_key=True)
+    evidence_id: Mapped[str] = mapped_column(String(36), ForeignKey("evidence.id", ondelete="CASCADE"), index=True)
+    investigation_id: Mapped[str] = mapped_column(String(36), index=True)
+
+    action: Mapped[str] = mapped_column(String(60))  # criacao|validacao_humana|inclusao_relatorio|...
+    actor_id: Mapped[str] = mapped_column(String(36), index=True)
+    timestamp: Mapped[datetime] = mapped_column(DateTime(timezone=True), server_default=func.now())
+
+    previous_hash: Mapped[str] = mapped_column(String(64))
+    current_hash: Mapped[str] = mapped_column(String(64), index=True)
+    details: Mapped[dict] = mapped_column(JSON, default=dict)
