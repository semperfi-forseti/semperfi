+"""Detecção real de MIME (magic bytes) + whitelist."""
+import magic
+
+MIME_WHITELIST: frozenset[str] = frozenset({
+    "application/pdf",
+    "image/png", "image/jpeg", "image/tiff", "image/webp",
+    "application/msword", "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
+    "application/vnd.oasis.opendocument.text",
+    "application/vnd.ms-excel", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
+    "video/mp4", "video/quicktime",
+    "audio/mpeg", "audio/wav",
+    "text/plain", "text/csv",
+    "application/json",
+})
+
+
+def detect_real_mime(content: bytes) -> str:
+    """python-magic via libmagic — não confia em extensão."""
+    return magic.from_buffer(content[:8192], mime=True)
+
+
+def is_whitelisted(mime: str) -> bool:
+    return mime in MIME_WHITELIST
