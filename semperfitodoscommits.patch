--- /dev/null
+++ b/backend/app/policies/rules.py
@@ -0,0 +1,82 @@
+"""
+Regras estáticas do PolicyEngine.
+
+Onde possível, política expressa como dados (RBAC matrix, scope map,
+forbidden tags). Regras dinâmicas (retention, rate limit, MFA) ficam
+no PolicyEngine.
+"""
+from typing import Final
+
+# RBAC: papel → permissões
+ROLE_PERMISSIONS: Final[dict[str, set[str]]] = {
+    "admin": {"*"},
+    "gestor": {
+        "client.*", "process.*", "deadline.*", "intimation.*", "financial.*",
+        "investigation.*", "evidence.read", "evidence.validate", "report.*",
+        "agent.run", "approval.decide", "audit.read",
+    },
+    "advogado": {
+        "client.*", "process.*", "deadline.*", "intimation.*", "financial.read",
+        "investigation.read", "investigation.create", "evidence.read",
+        "report.read", "report.create", "audit.read",
+    },
+    "investigador": {
+        "client.read", "process.read", "investigation.*",
+        "entity.*", "run.execute", "finding.*", "evidence.read", "evidence.create",
+        "agent.run", "audit.read",
+    },
+    "revisor": {
+        "investigation.read", "finding.validate", "evidence.read", "evidence.validate",
+        "report.read", "report.approve", "audit.read",
+    },
+    "auditor": {
+        "*.read", "audit.*", "report.read", "evidence.read",
+    },
+    "consulta": {
+        "client.read", "process.read", "investigation.read", "evidence.read",
+    },
+}
+
+# Roles que SEMPRE exigem MFA
+MFA_REQUIRED_ROLES: Final[set[str]] = {"admin", "gestor", "investigador", "auditor"}
+
+# Ações que sempre exigem reauth step-up (token MFA recente)
+REAUTH_REQUIRED_ACTIONS: Final[set[str]] = {
+    "evidence.download", "evidence.legal_hold", "evidence.retention.change",
+    "report.approve_final", "data.export",
+}
+
+# Fontes permitidas por categoria do escopo
+SCOPE_TO_SOURCE_CATEGORIES: Final[dict[str, set[str]]] = {
+    "empresarial": {"empresarial"},
+    "judicial_publico": {"judicial_publico"},
+    "integridade_publica": {"integridade_publica"},
+    "mercado_companhias_abertas": {"mercado_companhias_abertas"},
+    "territorial_cadastral": {"territorial_cadastral"},
+    "prova_digital": {"prova_digital"},
+    "seguranca_digital_defensiva": {"seguranca_digital_defensiva"},
+}
+
+# Tags de ação proibidas (qualquer match → DENY irrevogável)
+FORBIDDEN_ACTION_TAGS: Final[set[str]] = {
+    "captcha_bypass", "scraping_login", "vazamento", "credenciais",
+    "senhas", "cookies_terceiros", "localizacao_tempo_real",
+    "reconhecimento_facial", "perfil_psicologico", "previsao_criminal",
+    "coleta_massiva_pessoal", "dados_obtidos_ilicitamente",
+    "port_scanning", "engenharia_social", "acusacao_automatica",
+}
+
+
+def has_permission(role: str, perm: str) -> bool:
+    allowed = ROLE_PERMISSIONS.get(role, set())
+    if "*" in allowed:
+        return True
+    if perm in allowed:
+        return True
+    # wildcard: 'client.*' inclui 'client.read'
+    prefix = perm.split(".")[0] + ".*"
+    if prefix in allowed:
+        return True
+    # '*.read' inclui qualquer X.read
+    suffix = "*." + perm.split(".")[-1]
+    return suffix in allowed
