@@ -0,0 +1,27 @@
+resource "aws_kms_key" "evidence" {
+  description             = "SEMPER-FI ${var.env} — evidence encryption"
+  deletion_window_in_days = 30
+  enable_key_rotation     = true
+  policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = concat(
+      [{
+        Sid = "EnableRoot", Effect = "Allow", Principal = { AWS = "arn:aws:iam::${data.aws_caller_identity.current.account_id}:root" },
+        Action = "kms:*", Resource = "*"
+      }],
+      [for arn in var.kms_admin_arns : {
+        Sid = "AdminAccess", Effect = "Allow", Principal = { AWS = arn },
+        Action = ["kms:Describe*","kms:List*","kms:Encrypt","kms:Decrypt","kms:GenerateDataKey*"],
+        Resource = "*"
+      }]
+    )
+  })
+}
+
+resource "aws_kms_alias" "evidence" {
+  name          = "alias/semperfi-evidence-${var.env}"
+  target_key_id = aws_kms_key.evidence.id
+}
+
+data "aws_caller_identity" "current" {}
+output "kms_evidence_key_id" { value = aws_kms_key.evidence.id }
