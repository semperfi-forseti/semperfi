+    DB.deadlines.sort((a,b)=>a.date.localeCompare(b.date)).forEach(d=>{const p=dbGet('processes',d.processId);html+=`<tr><td>${fmtDate(d.date)}</td><td>${d.title}</td><td>${p?.number||''}</td><td>${d.responsible||''}</td><td>${d.status}</td></tr>`;});
