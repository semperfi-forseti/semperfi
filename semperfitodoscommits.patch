+"""RBAC: matriz de permissões + escalação horizontal."""
+import pytest
+
+from app.policies.rules import MFA_REQUIRED_ROLES, REAUTH_REQUIRED_ACTIONS, has_permission
+
+
+def test_admin_has_everything():
+    assert has_permission("admin", "client.delete")
+    assert has_permission("admin", "anything.invented")
+
+
+def test_consulta_cannot_write():
+    assert not has_permission("consulta", "client.create")
+    assert has_permission("consulta", "client.read")
+
+
+def test_revisor_cannot_execute_run():
+    assert has_permission("revisor", "evidence.validate")
+    assert not has_permission("revisor", "run.execute")
+
+
+def test_auditor_read_only():
+    assert has_permission("auditor", "audit.read")
+    assert has_permission("auditor", "evidence.read")
+    assert not has_permission("auditor", "client.create")
+
+
+def test_privileged_roles_require_mfa():
+    assert "admin" in MFA_REQUIRED_ROLES
+    assert "investigador" in MFA_REQUIRED_ROLES
+    assert "consulta" not in MFA_REQUIRED_ROLES
+
+
+def test_sensitive_actions_need_reauth():
+    assert "evidence.download" in REAUTH_REQUIRED_ACTIONS
+    assert "evidence.legal_hold" in REAUTH_REQUIRED_ACTIONS
+    assert "report.approve_final" in REAUTH_REQUIRED_ACTIONS
