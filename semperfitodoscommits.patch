+"""
+Portal da Transparência — CEIS / CNEP / CEPIM.
+
+Documentação: https://api.portaldatransparencia.gov.br/swagger-ui/index.html
+Cabeçalho obrigatório: `chave-api-dados: <TOKEN>`
+Rate limit por IP/horário definido pelo portal — controlar no backend.
+"""
+from app.config import get_settings
+from app.connectors._http import request_json
+from app.connectors.base import BaseConnector, ConnectorResult
+
+settings = get_settings()
+
+
+def _headers() -> dict:
+    if not settings.transparencia_api_token:
+        raise RuntimeError("TRANSPARENCIA_API_TOKEN não configurado")
+    return {"chave-api-dados": settings.transparencia_api_token}
+
+
+class _TransparenciaBase(BaseConnector):
+    path: str
+    short_label: str
+
+    async def fetch(self, payload: dict) -> ConnectorResult:
+        params = {k: v for k, v in payload.items() if v not in (None, "")}
+        url = f"{settings.transparencia_base_url}/{self.path}"
+        try:
+            data = await request_json("GET", url, headers=_headers(), params=params)
+        except RuntimeError as e:
+            return ConnectorResult(status="bloqueado", summary=str(e), raw_data={}, source_id=self.id, source_name=self.name, error_message=str(e), evidence_candidate=False)
+        except Exception as e:
+            return ConnectorResult(status="erro", summary=f"Falha: {e}", raw_data={}, source_id=self.id, source_name=self.name, source_url=url, error_message=str(e), evidence_candidate=False)
+        encontrados = len(data) if isinstance(data, list) else (1 if data else 0)
+        # IMPORTANTE: nunca afirmar culpa/fraude/ilicitude.
+        summary = f"{self.short_label}: {encontrados} registro(s) público(s) — sujeito a validação documental"
+        return ConnectorResult(
+            status="ok" if encontrados else "sem_resultado",
+            summary=summary, raw_data=data,
+            source_id=self.id, source_name=self.name, source_url=url,
+            confidence=0.95,
+            limitations="Resultado refere-se a registros públicos. Não constitui declaração de culpa/fraude/ilicitude. Validar via processo administrativo de origem.",
+        )
+
+
+class TransparenciaCEISConnector(_TransparenciaBase):
+    id = "transparencia_ceis"
+    name = "Portal Transparência — CEIS"
+    short_label = "CEIS (inidôneas/suspensas)"
+    path = "ceis"
+
+
+class TransparenciaCNEPConnector(_TransparenciaBase):
+    id = "transparencia_cnep"
+    name = "Portal Transparência — CNEP"
+    short_label = "CNEP (empresas punidas)"
+    path = "cnep"
+
+
+class TransparenciaCEPIMConnector(_TransparenciaBase):
+    id = "transparencia_cepim"
+    name = "Portal Transparência — CEPIM"
+    short_label = "CEPIM (entidades impedidas)"
+    path = "cepim"
