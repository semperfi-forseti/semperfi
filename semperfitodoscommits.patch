+"""Headers de segurança + CSRF middleware."""
+import hashlib
+import hmac
+import secrets
+
+from fastapi import Request, Response
+from starlette.middleware.base import BaseHTTPMiddleware
+
+from app.core.config import get_settings
+
+
+class SecurityHeadersMiddleware(BaseHTTPMiddleware):
+    async def dispatch(self, request: Request, call_next) -> Response:
+        response: Response = await call_next(request)
+        response.headers["Strict-Transport-Security"] = "max-age=63072000; includeSubDomains; preload"
+        response.headers["X-Content-Type-Options"] = "nosniff"
+        response.headers["X-Frame-Options"] = "DENY"
+        response.headers["Referrer-Policy"] = "strict-origin-when-cross-origin"
+        response.headers["Permissions-Policy"] = "geolocation=(), camera=(), microphone=()"
+        # CSP estrito; ajuste se servir UI estática
+        response.headers["Content-Security-Policy"] = (
+            "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; "
+            "script-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'"
+        )
+        return response
+
+
+class CSRFMiddleware(BaseHTTPMiddleware):
+    """
+    Double-submit cookie. Em ações state-changing (POST/PUT/PATCH/DELETE)
+    exigimos header X-CSRF-Token == cookie sf_csrf.
+    GET/HEAD/OPTIONS passam; também passa /v1/auth/* (login monta cookie).
+    """
+    SAFE_METHODS = {"GET", "HEAD", "OPTIONS"}
+    EXEMPT_PATHS = ("/v1/auth/", "/health/", "/metrics", "/docs", "/openapi.json", "/redoc")
+
+    async def dispatch(self, request: Request, call_next) -> Response:
+        s = get_settings()
+        if request.method in self.SAFE_METHODS or any(request.url.path.startswith(p) for p in self.EXEMPT_PATHS):
+            return await call_next(request)
+        cookie = request.cookies.get(s.csrf_cookie_name)
+        header = request.headers.get("x-csrf-token")
+        if not cookie or not header or not hmac.compare_digest(cookie, header):
+            return Response(content='{"error":{"code":"csrf_failed","message":"CSRF token ausente/inválido."}}',
+                            status_code=403, media_type="application/json")
+        return await call_next(request)
+
+
+def issue_csrf_cookie(response: Response) -> str:
+    token = secrets.token_urlsafe(24)
+    s = get_settings()
+    response.set_cookie(
+        key=s.csrf_cookie_name, value=token,
+        httponly=False, secure=s.session_cookie_secure, samesite=s.session_cookie_samesite,
+        max_age=s.session_max_age_seconds,
+    )
+    return token
