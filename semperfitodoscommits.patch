+"""Sweep diário de retenção — alerta itens próximos da expiração."""
+import asyncio
+from datetime import datetime, timedelta, timezone
+
+from sqlalchemy import select
+
+from app.audit.service import AuditService
+from app.db.base import SessionLocal
+from app.models import Evidence, Investigation
+from app.workers.celery_app import celery_app
+
+
+@celery_app.task(name="app.workers.tasks.retention.sweep", bind=True)
+def sweep(self) -> dict:
+    return asyncio.run(_sweep())
+
+
+async def _sweep() -> dict:
+    warn_days = 30
+    cutoff = datetime.now(timezone.utc) + timedelta(days=warn_days)
+    warned = 0
+    async with SessionLocal() as session:
+        # Evidências expirando em <30d
+        rows = (await session.execute(
+            select(Evidence).where(Evidence.retain_until <= cutoff, Evidence.legal_hold.is_(False)).limit(500)
+        )).scalars().all()
+        for ev in rows:
+            await AuditService(session).write(
+                action="retention.warning", resource="evidence", resource_id=ev.id,
+                tenant_id=ev.tenant_id, result="warning",
+                metadata={"retain_until": ev.retain_until.isoformat()},
+            )
+            warned += 1
+        await session.commit()
+    return {"warned": warned}
