+"""MFA via TOTP (RFC 6238). Hook para WebAuthn pode ser adicionado depois."""
+import secrets
+
+import pyotp
+
+from app.core.config import get_settings
+
+
+def generate_secret() -> str:
+    return pyotp.random_base32()
+
+
+def provisioning_uri(secret: str, *, account: str) -> str:
+    s = get_settings()
+    return pyotp.TOTP(secret).provisioning_uri(name=account, issuer_name=s.mfa_totp_issuer)
+
+
+def verify_totp(secret: str, code: str, valid_window: int = 1) -> bool:
+    if not secret or not code or not code.isdigit():
+        return False
+    return pyotp.TOTP(secret).verify(code, valid_window=valid_window)
+
+
+def random_recovery_codes(n: int = 8) -> list[str]:
+    return [secrets.token_hex(4) for _ in range(n)]
