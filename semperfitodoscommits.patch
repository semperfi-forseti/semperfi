+"""Endpoints de investigação."""
+import uuid
+from datetime import datetime, timedelta, timezone
+
+from fastapi import APIRouter, Depends, HTTPException
+from sqlalchemy.orm import Session
+
+from app.api.deps import db_session, requires
+from app.models import Investigation
+from app.schemas.investigation import InvestigationCreate, InvestigationOut
+from app.services.audit import write_event
+
+router = APIRouter(prefix="/api/osint/investigations", tags=["investigations"])
+
+
+@router.post("", response_model=InvestigationOut, status_code=201)
+def create_investigation(
+    data: InvestigationCreate,
+    db: Session = Depends(db_session),
+    user: dict = Depends(requires("investigation.create")),
+):
+    if not data.declaration_of_legitimate_purpose:
+        raise HTTPException(400, "Declaração de finalidade legítima é obrigatória")
+
+    inv = Investigation(
+        id=str(uuid.uuid4()),
+        title=data.title,
+        objective=data.objective,
+        hypothesis=data.hypothesis,
+        category=data.category,
+        legal_basis=data.legal_basis,
+        legitimate_interest_assessment=data.legitimate_interest_assessment,
+        authorization_reference=data.authorization_reference,
+        client_id=data.client_id,
+        process_id=data.process_id,
+        owner_id=user["id"],
+        status="em_coleta",  # já passou pela declaração na etapa 4
+        risk_level=data.risk_level,
+        priority=data.priority,
+        scope=list(data.scope),
+        questions=data.questions,
+        purpose=data.purpose,
+        retention_until=datetime.now(timezone.utc) + timedelta(days=365 * data.retention_years),
+    )
+    db.add(inv)
+    db.commit()
+    db.refresh(inv)
+
+    write_event(
+        db, actor_id=user["id"], actor_role=user["role"],
+        module="osint", action="criacao_investigacao",
+        target_id=inv.id, metadata={"title": inv.title, "scope": inv.scope},
+    )
+    write_event(
+        db, actor_id=user["id"], actor_role=user["role"],
+        module="osint", action="aprovacao_escopo",
+        target_id=inv.id, metadata={"scope": inv.scope, "declaration": True},
+    )
+    return inv
+
+
+@router.get("", response_model=list[InvestigationOut])
+def list_investigations(
+    db: Session = Depends(db_session),
+    user: dict = Depends(requires("investigation.read")),
+    status_filter: str | None = None,
+):
+    q = db.query(Investigation)
+    if status_filter:
+        q = q.filter(Investigation.status == status_filter)
+    return q.order_by(Investigation.created_at.desc()).limit(200).all()
+
+
+@router.get("/{inv_id}", response_model=InvestigationOut)
+def get_investigation(
+    inv_id: str,
+    db: Session = Depends(db_session),
+    user: dict = Depends(requires("investigation.read")),
+):
+    inv = db.get(Investigation, inv_id)
+    if not inv:
+        raise HTTPException(404, "Investigação não encontrada")
+    return inv
