+celery_app.conf.update(
+    task_acks_late=True,
+    worker_prefetch_multiplier=1,
+    task_default_queue="osint",
+    task_routes={"app.workers.tasks.*": {"queue": "osint"}},
+    task_time_limit=120,
+    task_soft_time_limit=90,
+    task_serializer="json",
+    result_serializer="json",
+    accept_content=["json"],
+    timezone="America/Sao_Paulo",
+)
diff --git a/backend/app/workers/tasks.py b/backend/app/workers/tasks.py
new file mode 100644
index 0000000..6e658aa
--- /dev/null
+++ b/backend/app/workers/tasks.py
@@ -0,0 +1,122 @@
+"""
+Tarefas Celery: execução de coletas OSINT.
+
+Fluxo:
+  1. Valida política (motor de políticas).
+  2. Executa conector (httpx async via asyncio.run no worker).
+  3. Persiste OsintRun + cria evidência (S3 + DB) se candidato.
+  4. Encadeia evento na auditoria.
+"""
+import asyncio
+import json
+import uuid
+from datetime import datetime, timedelta, timezone
+
+from celery.utils.log import get_task_logger
+
+from app.connectors.registry import get_connector
+from app.database import SessionLocal
+from app.models import Evidence, EvidenceEvent, Investigation, OsintFinding, OsintRun
+from app.services.audit import write_event
+from app.services.evidence_vault import store_evidence
+from app.services.hash_chain import GENESIS, chain_next, sha256_hex
+from app.services.policy_engine import evaluate_run
+from app.workers.celery_app import celery_app
+
+log = get_task_logger(__name__)
+
+
+@celery_app.task(bind=True, max_retries=2, default_retry_delay=10)
+def execute_run(
+    self,
+    *,
+    run_id: str,
+    investigation_id: str,
+    connector_id: str,
+    target_entity_id: str | None,
+    payload: dict,
+    actor_id: str,
+    actor_role: str,
+    correlation_id: str,
+) -> dict:
+    db = SessionLocal()
+    try:
+        # 1. Política
+        decision = evaluate_run(db, investigation_id=investigation_id, connector_id=connector_id, target_entity_id=target_entity_id)
+        if not decision.allowed:
+            run = db.get(OsintRun, run_id)
+            if run:
+                run.status = "bloqueada_por_politica"
+                run.error_message = decision.reason
+                run.finished_at = datetime.now(timezone.utc)
+                db.commit()
+            write_event(db, actor_id=actor_id, actor_role=actor_role, module="osint", action=decision.audit_action, target_id=investigation_id, result="bloqueada", metadata={"connector": connector_id, "reason": decision.reason}, correlation_id=correlation_id)
+            return {"status": "bloqueada", "reason": decision.reason}
+
+        # 2. Coleta (async em loop dedicado)
+        connector = get_connector(connector_id)
+        result = asyncio.run(connector.fetch(payload))
+
+        run = db.get(OsintRun, run_id)
+        run.status = "ok" if result.status == "ok" else result.status
+        run.result_summary = result.summary[:1000]
+        run.error_message = result.error_message
+        run.finished_at = datetime.now(timezone.utc)
+
+        # 3. Cofre + evidência (se candidato)
+        if result.evidence_candidate and result.status in {"ok", "sem_resultado"}:
+            inv = db.get(Investigation, investigation_id)
+            raw_bytes = json.dumps(result.raw_data, ensure_ascii=False, sort_keys=True).encode("utf-8")
+            retain_until = inv.retention_until if inv else datetime.now(timezone.utc) + timedelta(days=1825)
+            stored = store_evidence(
+                investigation_id=investigation_id, content=raw_bytes,
+                retain_until=retain_until, content_type="application/json", suffix="raw",
+                metadata={"connector": connector_id, "run_id": run_id},
+            )
+            # Encadeia hash do evento da evidência.
+            last_ev = db.query(EvidenceEvent).order_by(EvidenceEvent.timestamp.desc()).first()
+            previous_hash = last_ev.current_hash if last_ev else GENESIS
+            ev_payload = {"sha256": stored.sha256, "source": result.source_name, "collected_at": result.collected_at.isoformat()}
+            current_hash = chain_next(previous_hash, ev_payload)
+
+            evidence = Evidence(
+                id=str(uuid.uuid4()),
+                investigation_id=investigation_id,
+                entity_id=target_entity_id, run_id=run_id,
+                source_name=result.source_name, source_type="api",
+                source_url=result.source_url, collection_method="agente_automatico",
+                collected_at_utc=result.collected_at, actor_id=actor_id,
+                raw_storage_key=stored.key,
+                sha256=stored.sha256,
+                previous_event_hash=previous_hash, event_hash=current_hash,
+                validation_status="pendente",
+                retention_until=retain_until,
+            )
+            db.add(evidence)
+            db.flush()
+            db.add(EvidenceEvent(
+                id=str(uuid.uuid4()), evidence_id=evidence.id, investigation_id=investigation_id,
+                action="criacao", actor_id=actor_id,
+                previous_hash=previous_hash, current_hash=current_hash,
+                details=ev_payload,
+            ))
+
+            # Cria finding atrelado
+            db.add(OsintFinding(
+                id=str(uuid.uuid4()),
+                investigation_id=investigation_id, entity_id=target_entity_id, run_id=run_id,
+                type=connector_id, title=result.summary[:255], statement=result.summary,
+                source_count=1, confidence_score=result.confidence,
+                classification="dado_bruto", human_validated=False,
+                evidence_ids=[evidence.id],
+            ))
+
+        db.commit()
+        write_event(db, actor_id=actor_id, actor_role=actor_role, module="osint", action="execucao_coleta", target_id=investigation_id, result="sucesso" if result.status == "ok" else result.status, metadata={"connector": connector_id, "run_id": run_id, "summary": result.summary[:200]}, correlation_id=correlation_id)
+        return {"status": result.status, "summary": result.summary, "run_id": run_id}
+    except Exception as e:
+        log.exception("execute_run falhou")
+        write_event(db, actor_id=actor_id, actor_role=actor_role, module="osint", action="falha_coleta", target_id=investigation_id, result="erro", metadata={"connector": connector_id, "error": str(e)[:200]}, correlation_id=correlation_id)
+        raise self.retry(exc=e)
+    finally:
+        db.close()
