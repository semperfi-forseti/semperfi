+++ b/backend/app/models/audit.py
@@ -0,0 +1,35 @@
+"""Auditoria append-only com encadeamento de hashes."""
+from datetime import datetime
+from sqlalchemy import JSON, DateTime, String, func
+from sqlalchemy.orm import Mapped, mapped_column
+
+from app.database import Base
+
+
+class AuditEvent(Base):
+    """
+    Tabela append-only.
+
+    PRODUÇÃO:
+      - REVOKE UPDATE, DELETE ON audit_events FROM app_user;
+      - Trigger ON UPDATE/DELETE → raise EXCEPTION.
+      - Backup contínuo + carimbo do tempo periódico do último hash.
+    """
+    __tablename__ = "audit_events"
+
+    id: Mapped[str] = mapped_column(String(36), primary_key=True)
+    timestamp: Mapped[datetime] = mapped_column(DateTime(timezone=True), server_default=func.now(), index=True)
+    actor_id: Mapped[str] = mapped_column(String(36), index=True)
+    actor_role: Mapped[str] = mapped_column(String(50))
+
+    module: Mapped[str] = mapped_column(String(40), index=True)
+    action: Mapped[str] = mapped_column(String(80), index=True)
+    target_id: Mapped[str | None] = mapped_column(String(120), nullable=True, index=True)
+    result: Mapped[str] = mapped_column(String(30), default="sucesso")
+    correlation_id: Mapped[str] = mapped_column(String(32), index=True)
+
+    # Dados sensíveis NUNCA em claro aqui — apenas fingerprint.
+    metadata_json: Mapped[dict] = mapped_column(JSON, default=dict)
+
+    previous_hash: Mapped[str] = mapped_column(String(64))
+    current_hash: Mapped[str] = mapped_column(String(64), index=True)
