+"""
+Agente de Compliance — verifica regras LGPD / CFOAB / CNJ / interno
+sobre uma investigação e seus artefatos.
+
+Saída: lista de ComplianceFinding (persistida pelo task).
+"""
+import uuid
+from datetime import datetime, timezone
+from typing import Any
+
+from sqlalchemy import select
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from app.audit.service import AuditService
+from app.models import (
+    AgentRun, ComplianceFinding, ConnectorRun, Evidence, Investigation,
+    InvestigationScope, PolicyEvaluation,
+)
+
+
+COMPLIANCE_RULES: dict[str, dict[str, Any]] = {
+    "LGPD-001": {
+        "framework": "LGPD", "category": "base_legal",
+        "description": "Toda investigação precisa de base legal explícita (legal_basis) e avaliação de interesse legítimo registrada.",
+        "severity": "critical",
+    },
+    "LGPD-002": {
+        "framework": "LGPD", "category": "minimizacao",
+        "description": "Coleta de dados deve estar restrita ao escopo aprovado; runs fora do escopo configuram violação de minimização.",
+        "severity": "high",
+    },
+    "LGPD-003": {
+        "framework": "LGPD", "category": "retencao",
+        "description": "Retenção (retention_until) deve ser definida e proporcional ao propósito.",
+        "severity": "high",
+    },
+    "LGPD-004": {
+        "framework": "LGPD", "category": "anonimizacao",
+        "description": "Identificadores sensíveis (CPF/CNPJ) devem estar armazenados criptografados + fingerprint, nunca em claro.",
+        "severity": "critical",
+    },
+    "CFOAB-001": {
+        "framework": "CFOAB", "category": "sigilo_profissional",
+        "description": "Conteúdos cobertos por sigilo cliente-advogado não podem aparecer em relatórios sem aprovação dupla.",
+        "severity": "high",
+    },
+    "CFOAB-002": {
+        "framework": "CFOAB", "category": "conduta_etica",
+        "description": "Agentes não podem emitir conclusão de ilícito, atribuição de culpa ou diagnóstico psíquico.",
+        "severity": "critical",
+    },
+    "CNJ-001": {
+        "framework": "CNJ", "category": "cadeia_custodia",
+        "description": "Toda evidência precisa de cadeia de custódia íntegra (hash chain + Object Lock).",
+        "severity": "critical",
+    },
+    "INT-001": {
+        "framework": "interno", "category": "aprovacao",
+        "description": "Saídas de agente sem revisão humana não podem ser promovidas a FINAL.",
+        "severity": "high",
+    },
+    "INT-002": {
+        "framework": "interno", "category": "mfa_step_up",
+        "description": "Operações sensíveis sem reauth/MFA registrada são violação.",
+        "severity": "medium",
+    },
+}
+
+
+async def evaluate_investigation_compliance(
+    investigation_id: str, db: AsyncSession, *, agent_run_id: str | None = None,
+) -> list[dict[str, Any]]:
+    findings: list[dict[str, Any]] = []
+    inv: Investigation | None = await db.get(Investigation, investigation_id)
+    if not inv:
+        return [{
+            "rule_id": "INT-000", "framework": "interno", "category": "objeto_inexistente",
+            "severity": "high", "description": "Investigação não encontrada.",
+        }]
+
+    # LGPD-001
+    if not (inv.legal_basis and inv.legitimate_interest_assessment and inv.purpose):
+        findings.append({
+            "rule_id": "LGPD-001", **COMPLIANCE_RULES["LGPD-001"],
+            "suggested_action": "Preencher legal_basis, legitimate_interest_assessment e purpose antes de coletar.",
+        })
+
+    # LGPD-003
+    if not inv.retention_until:
+        findings.append({"rule_id": "LGPD-003", **COMPLIANCE_RULES["LGPD-003"],
+                         "suggested_action": "Definir retention_until proporcional ao propósito declarado."})
+
+    # LGPD-002 — runs fora do escopo
+    scope_rows = (await db.execute(
+        select(InvestigationScope.scope).where(InvestigationScope.investigation_id == inv.id)
+    )).scalars().all()
+    approved_scopes = set(scope_rows)
+    runs = (await db.execute(
+        select(ConnectorRun).where(ConnectorRun.investigation_id == inv.id)
+    )).scalars().all()
+    out_of_scope = [r for r in runs if r.scope_snapshot and not (set(r.scope_snapshot) & approved_scopes)]
+    if out_of_scope:
+        findings.append({
+            "rule_id": "LGPD-002", **COMPLIANCE_RULES["LGPD-002"],
+            "suggested_action": f"Revisar {len(out_of_scope)} runs fora do escopo aprovado.",
+            "evidence_refs": [r.id for r in out_of_scope[:10]],
+        })
+
+    # LGPD-004 — fingerprint em evidências/runs (heurístico)
+    bad_payloads = [r.id for r in runs if not r.payload_fingerprint]
+    if bad_payloads:
+        findings.append({
+            "rule_id": "LGPD-004", **COMPLIANCE_RULES["LGPD-004"],
+            "suggested_action": "Aplicar fingerprint determinístico em todos os payloads.",
+            "evidence_refs": bad_payloads[:10],
+        })
+
+    # CNJ-001 — evidências sem hash
+    evs = (await db.execute(
+        select(Evidence).where(Evidence.investigation_id == inv.id)
+    )).scalars().all()
+    missing_hash = [e.id for e in evs if not e.sha256]
+    if missing_hash:
+        findings.append({
+            "rule_id": "CNJ-001", **COMPLIANCE_RULES["CNJ-001"],
+            "suggested_action": "Reprocessar evidências sem sha256 e validar Object Lock.",
+            "evidence_refs": missing_hash[:10],
+        })
+
+    # INT-001 — agent_runs em DRAFT por > 7 dias (lock-in indevido)
+    old_drafts = (await db.execute(
+        select(AgentRun).where(AgentRun.investigation_id == inv.id, AgentRun.status == "DRAFT")
+    )).scalars().all()
+    if len(old_drafts) > 0:
+        findings.append({
+            "rule_id": "INT-001", **COMPLIANCE_RULES["INT-001"],
+            "suggested_action": f"{len(old_drafts)} agent_runs em DRAFT aguardam revisão humana.",
+            "evidence_refs": [a.id for a in old_drafts[:10]],
+        })
+
+    # INT-002 — decisões require_mfa que viraram allow sem mfa (anomalias graves)
+    bad_pol = (await db.execute(
+        select(PolicyEvaluation).where(
+            PolicyEvaluation.tenant_id == inv.tenant_id,
+            PolicyEvaluation.decision == "deny",
+        ).limit(50)
+    )).scalars().all()
+    if bad_pol:
+        findings.append({
+            "rule_id": "INT-002", **COMPLIANCE_RULES["INT-002"],
+            "severity": "low",  # informativo: apenas reflete que houve negações recentes
+            "suggested_action": f"{len(bad_pol)} negações recentes — revisar padrões de uso.",
+        })
+
+    # Audita execução do compliance
+    await AuditService(db).write(
+        action="compliance.evaluate", resource="investigation", resource_id=inv.id,
+        tenant_id=inv.tenant_id,
+        metadata={"findings_count": len(findings), "agent_run_id": agent_run_id},
+    )
+    return findings
+
+
+async def persist_findings(
+    findings: list[dict[str, Any]], *, tenant_id: str, investigation_id: str,
+    agent_run_id: str | None, db: AsyncSession,
+) -> list[str]:
+    ids: list[str] = []
+    for f in findings:
+        cf = ComplianceFinding(
+            id=str(uuid.uuid4()), tenant_id=tenant_id,
+            investigation_id=investigation_id, agent_run_id=agent_run_id,
+            rule_id=f["rule_id"], severity=f.get("severity", "info"),
+            framework=f.get("framework", "interno"), category=f.get("category", "geral"),
+            description=f.get("description", ""),
+            suggested_action=f.get("suggested_action"),
+            evidence_refs=f.get("evidence_refs", []),
+        )
+        db.add(cf)
+        ids.append(cf.id)
+    await db.flush()
+    return ids
