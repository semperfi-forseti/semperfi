@@ -0,0 +1,51 @@
+"""AuditService — sempre cria; nunca atualiza. Encadeia hash com último evento."""
+import uuid
+from datetime import datetime, timezone
+from typing import Any
+
+from sqlalchemy import select
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from app.audit.chain import GENESIS, chain_next
+from app.core.tenant import get_correlation_id
+from app.models import AuditEvent
+
+
+class AuditService:
+    def __init__(self, db: AsyncSession) -> None:
+        self.db = db
+
+    async def write(
+        self, *, action: str, resource: str, resource_id: str | None = None,
+        result: str = "sucesso", tenant_id: str | None = None,
+        actor_id: str | None = None, actor_role: str | None = None,
+        ip_masked: str | None = None, user_agent: str | None = None,
+        metadata: dict[str, Any] | None = None, correlation_id: str | None = None,
+    ) -> AuditEvent:
+        last = (await self.db.execute(
+            select(AuditEvent.current_hash).order_by(AuditEvent.timestamp.desc()).limit(1)
+        )).scalar_one_or_none()
+        previous = last or GENESIS
+        meta = metadata or {}
+        # nunca persistir PII em metadata
+        for k in ("cpf", "cnpj", "email", "phone", "password", "token", "authorization"):
+            meta.pop(k, None)
+        payload = {
+            "tenant_id": tenant_id, "actor_id": actor_id, "actor_role": actor_role,
+            "action": action, "resource": resource, "resource_id": resource_id,
+            "result": result, "metadata": meta,
+            "correlation_id": correlation_id or get_correlation_id() or "—",
+        }
+        current = chain_next(previous, payload)
+        ev = AuditEvent(
+            id=str(uuid.uuid4()),
+            timestamp=datetime.now(timezone.utc),
+            tenant_id=tenant_id, actor_id=actor_id, actor_role=actor_role,
+            action=action, resource=resource, resource_id=resource_id,
+            result=result, correlation_id=payload["correlation_id"],
+            ip_masked=ip_masked, user_agent=user_agent, metadata_json=meta,
+            previous_hash=previous, current_hash=current,
+        )
+        self.db.add(ev)
+        await self.db.flush()
+        return ev
