+"""
+Backup orquestrator.
+
+Fluxo `run_full_backup`:
+  1. pg_dump --format=custom --no-owner --no-privileges  → stream em arquivo temporário.
+  2. Calcula SHA-256 do plaintext.
+  3. Gera DEK, encripta com AES-256-GCM (AAD = backup_id||timestamp).
+  4. Envelope: DEK wrapped pela KEK ativa (KMS).
+  5. Upload S3 com Object Lock (GOVERNANCE/COMPLIANCE) + SSE.
+  6. Calcula SHA-256 do ciphertext.
+  7. Persiste BackupRun (manifesto). Audita evento.
+  8. Manifesto de evidências: lista (evidence_id, sha256, s3_key, retain_until) também
+     vai como blob criptografado anexado.
+
+Verificação `verify_backup`:
+  - Baixa cabeçalho de tamanho, recomputa sha256 ciphertext.
+  - Opcional `deep=True`: baixa total, descriptografa, compara sha256 plaintext.
+
+Restore (`restore_dry_run`):
+  - Baixa, descriptografa, escreve em arquivo temporário, mas NÃO aplica no DB.
+  - Endpoint admin para validação periódica de backup recuperável.
+"""
+from __future__ import annotations
+
+import asyncio
+import base64
+import hashlib
+import json
+import os
+import subprocess
+import tempfile
+import uuid
+from dataclasses import dataclass
+from datetime import datetime, timedelta, timezone
+from typing import Any
+
+import boto3
+from botocore.config import Config
+from sqlalchemy import select
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from app.audit.service import AuditService
+from app.core.config import get_settings
+from app.core.errors import AppError, IntegrityError
+from app.models import BackupRun, Evidence
+from app.security import keystore
+
+_CHUNK = 1024 * 1024  # 1 MiB
+
+
+def _s3_client():
+    s = get_settings()
+    return boto3.client(
+        "s3",
+        endpoint_url=s.backup_s3_endpoint or None,
+        aws_access_key_id=s.backup_s3_access_key.get_secret_value() or None,
+        aws_secret_access_key=s.backup_s3_secret_key.get_secret_value() or None,
+        region_name=s.backup_s3_region,
+        config=Config(signature_version="s3v4", retries={"max_attempts": 3, "mode": "adaptive"}),
+    )
+
+
+def _sha256_of_file(path: str) -> str:
+    h = hashlib.sha256()
+    with open(path, "rb") as f:
+        while True:
+            b = f.read(_CHUNK)
+            if not b:
+                break
+            h.update(b)
+    return h.hexdigest()
+
+
+def _pg_dump(target_path: str) -> None:
+    s = get_settings()
+    url = s.database_url
+    # asyncpg URL → libpq URL
+    libpq = url.replace("postgresql+asyncpg://", "postgresql://")
+    cmd = [
+        s.backup_pgdump_cmd, "--format=custom", "--no-owner",
+        "--no-privileges", "--file", target_path, libpq,
+    ]
+    proc = subprocess.run(cmd, capture_output=True, text=True, timeout=3600)
+    if proc.returncode != 0:
+        raise AppError(f"pg_dump falhou: {proc.stderr[:500]}", code="BACKUP_PG_DUMP_FAILED", status=500)
+
+
+async def _evidence_manifest(db: AsyncSession) -> list[dict[str, Any]]:
+    rows = (await db.execute(select(Evidence))).scalars().all()
+    return [
+        {
+            "evidence_id": e.id, "tenant_id": e.tenant_id,
+            "sha256": e.sha256, "s3_key": e.s3_key,
+            "retain_until": e.retain_until.isoformat() if e.retain_until else None,
+            "legal_hold": bool(e.legal_hold),
+            "size_bytes": e.size_bytes,
+            "mime_type": e.mime_type,
+        }
+        for e in rows
+    ]
+
+
+@dataclass
+class BackupResult:
+    backup_id: str
+    storage_key: str
+    sha256_plaintext: str
+    sha256_ciphertext: str
+    size_bytes: int
+    kek_id: str
+
+
+async def run_full_backup(db: AsyncSession) -> BackupResult:
+    s = get_settings()
+    backup_id = str(uuid.uuid4())
+    started = datetime.now(timezone.utc)
+    manifest = await _evidence_manifest(db)
+
+    with tempfile.TemporaryDirectory(prefix="sf-bk-") as tmpdir:
+        dump_path = os.path.join(tmpdir, f"{backup_id}.dump")
+        manifest_path = os.path.join(tmpdir, f"{backup_id}.manifest.json")
+        bundle_path = os.path.join(tmpdir, f"{backup_id}.bundle")
+        with open(manifest_path, "w", encoding="utf-8") as mf:
+            json.dump({
+                "backup_id": backup_id, "started_at": started.isoformat(),
+                "evidence_count": len(manifest), "evidences": manifest,
+            }, mf, separators=(",", ":"), ensure_ascii=False, sort_keys=True)
+
+        # pg_dump em thread
+        await asyncio.to_thread(_pg_dump, dump_path)
+
+        # Combina dump + manifesto em um único bundle (tar simples sem dep externa)
+        import tarfile
+        with tarfile.open(bundle_path, "w") as tf:
+            tf.add(dump_path, arcname="db.dump")
+            tf.add(manifest_path, arcname="evidence_manifest.json")
+
+        sha_plain = _sha256_of_file(bundle_path)
+        with open(bundle_path, "rb") as f:
+            plain = f.read()
+        size_bytes = len(plain)
+
+        aad = f"{backup_id}|{started.isoformat()}".encode()
+        envelope = keystore.encrypt(plain, aad=aad)
+        ciphertext = base64.b64decode(envelope.ciphertext_b64)
+        sha_ct = hashlib.sha256(ciphertext).hexdigest()
+
+        key = f"backups/{started.strftime('%Y/%m/%d')}/{backup_id}.bin"
+        retain_until = started + timedelta(days=s.backup_retention_days)
+
+        await asyncio.to_thread(_s3_put, key, ciphertext, envelope, retain_until)
+
+    br = BackupRun(
+        id=backup_id, kind="full", status="success",
+        started_at=started, finished_at=datetime.now(timezone.utc),
+        storage_bucket=s.backup_s3_bucket, storage_key=key,
+        size_bytes=size_bytes, sha256_ciphertext=sha_ct, sha256_plaintext=sha_plain,
+        dek_wrapped_b64=envelope.dek_wrapped_b64, kek_id=envelope.kek_id,
+        object_lock_until=retain_until,
+        manifest={
+            "aad_sha256": envelope.aad_sha256,
+            "nonce_b64": envelope.nonce_b64,
+            "algorithm": envelope.algorithm,
+            "evidence_count": len(manifest),
+        },
+    )
+    db.add(br)
+    await AuditService(db).write(
+        action="backup.completed", resource="backup_run", resource_id=br.id,
+        metadata={"key": key, "size": size_bytes, "kek": envelope.kek_id,
+                  "sha_plain_prefix": sha_plain[:16], "sha_ct_prefix": sha_ct[:16]},
+    )
+    await db.commit()
+    return BackupResult(
+        backup_id=backup_id, storage_key=key,
+        sha256_plaintext=sha_plain, sha256_ciphertext=sha_ct,
+        size_bytes=size_bytes, kek_id=envelope.kek_id,
+    )
+
+
+def _s3_put(key: str, ciphertext: bytes, envelope, retain_until: datetime) -> None:
+    s = get_settings()
+    client = _s3_client()
+    client.put_object(
+        Bucket=s.backup_s3_bucket, Key=key, Body=ciphertext,
+        ContentType="application/octet-stream",
+        ObjectLockMode=s.backup_object_lock_mode,
+        ObjectLockRetainUntilDate=retain_until,
+        Metadata={
+            "backup-id": key.rsplit("/", 1)[-1].rsplit(".", 1)[0],
+            "kek-id": envelope.kek_id,
+            "nonce": envelope.nonce_b64,
+            "dek-wrapped": envelope.dek_wrapped_b64,
+            "algorithm": envelope.algorithm,
+        },
+    )
+
+
+async def verify_backup(backup_id: str, db: AsyncSession, *, deep: bool = False) -> dict[str, Any]:
+    br: BackupRun | None = await db.get(BackupRun, backup_id)
+    if not br:
+        raise AppError("backup não encontrado", code="BACKUP_NOT_FOUND", status=404)
+    client = _s3_client()
+    head = await asyncio.to_thread(
+        client.head_object, Bucket=br.storage_bucket, Key=br.storage_key
+    )
+    size_ok = head["ContentLength"] == br.size_bytes
+    result: dict[str, Any] = {
+        "backup_id": br.id, "size_ok": size_ok,
+        "object_lock": head.get("ObjectLockMode"),
+        "retain_until": head.get("ObjectLockRetainUntilDate", "").isoformat()
+            if head.get("ObjectLockRetainUntilDate") else None,
+        "verified_at": datetime.now(timezone.utc).isoformat(),
+    }
+    if deep:
+        obj = await asyncio.to_thread(client.get_object, Bucket=br.storage_bucket, Key=br.storage_key)
+        ct = obj["Body"].read()
+        sha_ct_ok = hashlib.sha256(ct).hexdigest() == br.sha256_ciphertext
+        result["sha256_ciphertext_ok"] = sha_ct_ok
+        if sha_ct_ok and br.dek_wrapped_b64:
+            from app.security.keystore import EnvelopeBlob, decrypt
+            env = EnvelopeBlob(
+                ciphertext_b64=base64.b64encode(ct).decode("ascii"),
+                dek_wrapped_b64=br.dek_wrapped_b64,
+                nonce_b64=br.manifest.get("nonce_b64"),
+                kek_id=br.kek_id, algorithm=br.manifest.get("algorithm", "AES-256-GCM"),
+                aad_sha256=br.manifest.get("aad_sha256"),
+            )
+            aad = f"{br.id}|{br.started_at.isoformat()}".encode()
+            try:
+                plain = decrypt(env, aad=aad)
+                result["sha256_plaintext_ok"] = hashlib.sha256(plain).hexdigest() == br.sha256_plaintext
+            except Exception as exc:
+                result["decrypt_error"] = str(exc)[:200]
+                result["sha256_plaintext_ok"] = False
+    br.verified_at = datetime.now(timezone.utc)
+    br.status = "verified" if result.get("sha256_plaintext_ok", size_ok) else "failed"
+    await AuditService(db).write(
+        action="backup.verified", resource="backup_run", resource_id=br.id,
+        result="sucesso" if br.status == "verified" else "violacao",
+        metadata={"deep": deep, **{k: v for k, v in result.items() if k != "decrypt_error"}},
+    )
+    await db.commit()
+    if br.status != "verified":
+        raise IntegrityError(f"Backup {br.id} falhou verificação: {result}")
+    return result
+
+
+async def restore_dry_run(backup_id: str, db: AsyncSession) -> dict[str, Any]:
+    """Baixa, descriptografa, valida hash e descarta. NÃO toca no DB."""
+    br: BackupRun | None = await db.get(BackupRun, backup_id)
+    if not br:
+        raise AppError("backup não encontrado", code="BACKUP_NOT_FOUND", status=404)
+    client = _s3_client()
+    obj = await asyncio.to_thread(client.get_object, Bucket=br.storage_bucket, Key=br.storage_key)
+    ct = obj["Body"].read()
+    from app.security.keystore import EnvelopeBlob, decrypt
+    env = EnvelopeBlob(
+        ciphertext_b64=base64.b64encode(ct).decode("ascii"),
+        dek_wrapped_b64=br.dek_wrapped_b64,
+        nonce_b64=br.manifest.get("nonce_b64"),
+        kek_id=br.kek_id, algorithm=br.manifest.get("algorithm", "AES-256-GCM"),
+        aad_sha256=br.manifest.get("aad_sha256"),
+    )
+    aad = f"{br.id}|{br.started_at.isoformat()}".encode()
+    plain = decrypt(env, aad=aad)
+    sha_plain = hashlib.sha256(plain).hexdigest()
+    ok = sha_plain == br.sha256_plaintext
+    await AuditService(db).write(
+        action="backup.restore_dry_run", resource="backup_run", resource_id=br.id,
+        result="sucesso" if ok else "violacao",
+        metadata={"sha_plain_match": ok, "size": len(plain)},
+    )
+    await db.commit()
+    return {"backup_id": br.id, "sha_plain_match": ok, "size": len(plain)}
