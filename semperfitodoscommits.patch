new file mode 100644
index 0000000..6e41110
--- /dev/null
+++ b/backend/docker-compose.yml
@@ -0,0 +1,77 @@
+services:
+  postgres:
+    image: postgres:16-alpine
+    environment:
+      POSTGRES_USER: semperfi
+      POSTGRES_PASSWORD: semperfi
+      POSTGRES_DB: semperfi
+    ports: ["5432:5432"]
+    volumes: [pgdata:/var/lib/postgresql/data]
+    healthcheck:
+      test: ["CMD-SHELL", "pg_isready -U semperfi"]
+      interval: 5s
+      retries: 10
+
+  redis:
+    image: redis:7-alpine
+    ports: ["6379:6379"]
+    command: ["redis-server", "--appendonly", "yes"]
+    volumes: [redisdata:/data]
+
+  minio:
+    image: minio/minio:latest
+    command: server /data --console-address ":9001"
+    environment:
+      MINIO_ROOT_USER: semperfi
+      MINIO_ROOT_PASSWORD: semperfi-secret
+    ports:
+      - "9000:9000"
+      - "9001:9001"
+    volumes: [miniodata:/data]
+    healthcheck:
+      test: ["CMD", "curl", "-f", "http://localhost:9000/minio/health/live"]
+      interval: 5s
+      retries: 10
+
+  # Cria o bucket com Object Lock habilitado na primeira execução
+  minio-init:
+    image: minio/mc:latest
+    depends_on:
+      minio:
+        condition: service_healthy
+    entrypoint: >
+      /bin/sh -c "
+      mc alias set local http://minio:9000 semperfi semperfi-secret &&
+      mc mb --with-lock local/semperfi-evidence || true &&
+      mc retention set --default compliance 1825d local/semperfi-evidence &&
+      echo 'Bucket pronto com Object Lock COMPLIANCE 1825 dias'
+      "
+
+  app:
+    build: .
+    command: uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload
+    env_file: .env
+    ports: ["8000:8000"]
+    depends_on:
+      postgres: {condition: service_healthy}
+      redis:    {condition: service_started}
+      minio:    {condition: service_healthy}
+    volumes:
+      - ./app:/code/app
+      - ./alembic:/code/alembic
+      - ./alembic.ini:/code/alembic.ini
+
+  worker:
+    build: .
+    command: celery -A app.workers.celery_app worker -l info -Q osint
+    env_file: .env
+    depends_on:
+      postgres: {condition: service_healthy}
+      redis:    {condition: service_started}
+      minio:    {condition: service_healthy}
+    volumes: [./app:/code/app]
+
+volumes:
+  pgdata:
+  redisdata:
+  miniodata:
diff --git a/backend/keys/README.md b/backend/keys/README.md
new file mode 100644
index 0000000..7d8f2a6
--- /dev/null
+++ b/backend/keys/README.md
@@ -0,0 +1,21 @@
+# Chaves JWT
+
+O backend usa **RS256** para JWT. Gere o par antes do primeiro deploy.
+
+```bash
+mkdir -p keys
+openssl genrsa -out keys/jwt_private.pem 4096
+openssl rsa -in keys/jwt_private.pem -pubout -out keys/jwt_public.pem
+chmod 600 keys/jwt_private.pem
+```
+
+Aponte o `.env`:
+```
+JWT_PRIVATE_KEY_PATH=./keys/jwt_private.pem
+JWT_PUBLIC_KEY_PATH=./keys/jwt_public.pem
+```
+
+Em produção, NÃO armazene as chaves no repositório. Use:
+- AWS Secrets Manager / SSM Parameter Store
+- HashiCorp Vault
+- Sealed Secrets / SOPS no Kubernetes
