@@ -0,0 +1,128 @@
+name: release-staging-production
+
+on:
+  push:
+    branches: [main]
+    paths:
+      - "backend/**"
+      - "infra/docker/**"
+      - ".github/workflows/release-staging-production.yml"
+
+permissions:
+  contents: read
+
+concurrency:
+  group: release-${{ github.ref }}
+  cancel-in-progress: false
+
+jobs:
+  build:
+    uses: ./.github/workflows/reusable-build-image.yml
+    with:
+      environment: staging
+      aws_region: "{{AWS_REGION}}"
+      aws_account_id: "{{AWS_ACCOUNT_ID_STAGING}}"
+      ecr_repository_api: "semperfi-shared-api"
+      ecr_repository_worker: "semperfi-shared-worker"
+      role_name: "github-semperfi-staging-deploy"
+    permissions:
+      contents: read
+      id-token: write
+
+  deploy-staging:
+    name: Deploy staging
+    needs: build
+    runs-on: ubuntu-latest
+    timeout-minutes: 30
+    environment: staging
+    permissions:
+      contents: read
+      id-token: write
+    env:
+      AWS_REGION: "{{AWS_REGION}}"
+      ECS_CLUSTER: "semperfi-staging"
+      API_IMAGE_URI: ${{ needs.build.outputs.api_image_uri }}
+      WORKER_IMAGE_URI: ${{ needs.build.outputs.worker_image_uri }}
+    steps:
+      - uses: actions/checkout@REPLACE_WITH_VERIFIED_SHA  # v4.2.2
+        with: { persist-credentials: false }
+
+      - uses: aws-actions/configure-aws-credentials@REPLACE_WITH_VERIFIED_SHA  # v4.0.2
+        with:
+          role-to-assume: "arn:aws:iam::{{AWS_ACCOUNT_ID_STAGING}}:role/github-semperfi-staging-deploy"
+          aws-region: ${{ env.AWS_REGION }}
+          role-session-name: gha-deploy-staging-${{ github.run_id }}
+
+      - name: Verify image digest exists in ECR
+        run: bash infra/scripts/verify-image-digest.sh "${API_IMAGE_URI}" "${WORKER_IMAGE_URI}"
+
+      - name: Deploy services (by digest)
+        run: |
+          bash infra/scripts/deploy-ecs.sh "${ECS_CLUSTER}" "semperfi-staging-api"    "${API_IMAGE_URI}"
+          bash infra/scripts/deploy-ecs.sh "${ECS_CLUSTER}" "semperfi-staging-worker" "${WORKER_IMAGE_URI}"
+          bash infra/scripts/deploy-ecs.sh "${ECS_CLUSTER}" "semperfi-staging-beat"   "${WORKER_IMAGE_URI}"
+
+      - name: Wait stability
+        run: bash infra/scripts/wait-for-ecs-stable.sh "${ECS_CLUSTER}" semperfi-staging-api semperfi-staging-worker semperfi-staging-beat
+
+      - name: Smoke test staging
+        run: bash infra/scripts/smoke-test.sh "staging"
+
+      - name: Summary
+        run: |
+          {
+            echo "### Deploy staging"
+            echo "- Commit: \`${GITHUB_SHA}\`"
+            echo "- API digest: \`${API_IMAGE_URI}\`"
+            echo "- Worker digest: \`${WORKER_IMAGE_URI}\`"
+          } >> "$GITHUB_STEP_SUMMARY"
+
+  deploy-production:
+    name: Deploy production (requires manual approval)
+    needs: [build, deploy-staging]
+    runs-on: ubuntu-latest
+    timeout-minutes: 30
+    environment: production
+    permissions:
+      contents: read
+      id-token: write
+    env:
+      AWS_REGION: "{{AWS_REGION}}"
+      ECS_CLUSTER: "semperfi-production"
+      API_IMAGE_URI: ${{ needs.build.outputs.api_image_uri }}
+      WORKER_IMAGE_URI: ${{ needs.build.outputs.worker_image_uri }}
+    steps:
+      - uses: actions/checkout@REPLACE_WITH_VERIFIED_SHA  # v4.2.2
+        with: { persist-credentials: false }
+
+      - uses: aws-actions/configure-aws-credentials@REPLACE_WITH_VERIFIED_SHA  # v4.0.2
+        with:
+          role-to-assume: "arn:aws:iam::{{AWS_ACCOUNT_ID_PRODUCTION}}:role/github-semperfi-production-deploy"
+          aws-region: ${{ env.AWS_REGION }}
+          role-session-name: gha-deploy-prod-${{ github.run_id }}
+
+      - name: Verify SAME digest from staging build
+        run: bash infra/scripts/verify-image-digest.sh "${API_IMAGE_URI}" "${WORKER_IMAGE_URI}"
+
+      - name: Deploy services (by digest, identical to staging)
+        run: |
+          bash infra/scripts/deploy-ecs.sh "${ECS_CLUSTER}" "semperfi-production-api"    "${API_IMAGE_URI}"
+          bash infra/scripts/deploy-ecs.sh "${ECS_CLUSTER}" "semperfi-production-worker" "${WORKER_IMAGE_URI}"
+          bash infra/scripts/deploy-ecs.sh "${ECS_CLUSTER}" "semperfi-production-beat"   "${WORKER_IMAGE_URI}"
+
+      - name: Wait stability
+        run: bash infra/scripts/wait-for-ecs-stable.sh "${ECS_CLUSTER}" semperfi-production-api semperfi-production-worker semperfi-production-beat
+
+      - name: Smoke test production
+        run: bash infra/scripts/smoke-test.sh "production"
+
+      - name: Summary
+        run: |
+          {
+            echo "### Deploy production"
+            echo "- Commit: \`${GITHUB_SHA}\`"
+            echo "- Actor: \`${{ github.actor }}\`"
+            echo "- API digest: \`${API_IMAGE_URI}\`"
+            echo "- Worker digest: \`${WORKER_IMAGE_URI}\`"
+            echo "- Runbook de rollback: \`docs/runbooks/rollback.md\`"
+          } >> "$GITHUB_STEP_SUMMARY"
diff --git a/.github/workflows/reusable-build-image.yml b/.github/workflows/reusable-build-image.yml
new file mode 100644
index 0000000..deab4b9
--- /dev/null
+++ b/.github/workflows/reusable-build-image.yml
@@ -0,0 +1,120 @@
+name: reusable-build-image
+
+on:
+  workflow_call:
+    inputs:
+      environment:
+        type: string
+        required: true
+        description: "GitHub Environment (development|staging|production)"
+      aws_region:
+        type: string
+        required: true
+      aws_account_id:
+        type: string
+        required: true
+      ecr_repository_api:
+        type: string
+        required: true
+      ecr_repository_worker:
+        type: string
+        required: true
+      role_name:
+        type: string
+        required: true
+    outputs:
+      api_image_uri:
+        description: "Full ECR image URI for API (with digest)"
+        value: ${{ jobs.build.outputs.api_image_uri }}
+      worker_image_uri:
+        description: "Full ECR image URI for worker (with digest)"
+        value: ${{ jobs.build.outputs.worker_image_uri }}
+      api_digest:
+        value: ${{ jobs.build.outputs.api_digest }}
+      worker_digest:
+        value: ${{ jobs.build.outputs.worker_digest }}
+
+permissions:
+  contents: read
+
+jobs:
+  build:
+    name: Build + push to ECR
+    runs-on: ubuntu-latest
+    timeout-minutes: 25
+    environment: ${{ inputs.environment }}
+    permissions:
+      contents: read
+      id-token: write
+    outputs:
+      api_image_uri: ${{ steps.api.outputs.image_uri }}
+      worker_image_uri: ${{ steps.worker.outputs.image_uri }}
+      api_digest: ${{ steps.api.outputs.digest }}
+      worker_digest: ${{ steps.worker.outputs.digest }}
+    steps:
+      - uses: actions/checkout@REPLACE_WITH_VERIFIED_SHA  # v4.2.2
+        with: { persist-credentials: false }
+
+      - uses: docker/setup-buildx-action@REPLACE_WITH_VERIFIED_SHA  # v3.7.1
+
+      - name: Configure AWS credentials (OIDC)
+        uses: aws-actions/configure-aws-credentials@REPLACE_WITH_VERIFIED_SHA  # v4.0.2
+        with:
+          role-to-assume: "arn:aws:iam::${{ inputs.aws_account_id }}:role/${{ inputs.role_name }}"
+          aws-region: ${{ inputs.aws_region }}
+          role-session-name: gha-build-${{ inputs.environment }}-${{ github.run_id }}
+
+      - name: Login to ECR
+        id: ecr
+        uses: aws-actions/amazon-ecr-login@REPLACE_WITH_VERIFIED_SHA  # v2.0.1
+
+      - name: Build + push API
+        id: api
+        uses: docker/build-push-action@REPLACE_WITH_VERIFIED_SHA  # v6.9.0
+        with:
+          context: backend
+          file: backend/infra/docker/api.Dockerfile
+          push: true
+          tags: |
+            ${{ steps.ecr.outputs.registry }}/${{ inputs.ecr_repository_api }}:git-${{ github.sha }}
+            ${{ steps.ecr.outputs.registry }}/${{ inputs.ecr_repository_api }}:${{ inputs.environment }}-latest
+          cache-from: type=gha
+          cache-to: type=gha,mode=max
+          provenance: true
+          sbom: true
+
+      - name: Capture API digest
+        run: |
+          DIGEST="${{ steps.api.outputs.digest }}"
+          URI="${{ steps.ecr.outputs.registry }}/${{ inputs.ecr_repository_api }}@${DIGEST}"
+          echo "image_uri=${URI}" >> "$GITHUB_OUTPUT"
+
+      - name: Build + push worker
+        id: worker
+        uses: docker/build-push-action@REPLACE_WITH_VERIFIED_SHA  # v6.9.0
+        with:
+          context: backend
+          file: backend/infra/docker/worker.Dockerfile
+          push: true
+          tags: |
+            ${{ steps.ecr.outputs.registry }}/${{ inputs.ecr_repository_worker }}:git-${{ github.sha }}
+            ${{ steps.ecr.outputs.registry }}/${{ inputs.ecr_repository_worker }}:${{ inputs.environment }}-latest
+          cache-from: type=gha
+          cache-to: type=gha,mode=max
+          provenance: true
+          sbom: true
+
+      - name: Capture worker digest
+        run: |
+          DIGEST="${{ steps.worker.outputs.digest }}"
+          URI="${{ steps.ecr.outputs.registry }}/${{ inputs.ecr_repository_worker }}@${DIGEST}"
+          echo "image_uri=${URI}" >> "$GITHUB_OUTPUT"
+
+      - name: Summary
+        run: |
+          {
+            echo "### Imagens publicadas (${{ inputs.environment }})"
+            echo "- API: \`${{ steps.api.outputs.image_uri }}\`"
+            echo "- Worker: \`${{ steps.worker.outputs.image_uri }}\`"
+            echo "- Commit: \`${{ github.sha }}\`"
+          } >> "$GITHUB_STEP_SUMMARY"
diff --git a/.github/workflows/terraform-apply.yml b/.github/workflows/terraform-apply.yml
new file mode 100644
index 0000000..e22b50c
--- /dev/null
+++ b/.github/workflows/terraform-apply.yml
@@ -0,0 +1,78 @@
+name: terraform-apply
+
+on:
+  workflow_dispatch:
+    inputs:
+      environment:
+        description: "Target environment"
+        type: choice
+        required: true
+        options: [development, staging, production]
+  push:
+    branches: [main]
+    paths:
+      - "infra/terraform/**"
+
+permissions:
+  contents: read
+
+concurrency:
+  group: tf-apply-${{ github.event.inputs.environment || 'auto' }}
+  cancel-in-progress: false
+
+jobs:
+  apply:
+    name: Terraform apply
+    runs-on: ubuntu-latest
+    timeout-minutes: 30
+    environment: ${{ github.event.inputs.environment || 'staging' }}
+    permissions:
+      contents: read
+      id-token: write
+    env:
+      AWS_REGION: "{{AWS_REGION}}"
+      TF_IN_AUTOMATION: "true"
+      TF_INPUT: "false"
+      TARGET_ENV: ${{ github.event.inputs.environment || 'staging' }}
+    steps:
+      - uses: actions/checkout@REPLACE_WITH_VERIFIED_SHA  # v4.2.2
+        with: { persist-credentials: false }
+
+      - uses: hashicorp/setup-terraform@REPLACE_WITH_VERIFIED_SHA  # v3.1.2
+        with:
+          terraform_version: "1.9.8"
+
+      - name: Pre-flight (block production via push, force workflow_dispatch)
+        run: |
+          if [ "${TARGET_ENV}" = "production" ] && [ "${{ github.event_name }}" != "workflow_dispatch" ]; then
+            echo "::error::Production apply must use workflow_dispatch with approval"; exit 1
+          fi
+
+      - name: Configure AWS credentials (OIDC, apply role per env)
+        uses: aws-actions/configure-aws-credentials@REPLACE_WITH_VERIFIED_SHA  # v4.0.2
+        with:
+          role-to-assume: "arn:aws:iam::{{AWS_ACCOUNT_ID}}:role/github-semperfi-terraform-apply-${{ env.TARGET_ENV }}"
+          aws-region: ${{ env.AWS_REGION }}
+          role-session-name: gha-tf-apply-${{ env.TARGET_ENV }}-${{ github.run_id }}
+
+      - name: Init
+        working-directory: infra/terraform/environments/${{ env.TARGET_ENV }}
+        run: terraform init -input=false
+
+      - name: Plan
+        working-directory: infra/terraform/environments/${{ env.TARGET_ENV }}
+        run: terraform plan -input=false -no-color -out=tfplan
+
+      - name: Apply
+        working-directory: infra/terraform/environments/${{ env.TARGET_ENV }}
+        run: terraform apply -input=false -no-color -auto-approve tfplan
+
+      - name: Summary
+        if: always()
+        run: |
+          {
+            echo "### Terraform apply — ${TARGET_ENV}"
+            echo "- Commit: \`${GITHUB_SHA}\`"
+            echo "- Trigger: \`${{ github.event_name }}\`"
+            echo "- Actor: \`${{ github.actor }}\`"
+          } >> "$GITHUB_STEP_SUMMARY"
diff --git a/.github/workflows/terraform-plan.yml b/.github/workflows/terraform-plan.yml
new file mode 100644
index 0000000..730a3c9
--- /dev/null
+++ b/.github/workflows/terraform-plan.yml
@@ -0,0 +1,76 @@
+name: terraform-plan
+
+on:
+  pull_request:
+    branches: [develop, main]
+    paths:
+      - "infra/terraform/**"
+      - ".github/workflows/terraform-plan.yml"
+
+permissions:
+  contents: read
+
+concurrency:
+  group: tf-plan-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  plan:
+    name: Terraform plan (${{ matrix.env }})
+    if: github.event.pull_request.head.repo.fork == false
+    runs-on: ubuntu-latest
+    timeout-minutes: 20
+    permissions:
+      contents: read
+      id-token: write
+      pull-requests: write
+    strategy:
+      fail-fast: false
+      matrix:
+        env: [development, staging, production]
+    env:
+      AWS_REGION: "{{AWS_REGION}}"
+      TF_IN_AUTOMATION: "true"
+      TF_INPUT: "false"
+    steps:
+      - uses: actions/checkout@REPLACE_WITH_VERIFIED_SHA  # v4.2.2
+        with: { persist-credentials: false }
+
+      - uses: hashicorp/setup-terraform@REPLACE_WITH_VERIFIED_SHA  # v3.1.2
+        with:
+          terraform_version: "1.9.8"
+
+      - name: Configure AWS credentials (OIDC, read-only)
+        uses: aws-actions/configure-aws-credentials@REPLACE_WITH_VERIFIED_SHA  # v4.0.2
+        with:
+          role-to-assume: "arn:aws:iam::{{AWS_ACCOUNT_ID_${{ matrix.env | upper }}}}:role/github-semperfi-terraform-plan"
+          aws-region: ${{ env.AWS_REGION }}
+          role-session-name: gha-tf-plan-${{ matrix.env }}-${{ github.run_id }}
+
+      - name: Init
+        working-directory: infra/terraform/environments/${{ matrix.env }}
+        run: terraform init -input=false
+
+      - name: Validate
+        working-directory: infra/terraform/environments/${{ matrix.env }}
+        run: terraform validate
+
+      - name: Plan
+        id: plan
+        working-directory: infra/terraform/environments/${{ matrix.env }}
+        run: terraform plan -input=false -no-color -out=tfplan-${{ matrix.env }}
+
+      - name: Plan summary
+        if: always()
+        working-directory: infra/terraform/environments/${{ matrix.env }}
+        run: |
+          echo "### Terraform plan — ${{ matrix.env }}" >> "$GITHUB_STEP_SUMMARY"
+          terraform show -no-color tfplan-${{ matrix.env }} | head -200 >> "$GITHUB_STEP_SUMMARY" || true
+
+      - name: Upload plan artifact
+        if: success()
+        uses: actions/upload-artifact@REPLACE_WITH_VERIFIED_SHA  # v4.4.3
+        with:
+          name: tfplan-${{ matrix.env }}
+          path: infra/terraform/environments/${{ matrix.env }}/tfplan-${{ matrix.env }}
+          retention-days: 3
