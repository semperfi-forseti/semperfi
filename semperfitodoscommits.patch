@@ -0,0 +1,54 @@
+"""Despacha agente supervisionado."""
+import uuid
+from datetime import datetime, timezone
+
+from fastapi import APIRouter, Depends
+from pydantic import BaseModel
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from app.agents.registry import get_agent
+from app.api.deps import current_session, get_db
+from app.audit.service import AuditService
+from app.core.errors import PolicyDenied
+from app.db.outbox import enqueue
+from app.models import AgentRun
+from app.policies import PolicyEngine, PolicyRequest
+
+router = APIRouter(prefix="/agents", tags=["agents"])
+
+
+class AgentRunIn(BaseModel):
+    agent_id: str
+    investigation_id: str | None = None
+    input_payload: dict = {}
+    evidence_ids: list[str] = []
+
+
+@router.post("/runs", status_code=202)
+async def submit_agent_run(data: AgentRunIn, session: dict = Depends(current_session), db: AsyncSession = Depends(get_db)):
+    spec = get_agent(data.agent_id)
+    dec = await PolicyEngine(db).evaluate(PolicyRequest(
+        action="agent.run", resource="agent_run",
+        actor_id=session["user_id"], actor_role=session["role"],
+        tenant_id=session["tenant_id"], mfa_verified=session["mfa_verified"],
+        investigation_id=data.investigation_id,
+    ))
+    if not dec.allowed:
+        raise PolicyDenied(dec.reason, details={"code": dec.code})
+    run = AgentRun(
+        id=str(uuid.uuid4()), tenant_id=session["tenant_id"],
+        investigation_id=data.investigation_id, agent_id=data.agent_id,
+        model_name=spec.model_name, model_version=spec.model_version,
+        prompt_version=spec.prompt_version,
+        input_payload=data.input_payload, output_payload={},
+        evidence_ids=data.evidence_ids, status="DRAFT",
+        started_at=datetime.now(timezone.utc),
+    )
+    db.add(run)
+    await enqueue(db, task_name="app.workers.tasks.agents.run", queue="agents",
+                  tenant_id=session["tenant_id"], payload={"agent_run_id": run.id})
+    await AuditService(db).write(action="agent.submit", resource="agent_run", resource_id=run.id,
+                                 tenant_id=session["tenant_id"], actor_id=session["user_id"],
+                                 actor_role=session["role"], metadata={"agent_id": data.agent_id})
+    await db.commit()
+    return {"id": run.id, "status": "DRAFT"}
