@@ -0,0 +1,34 @@
+"""Hash chain primitiva — usada por audit_events E evidence_events."""
+import hashlib
+import json
+from typing import Any
+
+GENESIS = "0" * 64
+
+
+def sha256_hex(data: str | bytes) -> str:
+    if isinstance(data, str):
+        data = data.encode("utf-8")
+    return hashlib.sha256(data).hexdigest()
+
+
+def canonical_json(payload: dict[str, Any]) -> str:
+    return json.dumps(payload, sort_keys=True, ensure_ascii=False, separators=(",", ":"))
+
+
+def chain_next(previous_hash: str, payload: dict[str, Any]) -> str:
+    return sha256_hex((previous_hash or GENESIS) + canonical_json(payload))
+
+
+def verify_segment(events: list[dict[str, Any]]) -> tuple[bool, int | None, str]:
+    """Recomputa cada current_hash a partir do anterior. Retorna (ok, índice_quebrado, msg)."""
+    prev = GENESIS
+    for i, ev in enumerate(events):
+        payload = {k: v for k, v in ev.items() if k not in {"previous_hash", "current_hash"}}
+        if ev.get("previous_hash") != prev:
+            return False, i, f"previous_hash divergente em #{i}"
+        expected = chain_next(prev, payload)
+        if expected != ev.get("current_hash"):
+            return False, i, f"current_hash divergente em #{i}"
+        prev = ev["current_hash"]
+    return True, None, "ok"
