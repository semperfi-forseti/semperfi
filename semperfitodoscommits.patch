+"""
+Orquestrador Claude para agentes LLM.
+
+Responsabilidades:
+- Carregar config Claude do DB
+- Coletar evidências + renderizar system prompt
+- Rotear entre chamada direta, Files API, ou Batch
+- Invocar Claude com hashing de request/response
+- Persistir em claude_invocations com hash chain
+- Validação de output (reviewer agent)
+"""
+import json
+import logging
+from datetime import datetime, timezone
+from typing import Any, Optional
+
+from sqlalchemy.ext.asyncio import AsyncSession
+from sqlalchemy import select
+
+from app.integrations.claude_client import ClaudeClient
+from app.models.orchestration import (
+    ClaudeInvocation,
+    ClaudeAgentConfiguration,
+    ClaudeFileReference,
+)
+from app.models.orchestration import AgentRun
+from app.models.evidence import Evidence
+from app.core.config import get_settings
+
+logger = logging.getLogger(__name__)
+
+
+class ClaudeAgentService:
+    """Execução supervisionada de agentes Claude."""
+
+    def __init__(self, db: AsyncSession, agent_run_id: str):
+        self.db = db
+        self.agent_run_id = agent_run_id
+        self.settings = get_settings()
+        self.client = (
+            ClaudeClient(
+                api_key=self.settings.anthropic_api_key.get_secret_value(),
+                timeout=self.settings.claude_timeout_seconds,
+            )
+            if self.settings.anthropic_api_key.get_secret_value()
+            else None
+        )
+
+    async def run(self) -> dict[str, Any]:
+        """
+        Ponto de entrada: run() → load config → collect evidence → invoke Claude → persist.
+
+        Returns:
+            {
+                "status": "success" | "error",
+                "output": dict,
+                "invocation_id": str,
+                "error": str (se houver)
+            }
+        """
+        if not self.client:
+            return {"status": "error", "error": "Claude API not configured"}
+
+        try:
+            agent_run = await self.db.get(AgentRun, self.agent_run_id)
+            if not agent_run:
+                return {"status": "error", "error": f"AgentRun {self.agent_run_id} not found"}
+
+            config = await self._load_config(agent_run.agent_id, agent_run.tenant_id)
+            if not config:
+                return {
+                    "status": "error",
+                    "error": f"No Claude config for agent {agent_run.agent_id}",
+                }
+
+            # Coleta evidências
+            evidence_list = await self._fetch_evidence(
+                agent_run.evidence_ids, agent_run.investigation_id, agent_run.tenant_id
+            )
+
+            # Renderiza prompts
+            system_prompt = config.system_prompt
+            user_message_text = self._build_user_message(agent_run, evidence_list)
+
+            # Roteia: direto vs batch
+            if len(evidence_list) >= 100 and config.batch_enabled:
+                return await self._run_batch(
+                    agent_run, config, system_prompt, evidence_list
+                )
+            else:
+                return await self._run_direct(
+                    agent_run, config, system_prompt, user_message_text
+                )
+
+        except Exception as e:
+            logger.error(f"ClaudeAgentService error: {e}", exc_info=True)
+            return {"status": "error", "error": str(e)}
+
+    async def _load_config(
+        self, agent_id: str, tenant_id: str
+    ) -> Optional[ClaudeAgentConfiguration]:
+        """Carrega config do DB."""
+        stmt = select(ClaudeAgentConfiguration).where(
+            ClaudeAgentConfiguration.agent_id == agent_id,
+            ClaudeAgentConfiguration.tenant_id == tenant_id,
+        )
+        result = await self.db.execute(stmt)
+        return result.scalar_one_or_none()
+
+    async def _fetch_evidence(
+        self, evidence_ids: list[str], investigation_id: str, tenant_id: str
+    ) -> list[Evidence]:
+        """Busca evidências do S3 e verifica integridade."""
+        if not evidence_ids:
+            return []
+
+        stmt = select(Evidence).where(
+            Evidence.id.in_(evidence_ids),
+            Evidence.investigation_id == investigation_id,
+            Evidence.tenant_id == tenant_id,
+        )
+        result = await self.db.execute(stmt)
+        return result.scalars().all()
+
+    def _build_user_message(self, agent_run: AgentRun, evidence_list: list) -> str:
+        """Constrói mensagem do usuário com contexto de evidências."""
+        context_parts = [
+            f"Investigação: {agent_run.investigation_id}",
+            f"Total de evidências: {len(evidence_list)}",
+        ]
+
+        for ev in evidence_list[:10]:  # Primeiras 10 para resumo
+            context_parts.append(
+                f"- {ev.description or ev.source} (SHA256: {ev.sha256[:16]}...)"
+            )
+
+        if len(evidence_list) > 10:
+            context_parts.append(f"... e {len(evidence_list) - 10} outras evidências")
+
+        context = "\n".join(context_parts)
+
+        # Template padrão
+        return f"""Você é um revisor jurídico especializado. Analise as seguintes evidências:
+
+{context}
+
+Forneça uma avaliação detalhada considerando:
+1. Relevância para o caso
+2. Integridade (SHA-256 verificado)
+3. Riscos de compliance (LGPD, CFOAB, CNJ)
+4. Recomendações de ação
+
+Responda em JSON estruturado."""
+
+    async def _run_direct(
+        self, agent_run: AgentRun, config: ClaudeAgentConfiguration, system_prompt: str, user_message: str
+    ) -> dict[str, Any]:
+        """Chamada direta Claude (< 100 evidências)."""
+        try:
+            # Constrói request
+            messages = [{"role": "user", "content": user_message}]
+
+            request_payload = {
+                "model": config.model_id,
+                "system": system_prompt,
+                "messages": messages,
+                "max_tokens": config.max_tokens,
+                "temperature": config.temperature,
+            }
+
+            request_hash = ClaudeClient.compute_hash(request_payload)
+
+            # Invoca Claude
+            response = await self.client.send_message(
+                model=config.model_id,
+                system=system_prompt,
+                messages=messages,
+                max_tokens=config.max_tokens,
+                temperature=config.temperature,
+                structured_output=config.structured_output_schema,
+            )
+
+            # Parse output
+            output = response["content"]
+            if isinstance(output, str):
+                try:
+                    output = json.loads(output)
+                except json.JSONDecodeError:
+                    output = {"parecer": output}
+
+            output_hash = ClaudeClient.compute_hash(output)
+
+            # Persiste invocation
+            invocation = await self._persist_invocation(
+                agent_run.tenant_id,
+                request_hash,
+                output_hash,
+                response["usage"]["input_tokens"],
+                response["usage"]["output_tokens"],
+                config.model_id,
+            )
+
+            return {
+                "status": "success",
+                "output": output,
+                "invocation_id": invocation.id,
+                "tokens": response["usage"],
+            }
+
+        except Exception as e:
+            logger.error(f"Direct invoke error: {e}", exc_info=True)
+            return {"status": "error", "error": str(e)}
+
+    async def _run_batch(
+        self,
+        agent_run: AgentRun,
+        config: ClaudeAgentConfiguration,
+        system_prompt: str,
+        evidence_list: list,
+    ) -> dict[str, Any]:
+        """Batch Processing API (≥ 100 evidências)."""
+        try:
+            # TODO: Implementar compilação JSONL e submissão ao Batch API
+            logger.info(f"Batch mode for {len(evidence_list)} evidence items")
+            return {
+                "status": "pending",
+                "message": "Batch processing not yet implemented",
+            }
+        except Exception as e:
+            logger.error(f"Batch invoke error: {e}", exc_info=True)
+            return {"status": "error", "error": str(e)}
+
+    async def _persist_invocation(
+        self,
+        tenant_id: str,
+        request_hash: str,
+        output_hash: str,
+        input_tokens: int,
+        output_tokens: int,
+        model_id: str,
+    ) -> ClaudeInvocation:
+        """Persiste invocation com hash chain."""
+        # Busca hash anterior (para chain)
+        stmt = select(ClaudeInvocation).where(
+            ClaudeInvocation.tenant_id == tenant_id
+        )
+        stmt = stmt.order_by(ClaudeInvocation.created_at.desc()).limit(1)
+        result = await self.db.execute(stmt)
+        prev = result.scalar_one_or_none()
+
+        previous_hash = prev.current_hash if prev else "0" * 64
+        current_hash = ClaudeClient.compute_hash(
+            {"request": request_hash, "output": output_hash, "previous": previous_hash}
+        )
+
+        # Calcula custo (exemplo: Opus @ $15/1M tokens input, $75/1M output)
+        cost_usd = (input_tokens * 15 + output_tokens * 75) / 1_000_000
+
+        invocation = ClaudeInvocation(
+            id=self._generate_id(),
+            tenant_id=tenant_id,
+            agent_run_id=self.agent_run_id,
+            model_id=model_id,
+            request_hash=request_hash,
+            request_tokens=input_tokens,
+            response_tokens=output_tokens,
+            output_hash=output_hash,
+            cost_usd=cost_usd,
+            started_at=datetime.now(timezone.utc),
+            status="success",
+            previous_hash=previous_hash,
+            current_hash=current_hash,
+        )
+
+        self.db.add(invocation)
+        await self.db.flush()
+
+        return invocation
+
+    @staticmethod
+    def _generate_id() -> str:
+        """Gera ID único (UUID format)."""
+        from uuid import uuid4
+
+        return str(uuid4())
