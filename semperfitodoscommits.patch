+"""Loader de segredos: env (default) ou AWS Secrets Manager."""
+import json
+from functools import lru_cache
+
+import boto3
+
+from app.core.config import get_settings
+
+
+@lru_cache
+def load_secret(name: str) -> str | None:
+    s = get_settings()
+    if s.secrets_backend != "aws_secrets_manager":
+        return None
+    client = boto3.client("secretsmanager", region_name=s.evidence_s3_region)
+    resp = client.get_secret_value(SecretId=f"{s.aws_secrets_prefix.rstrip('/')}/{name}")
+    return resp.get("SecretString")
+
+
+@lru_cache
+def load_secret_json(name: str) -> dict:
+    raw = load_secret(name)
+    return json.loads(raw) if raw else {}
