+"""Conectores BrasilAPI (CNPJ, CEP, DDD, Bancos)."""
+from app.config import get_settings
+from app.connectors._http import request_json
+from app.connectors.base import BaseConnector, ConnectorResult
+from app.core.pseudonymize import normalize_doc
+
+settings = get_settings()
+
+
+class BrasilApiCNPJConnector(BaseConnector):
+    id = "brasilapi_cnpj"
+    name = "BrasilAPI — CNPJ"
+
+    async def fetch(self, payload: dict) -> ConnectorResult:
+        cnpj = normalize_doc(payload.get("target", ""))
+        if len(cnpj) != 14:
+            return ConnectorResult(status="erro", summary="CNPJ inválido", raw_data={}, source_id=self.id, source_name=self.name, error_message="CNPJ deve ter 14 dígitos", evidence_candidate=False)
+        url = f"{settings.brasilapi_base_url}/cnpj/v1/{cnpj}"
+        try:
+            data = await request_json("GET", url)
+        except Exception as e:
+            return ConnectorResult(status="erro", summary=f"Falha na consulta: {e}", raw_data={}, source_id=self.id, source_name=self.name, source_url=url, error_message=str(e), evidence_candidate=False)
+        summary = f"{data.get('razao_social','—')} — situação: {data.get('descricao_situacao_cadastral','—')}"
+        return ConnectorResult(
+            status="ok", summary=summary, raw_data=data,
+            source_id=self.id, source_name=self.name, source_url=url,
+            confidence=0.7,
+            limitations="Fonte de conveniência; para uso decisivo validar em Receita Federal.",
+        )
+
+
+class BrasilApiCEPConnector(BaseConnector):
+    id = "brasilapi_cep"
+    name = "BrasilAPI — CEP"
+
+    async def fetch(self, payload: dict) -> ConnectorResult:
+        cep = normalize_doc(payload.get("target", ""))
+        url = f"{settings.brasilapi_base_url}/cep/v2/{cep}"
+        try:
+            data = await request_json("GET", url)
+        except Exception as e:
+            return ConnectorResult(status="erro", summary=f"Falha: {e}", raw_data={}, source_id=self.id, source_name=self.name, error_message=str(e), evidence_candidate=False)
+        summary = f"{data.get('street','')} — {data.get('city','')}/{data.get('state','')}"
+        return ConnectorResult(status="ok", summary=summary, raw_data=data, source_id=self.id, source_name=self.name, source_url=url, confidence=0.9)
+
+
+class BrasilApiDDDConnector(BaseConnector):
+    id = "brasilapi_ddd"
+    name = "BrasilAPI — DDD"
+
+    async def fetch(self, payload: dict) -> ConnectorResult:
+        ddd = normalize_doc(payload.get("target", ""))
+        url = f"{settings.brasilapi_base_url}/ddd/v1/{ddd}"
+        try:
+            data = await request_json("GET", url)
+        except Exception as e:
+            return ConnectorResult(status="erro", summary=f"Falha: {e}", raw_data={}, source_id=self.id, source_name=self.name, error_message=str(e), evidence_candidate=False)
+        return ConnectorResult(status="ok", summary=f"DDD {ddd} → {data.get('state','—')}", raw_data=data, source_id=self.id, source_name=self.name, source_url=url, confidence=0.9)
+
+
+class BrasilApiBancosConnector(BaseConnector):
+    id = "brasilapi_bancos"
+    name = "BrasilAPI — Bancos"
+
+    async def fetch(self, payload: dict) -> ConnectorResult:
+        codigo = normalize_doc(payload.get("target", ""))
+        url = f"{settings.brasilapi_base_url}/banks/v1/{codigo}"
+        try:
+            data = await request_json("GET", url)
+        except Exception as e:
+            return ConnectorResult(status="erro", summary=f"Falha: {e}", raw_data={}, source_id=self.id, source_name=self.name, error_message=str(e), evidence_candidate=False)
+        return ConnectorResult(status="ok", summary=f"{data.get('name','—')} (COMPE {data.get('code','—')})", raw_data=data, source_id=self.id, source_name=self.name, source_url=url, confidence=0.95)
