+"""Round-trip de envelope encryption."""
+import base64
+
+from app.security.keystore import (
+    EnvelopeBlob, active_kek_id, decrypt, encrypt, envelope_from_json, envelope_to_json,
+    generate_dek, unwrap_dek, wrap_dek,
+)
+
+
+def test_dek_wrap_unwrap_round_trip():
+    dek = generate_dek()
+    assert len(dek) == 32
+    wrapped = wrap_dek(dek)
+    assert wrapped != dek
+    assert unwrap_dek(wrapped) == dek
+
+
+def test_envelope_round_trip_no_aad():
+    payload = b"conteudo sensivel de teste"
+    env = encrypt(payload)
+    assert env.kek_id == active_kek_id()
+    assert decrypt(env) == payload
+
+
+def test_envelope_round_trip_with_aad():
+    payload = b"backup-bundle"
+    aad = b"backup-id-1|2026-06-25T00:00:00+00:00"
+    env = encrypt(payload, aad=aad)
+    assert decrypt(env, aad=aad) == payload
+
+
+def test_envelope_rejects_aad_mismatch():
+    env = encrypt(b"x", aad=b"correct-aad")
+    try:
+        decrypt(env, aad=b"wrong-aad")
+        raise AssertionError("deveria ter falhado")
+    except Exception:
+        pass
+
+
+def test_envelope_serialization():
+    env = encrypt(b"payload")
+    s = envelope_to_json(env)
+    again = envelope_from_json(s)
+    assert again.ciphertext_b64 == env.ciphertext_b64
+    assert decrypt(again) == b"payload"
