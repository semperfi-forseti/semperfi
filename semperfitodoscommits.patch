+terraform {
+  required_version = ">= 1.6"
+  required_providers {
+    aws = { source = "hashicorp/aws", version = ">= 5.40.0" }
+  }
+
+  backend "s3" {
+    bucket       = "{{TF_STATE_BUCKET_DEVELOPMENT}}"
+    key          = "semperfi/development/terraform.tfstate"
+    region       = "{{AWS_REGION}}"
+    encrypt      = true
+    kms_key_id   = "{{TF_STATE_KMS_KEY_ID}}"
+    use_lockfile = true
+  }
+}
+
+provider "aws" {
+  region              = var.aws_region
+  allowed_account_ids = [var.aws_account_id]
+  default_tags {
+    tags = {
+      Project     = "semperfi"
+      Environment = "development"
+      ManagedBy   = "terraform"
+    }
+  }
+}
+
+variable "aws_region" { type = string }
+variable "aws_account_id" { type = string }
+variable "github_organization" { type = string, default = "pechadvoabsp-bit" }
+variable "github_repository" { type = string, default = "site-abdcrim" }
+
+module "oidc" {
