+    DEFAULT_INVESTIGATION_PIPELINE, OSINT_LIGHT_PIPELINE,
+    _ready_steps, get_pipeline, list_pipelines,
+)
+
+
+def test_list_and_get():
+    pipes = list_pipelines()
+    assert any(p["pipeline_id"] == "investigation_full" for p in pipes)
+    assert get_pipeline("osint_light").pipeline_id == "osint_light"
+
+
+def test_ready_steps_initial():
+    """No início, apenas o passo sem requisitos deve estar pronto."""
+    ready = _ready_steps(DEFAULT_INVESTIGATION_PIPELINE, history=[])
+    assert len(ready) == 1
+    assert ready[0].step_id == "coleta"
+
+
+def test_ready_after_first_step_done():
+    history = [{"step_id": "coleta", "status": "DRAFT"}]
+    ready = _ready_steps(DEFAULT_INVESTIGATION_PIPELINE, history=history)
+    assert {s.step_id for s in ready} == {"metadados"}
+
+
+def test_relatorio_unblocks_review_and_compliance():
+    history = [
+        {"step_id": s, "status": "DRAFT"} for s in
+        ("coleta", "metadados", "timeline", "correlacao", "inconsistencia", "relatorio")
+    ]
+    ready = _ready_steps(DEFAULT_INVESTIGATION_PIPELINE, history=history)
+    ids = {s.step_id for s in ready}
+    assert ids == {"revisao_juridica", "revisao_cruzada", "compliance"}
+
+
+def test_blocking_failure_stops_pipeline():
+    history = [
+        {"step_id": "coleta", "status": "DRAFT"},
+        {"step_id": "metadados", "status": "FAILED", "blocking": True},
+    ]
+    ready = _ready_steps(DEFAULT_INVESTIGATION_PIPELINE, history=history)
+    assert ready == []
+
+
+def test_unknown_pipeline_raises():
+    with pytest.raises(KeyError):
+        get_pipeline("inexistente")
