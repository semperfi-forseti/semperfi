+"""Catálogo de fontes — somente leitura para o frontend."""
+from fastapi import APIRouter, Depends
+from sqlalchemy.orm import Session
+
+from app.api.deps import db_session, current_user
+from app.models import SourceCatalog
+
+router = APIRouter(prefix="/api/osint/source-catalog", tags=["source-catalog"])
+
+
+@router.get("")
+def list_sources(db: Session = Depends(db_session), user: dict = Depends(current_user)):
+    rows = db.query(SourceCatalog).order_by(SourceCatalog.name).all()
+    return [
+        {
+            "id": s.id, "name": s.name, "category": s.category,
+            "connector_type": s.connector_type, "enabled": s.enabled,
+            "requires_token": s.requires_token, "allowed_target_types": s.allowed_target_types,
+            "legal_notes": s.legal_notes, "rate_limit": f"{s.rate_limit_per_min}/min",
+            "cache_ttl_minutes": s.cache_ttl_minutes, "confidence_weight": s.confidence_weight,
+            "terms_accepted": s.terms_accepted,
+        }
+        for s in rows
+    ]
