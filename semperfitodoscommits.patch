+import uuid
+from datetime import date
+
+from fastapi import APIRouter, Depends
+from pydantic import BaseModel, Field
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from app.api.deps import current_session, get_db
+from app.audit.service import AuditService
+from app.core.errors import PolicyDenied
+from app.models import FinancialEntry
+from app.policies import PolicyEngine, PolicyRequest
+
+router = APIRouter(prefix="/financial-entries", tags=["financial"])
+
+
+class FinIn(BaseModel):
+    date: date
+    type: str = Field(pattern=r"^(receita|despesa)$")
+    description: str
+    amount: float = Field(gt=0)
+    status: str = "previsto"
+    category: str = "honorarios"
+    client_id: str | None = None
+    process_id: str | None = None
+
+
+@router.post("", status_code=201)
+async def create_entry(data: FinIn, session: dict = Depends(current_session), db: AsyncSession = Depends(get_db)):
+    dec = await PolicyEngine(db).evaluate(PolicyRequest(
+        action="financial.create", resource="financial_entry",
+        actor_id=session["user_id"], actor_role=session["role"], tenant_id=session["tenant_id"],
+        mfa_verified=session["mfa_verified"],
+    ))
+    if not dec.allowed:
+        raise PolicyDenied(dec.reason, details={"code": dec.code})
+    e = FinancialEntry(id=str(uuid.uuid4()), tenant_id=session["tenant_id"], **data.model_dump())
+    db.add(e)
