index 0000000..b886f87
--- /dev/null
+++ b/backend/app/api/v1/auth.py
@@ -0,0 +1,86 @@
+"""Autenticação: sessão local + OIDC + MFA + reauth step-up."""
+import uuid
+
+from fastapi import APIRouter, Depends, Response, status
+from pydantic import BaseModel, EmailStr
+from sqlalchemy import select
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from app.api.deps import current_session, get_db, request_ip_masked
+from app.audit.service import AuditService
+from app.core.config import get_settings
+from app.core.errors import Unauthorized
+from app.models import User
+from app.security.headers import issue_csrf_cookie
+from app.security.mfa import verify_totp
+from app.security.session import make_session_token, mark_reauth, revoke_session, store_session
+from passlib.context import CryptContext
+
+router = APIRouter(prefix="/auth", tags=["auth"])
+_pw = CryptContext(schemes=["bcrypt"], deprecated="auto")
+
+
+class LoginRequest(BaseModel):
+    email: EmailStr
+    password: str
+
+
+class MFAVerifyRequest(BaseModel):
+    code: str
+    purpose: str = "session"  # 'session' | 'reauth'
+
+
+@router.post("/session", status_code=200)
+async def login(data: LoginRequest, response: Response, db: AsyncSession = Depends(get_db)):
+    s = get_settings()
+    if not s.local_auth_enabled:
+        raise Unauthorized("Login local desabilitado — use OIDC.")
+    user = (await db.execute(select(User).where(User.email == data.email, User.is_active.is_(True)))).scalar_one_or_none()
+    if not user or not user.password_hash or not _pw.verify(data.password, user.password_hash):
+        raise Unauthorized("Credenciais inválidas.")
+    token, jti = make_session_token(user_id=user.id, tenant_id=user.tenant_id, role=user.role,
+                                    mfa_verified=False, reauth_at=None)
+    await store_session(jti, user_id=user.id, tenant_id=user.tenant_id, role=user.role,
+                        mfa_verified=False, reauth_at=None)
+    response.set_cookie(
+        key=s.session_cookie_name, value=token, max_age=s.session_max_age_seconds,
+        httponly=True, secure=s.session_cookie_secure, samesite=s.session_cookie_samesite,
+        domain=s.session_cookie_domain or None,
+    )
+    issue_csrf_cookie(response)
+    await AuditService(db).write(action="auth.login", resource="user", resource_id=user.id,
+                                 tenant_id=user.tenant_id, actor_id=user.id, actor_role=user.role,
+                                 metadata={"method": "local"})
+    await db.commit()
+    mfa_required = user.role in s.mfa_required_roles_set
+    return {"mfa_required": mfa_required, "mfa_enabled": user.mfa_enabled}
+
+
+@router.post("/mfa/verify")
+async def mfa_verify(data: MFAVerifyRequest, session: dict = Depends(current_session),
+                     db: AsyncSession = Depends(get_db)):
+    user = await db.get(User, session["user_id"])
+    if not user or not user.mfa_secret:
+        raise Unauthorized("MFA não configurado.")
+    if not verify_totp(user.mfa_secret, data.code):
+        raise Unauthorized("Código inválido.")
+    if data.purpose == "reauth":
+        await mark_reauth(session["jti"])
+    else:
+        # promove sessão a mfa_verified
+        from app.security.session import _r
+        await _r().hset(f"sess:{session['jti']}", "mfa", 1)
+    await AuditService(db).write(action=f"auth.mfa.{data.purpose}", resource="user",
+                                 resource_id=user.id, tenant_id=user.tenant_id, actor_id=user.id,
+                                 actor_role=user.role)
+    await db.commit()
+    return {"ok": True}
+
+
+@router.post("/logout", status_code=status.HTTP_204_NO_CONTENT)
+async def logout(response: Response, session: dict = Depends(current_session)):
+    await revoke_session(session["jti"])
+    s = get_settings()
+    response.delete_cookie(s.session_cookie_name, domain=s.session_cookie_domain or None)
+    response.delete_cookie(s.csrf_cookie_name)
+    return Response(status_code=204)
