+"""
+Cliente assíncrono para Claude API (Anthropic SDK wrapper).
+
+Responsabilidades:
+- Chamadas com rate limiting (Tenacity exponential backoff)
+- Rastreamento de tokens e custo
+- Hashing de request/response (audit chain)
+- Upload de arquivos (Files API)
+- Batch Processing API
+"""
+import json
+import hashlib
+from typing import Any, Optional
+import logging
+
+from anthropic import AsyncAnthropic, Anthropic
+from tenacity import (
+    AsyncRetrying,
+    retry_if_exception_type,
+    stop_after_attempt,
+    wait_exponential,
+)
+
+logger = logging.getLogger(__name__)
+
+
+class ClaudeClient:
+    """Wrapper assíncrono para Anthropic SDK com rate limiting e audit trail."""
+
+    def __init__(self, api_key: str, timeout: int = 300):
+        self.api_key = api_key
+        self.timeout = timeout
+        self.async_client = AsyncAnthropic(api_key=api_key, timeout=timeout)
+        self.sync_client = Anthropic(api_key=api_key, timeout=timeout)
+
+    async def send_message(
+        self,
+        model: str,
+        system: str,
+        messages: list[dict],
+        max_tokens: int = 8192,
+        temperature: float = 0.3,
+        structured_output: dict | None = None,
+    ) -> dict:
+        """
+        Invoca Claude com Structured Output opcional.
+
+        Args:
+            model: Ex: "claude-opus-4-1"
+            system: System prompt
+            messages: Lista de mensagens {role, content}
+            max_tokens: Limite de tokens da resposta
+            temperature: Controle de criatividade (0.0-1.0)
+            structured_output: JSON Schema para modo structured output
+
+        Returns:
+            Dict com: {
+                "content": response text,
+                "model": model usado,
+                "usage": {"input_tokens": int, "output_tokens": int, "cache_creation_input_tokens": int, "cache_read_input_tokens": int},
+                "stop_reason": "end_turn" | "max_tokens" | "tool_use" | ...,
+                "raw_response": response object
+            }
+        """
+        kwargs = {
+            "model": model,
+            "max_tokens": max_tokens,
+            "temperature": temperature,
+            "system": system,
+            "messages": messages,
+        }
+
+        if structured_output:
+            kwargs["temperature"] = 0  # Determinístico para structured output
+            kwargs["thinking"] = {  # Opcional: ativa extended thinking se suportado
+                "type": "enabled",
+                "budget_tokens": 5000,  # Ajustar conforme necessário
+            }
+        else:
+            # Modo normal
+            kwargs["thinking"] = None
+
+        try:
+            async for attempt in AsyncRetrying(
+                retry=retry_if_exception_type(Exception),
+                stop=stop_after_attempt(3),
+                wait=wait_exponential(multiplier=1, min=2, max=10),
+            ):
+                with attempt:
+                    response = await self.async_client.messages.create(**kwargs)
+
+            # Extrai conteúdo
+            if structured_output and response.content:
+                # Esperado: JSON no primeiro bloco de conteúdo
+                text_content = next(
+                    (c.text for c in response.content if hasattr(c, "text")),
+                    None,
+                )
+                if text_content:
+                    content = json.loads(text_content)
+                else:
+                    content = {"error": "No JSON content in response"}
+            else:
+                content = "".join(
+                    c.text for c in response.content if hasattr(c, "text")
+                )
+
+            return {
+                "content": content,
+                "model": model,
+                "usage": {
+                    "input_tokens": response.usage.input_tokens,
+                    "output_tokens": response.usage.output_tokens,
+                    "cache_creation_input_tokens": getattr(
+                        response.usage, "cache_creation_input_tokens", 0
+                    ),
+                    "cache_read_input_tokens": getattr(
+                        response.usage, "cache_read_input_tokens", 0
+                    ),
+                },
+                "stop_reason": response.stop_reason,
+                "raw_response": response,
+            }
+        except Exception as e:
+            logger.error(f"Claude API error: {e}", exc_info=True)
+            raise
+
+    async def upload_file(
+        self, data: bytes, mime_type: str
+    ) -> dict[str, Any]:
+        """
+        Upload arquivo para Claude Files API.
+
+        Args:
+            data: Bytes do arquivo
+            mime_type: Ex: "application/pdf", "image/png"
+
+        Returns:
+            Dict com:
+            {
+                "file_id": str,
+                "size_bytes": int,
+                "mime_type": str,
+                "expires_at": timestamp
+            }
+        """
+        try:
+            # Upload via sync client (Files API pode não ter async wrapper)
+            from io import BytesIO
+
+            file_obj = BytesIO(data)
+            response = self.sync_client.beta.files.upload(
+                file=(f"file_{hashlib.md5(data).hexdigest()}", file_obj, mime_type),
+                betas=["files-api-2025-04-14"],
+            )
+
+            return {
+                "file_id": response.id,
+                "size_bytes": len(data),
+                "mime_type": mime_type,
+                "expires_at": getattr(response, "expires_at", None),
+            }
+        except Exception as e:
+            logger.error(f"File upload error: {e}", exc_info=True)
+            raise
+
+    async def submit_batch(
+        self, requests: list[dict], output_s3_path: Optional[str] = None
+    ) -> dict[str, Any]:
+        """
+        Submete job ao Batch Processing API.
+
+        Args:
+            requests: Lista de requisições formatadas para Batch
+            output_s3_path: S3 path para resultado (opcional)
+
+        Returns:
+            Dict com: {"batch_id": str, "status": str}
+        """
+        try:
+            # Batch API retorna job ID
+            response = self.sync_client.beta.batch.processing.batches.create(
+                requests=requests,
+                betas=["batch-2025-04-14"],
+            )
+
+            return {
+                "batch_id": response.id,
+                "status": response.processing_status,
+            }
+        except Exception as e:
+            logger.error(f"Batch submission error: {e}", exc_info=True)
+            raise
+
+    async def get_batch_status(self, batch_id: str) -> dict[str, Any]:
+        """
+        Verifica status de job Batch.
+
+        Returns:
+            Dict com: {
+                "batch_id": str,
+                "status": "queued" | "processing" | "succeeded" | "failed",
+                "result_file_url": str (se completed),
+                "error_message": str (se failed)
+            }
+        """
+        try:
+            response = self.sync_client.beta.batch.processing.batches.retrieve(
+                batch_id, betas=["batch-2025-04-14"]
+            )
+
+            result = {
+                "batch_id": batch_id,
+                "status": response.processing_status,
+            }
+
+            if hasattr(response, "result_file") and response.result_file:
+                result["result_file_url"] = response.result_file.url
+
+            if hasattr(response, "errors") and response.errors:
+                result["error_message"] = response.errors[0].message
+
+            return result
+        except Exception as e:
+            logger.error(f"Batch status check error: {e}", exc_info=True)
+            raise
+
+    @staticmethod
+    def compute_hash(obj: Any) -> str:
+        """SHA-256 hash de um objeto JSON canonicalizado."""
+        canonical = json.dumps(obj, sort_keys=True, separators=(",", ":"))
+        return hashlib.sha256(canonical.encode()).hexdigest()
