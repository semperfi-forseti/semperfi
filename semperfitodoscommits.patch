+++ b/infra/scripts/smoke-test.sh
@@ -0,0 +1,21 @@
+#!/usr/bin/env bash
+# Uso: smoke-test.sh <development|staging|production>
+set -euo pipefail
+
+ENV="${1:?environment requerido}"
+
+case "${ENV}" in
+  development) URL="${SMOKE_URL:-https://api-dev.semperfi.example.com}" ;;
+  staging)     URL="${SMOKE_URL:-https://api-staging.semperfi.example.com}" ;;
+  production)  URL="${SMOKE_URL:-https://api.semperfi.example.com}" ;;
+  *) echo "::error::env inválido: ${ENV}"; exit 2 ;;
+esac
+
+echo "==> Smoke test ${ENV}: ${URL}"
+curl -fsS --max-time 10 "${URL}/health" > /tmp/health.json
+cat /tmp/health.json
+echo
+curl -fsS --max-time 10 "${URL}/v1/me" -o /dev/null -w "%{http_code}\n" | grep -E '^(401|200)$' >/dev/null || {
+  echo "::error::endpoint /v1/me não respondeu 401/200"; exit 1
+}
+echo "==> Smoke OK"
diff --git a/infra/scripts/verify-image-digest.sh b/infra/scripts/verify-image-digest.sh
new file mode 100755
index 0000000..6aa0153
--- /dev/null
+++ b/infra/scripts/verify-image-digest.sh
@@ -0,0 +1,17 @@
+#!/usr/bin/env bash
+# Garante que cada image URI contém um digest @sha256:... e existe no ECR.
+# Uso: verify-image-digest.sh <image_uri> [<image_uri> ...]
+set -euo pipefail
+
+for URI in "$@"; do
+  if [[ "${URI}" != *"@sha256:"* ]]; then
+    echo "::error::URI sem digest imutável: ${URI}"; exit 1
+  fi
+  REPO=$(echo "${URI}" | sed -E 's|^[^/]+/([^@]+)@sha256:.*$|\1|')
+  DIGEST=$(echo "${URI}" | sed -E 's|^.*@(sha256:[a-f0-9]+).*$|\1|')
+  aws ecr describe-images \
+    --repository-name "${REPO}" \
+    --image-ids imageDigest="${DIGEST}" \
+    --query 'imageDetails[0].imageDigest' --output text >/dev/null
+  echo "==> OK: ${URI}"
+done
