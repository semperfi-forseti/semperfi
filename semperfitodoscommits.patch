+"""
+DataJud (CNJ) — metadados processuais públicos.
+
+Endpoint público: https://api-publica.datajud.cnj.jus.br/api_publica_<tribunal>/_search
+Cabeçalho: `Authorization: APIKey <KEY>` (chave pública divulgada pelo CNJ
+para o ambiente público; conferir na documentação atual).
+
+Documentação: https://datajud-wiki.cnj.jus.br/api-publica/
+"""
+import httpx
+
+from app.config import get_settings
+from app.connectors._http import DEFAULT_TIMEOUT, USER_AGENT
+from app.connectors.base import BaseConnector, ConnectorResult
+
+settings = get_settings()
+
+
+class DataJudConnector(BaseConnector):
+    id = "datajud_cnj"
+    name = "DataJud — Metadados Processuais"
+
+    async def fetch(self, payload: dict) -> ConnectorResult:
+        if not settings.datajud_api_key:
+            return ConnectorResult(status="bloqueado", summary="DATAJUD_API_KEY não configurado", raw_data={}, source_id=self.id, source_name=self.name, error_message="missing key", evidence_candidate=False)
+
+        tribunal = payload.get("tribunal", "tjsp")  # ex: tjsp, trf2, stj, ...
+        url = f"{settings.datajud_base_url}/api_publica_{tribunal}/_search"
+        # Busca por número de processo (limpo) ou por classe/órgão.
+        numero = (payload.get("numero_processo") or "").replace("-", "").replace(".", "")
+        query: dict
+        if numero:
+            query = {"query": {"match": {"numeroProcesso": numero}}, "size": 10}
+        else:
+            query = {"query": {"match_all": {}}, "size": payload.get("size", 5)}
+
+        headers = {
+            "User-Agent": USER_AGENT,
+            "Authorization": f"APIKey {settings.datajud_api_key}",
+            "Content-Type": "application/json",
+        }
+        try:
+            async with httpx.AsyncClient(timeout=DEFAULT_TIMEOUT) as cli:
+                r = await cli.post(url, headers=headers, json=query)
+                r.raise_for_status()
+                data = r.json()
+        except Exception as e:
+            return ConnectorResult(status="erro", summary=f"Falha: {e}", raw_data={}, source_id=self.id, source_name=self.name, source_url=url, error_message=str(e), evidence_candidate=False)
+
+        hits = data.get("hits", {}).get("hits", [])
+        # Retorna apenas metadados (nada de partes/sigilo).
+        metadados = [
+            {
+                "numero": h["_source"].get("numeroProcesso"),
+                "tribunal": h["_source"].get("tribunal"),
+                "classe": h["_source"].get("classe", {}).get("nome"),
+                "orgao": h["_source"].get("orgaoJulgador", {}).get("nome"),
+                "data_ajuizamento": h["_source"].get("dataAjuizamento"),
+            }
+            for h in hits
+        ]
+        summary = f"DataJud — {len(hits)} resultado(s) (apenas metadados)"
+        return ConnectorResult(
+            status="ok" if hits else "sem_resultado",
+            summary=summary,
+            raw_data={"total": len(hits), "metadados": metadados},
+            source_id=self.id, source_name=self.name, source_url=url,
+            confidence=0.9,
+            limitations="Apenas metadados públicos. Processos em sigilo são omitidos. Não inclui dados de partes ou conteúdo de petições.",
+        )
