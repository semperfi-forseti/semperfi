+"""Dependências comuns de API: sessão DB, usuário autenticado, contexto."""
+import uuid
 
-from fastapi import Depends, Header, HTTPException, status
+from fastapi import Cookie, Depends, Request
 
-from app.core.rbac import has_permission
-from app.core.security import decode_token
-from app.database import SessionLocal
+from app.core.config import get_settings
+from app.core.errors import RequireMFA, RequireReauth, Unauthorized
+from app.core.tenant import set_request_context
+from app.db.base import get_db
+from app.security.session import load_session_from_cookie, reauth_is_fresh
+from app.security.crypto import mask_ip
 
 
-def db_session():
-    db = SessionLocal()
-    try:
-        yield db
-    finally:
-        db.close()
+async def current_session(request: Request,
+                          session_cookie: str | None = Cookie(default=None, alias=None)) -> dict:
+    s = get_settings()
+    raw = request.cookies.get(s.session_cookie_name)
+    if not raw:
+        raise Unauthorized("Sessão ausente.")
+    data = await load_session_from_cookie(raw)
+    if not data:
+        raise Unauthorized("Sessão inválida.")
+    correlation_id = request.headers.get("x-correlation-id") or uuid.uuid4().hex[:16]
+    set_request_context(
+        tenant_id=data["tenant_id"], actor_id=data["user_id"],
+        role=data["role"], correlation_id=correlation_id,
+    )
+    return data
 
 
-def current_user(authorization: str = Header(default="")):
