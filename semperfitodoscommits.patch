+  (DB.addons||[]).forEach(a=>{
+    const def = ADDONS.find(x=>x.key===a.key);
+    if (def && def.target in limits && typeof limits[def.target]==='number'){
+      limits[def.target] += def.unit * (a.qty||1);
+    }
+  });
+  return {plan, limits};
