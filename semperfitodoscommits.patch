+"""Pseudonimização: máscara + fingerprint determinístico."""
+from app.security.crypto import fingerprint, mask_doc, mask_ip, normalize_doc
+
+
+def test_normalize_strips():
+    assert normalize_doc("12.345.678/0001-90") == "12345678000190"
+
+
+def test_mask_keeps_edges():
+    assert mask_doc("12345678900") == "12*******00"
+
+
+def test_fingerprint_deterministic():
+    a = fingerprint("123.456.789-00")
+    b = fingerprint("12345678900")
+    assert a == b and len(a) == 12
+
+
+def test_fingerprint_differs():
+    assert fingerprint("11111111111") != fingerprint("22222222222")
+
