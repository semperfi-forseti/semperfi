new file mode 100644
index 0000000..c075962
--- /dev/null
+++ b/backend/app/services/evidence_vault.py
@@ -0,0 +1,104 @@
+"""
+Cofre de evidências em S3 com Object Lock (modo COMPLIANCE).
+
+- Cada upload é PUT com retenção até `retention_until`.
+- Modo COMPLIANCE: nem o root da AWS consegue apagar antes do prazo.
+- Chave (key) é deterministicamente derivada do hash + investigação.
+- Server-side encryption (SSE-S3 ou SSE-KMS) sempre habilitado.
+
+Em produção, considerar versionamento + replicação cross-region.
+"""
+from dataclasses import dataclass
+from datetime import datetime
+from io import BytesIO
+
+import boto3
+from botocore.config import Config
+from botocore.exceptions import ClientError
+
+from app.config import get_settings
+from app.services.hash_chain import sha256_hex
+
+settings = get_settings()
+
+_s3 = boto3.client(
+    "s3",
+    endpoint_url=settings.evidence_s3_endpoint or None,
+    aws_access_key_id=settings.evidence_s3_access_key,
+    aws_secret_access_key=settings.evidence_s3_secret_key,
+    region_name=settings.evidence_s3_region,
+    config=Config(signature_version="s3v4", retries={"max_attempts": 3, "mode": "adaptive"}),
+)
+
+
+@dataclass(frozen=True)
+class StoredObject:
+    bucket: str
+    key: str
+    sha256: str
+    size: int
+    version_id: str | None
+    retain_until: datetime
+
+
+def _key_for(investigation_id: str, sha256: str, suffix: str = "raw") -> str:
+    # Prefixo por investigação facilita lifecycle + listagem.
+    return f"investigations/{investigation_id}/evidence/{sha256[:2]}/{sha256}.{suffix}"
+
+
+def store_evidence(
+    *,
+    investigation_id: str,
+    content: bytes,
+    retain_until: datetime,
+    content_type: str = "application/octet-stream",
+    suffix: str = "raw",
+    metadata: dict | None = None,
+) -> StoredObject:
+    """Sobe o conteúdo com Object Lock até `retain_until`."""
+    sha = sha256_hex(content)
+    key = _key_for(investigation_id, sha, suffix)
+    bucket = settings.evidence_s3_bucket
+
+    extra = {
+        "ContentType": content_type,
+        "ServerSideEncryption": "AES256",
+        "ObjectLockMode": settings.evidence_s3_object_lock_mode,
+        "ObjectLockRetainUntilDate": retain_until,
+        "Metadata": {
+            "investigation-id": investigation_id,
+            "sha256": sha,
+            **{k: str(v) for k, v in (metadata or {}).items()},
+        },
+    }
+    try:
+        resp = _s3.put_object(Bucket=bucket, Key=key, Body=BytesIO(content), **extra)
+    except ClientError as e:
+        raise RuntimeError(f"Falha S3 ({e.response['Error']['Code']}): {e}") from e
+
+    return StoredObject(
+        bucket=bucket, key=key, sha256=sha, size=len(content),
+        version_id=resp.get("VersionId"), retain_until=retain_until,
+    )
+
+
+def get_object(key: str) -> bytes:
+    obj = _s3.get_object(Bucket=settings.evidence_s3_bucket, Key=key)
+    return obj["Body"].read()
+
+
+def head_object(key: str) -> dict:
+    return _s3.head_object(Bucket=settings.evidence_s3_bucket, Key=key)
+
+
+def presigned_url(key: str, expires_seconds: int = 300) -> str:
+    return _s3.generate_presigned_url(
+        "get_object",
+        Params={"Bucket": settings.evidence_s3_bucket, "Key": key},
+        ExpiresIn=expires_seconds,
+    )
+
+
+def verify_integrity(key: str, expected_sha256: str) -> bool:
+    """Baixa, recalcula SHA-256 e compara — único modo de provar que o objeto não foi corrompido."""
+    return sha256_hex(get_object(key)) == expected_sha256
diff --git a/backend/app/services/hash_chain.py b/backend/app/services/hash_chain.py
new file mode 100644
index 0000000..4da9ccb
--- /dev/null
+++ b/backend/app/services/hash_chain.py
@@ -0,0 +1,30 @@
+"""Cadeia de hashes para auditoria e eventos de evidência."""
+import hashlib
+import json
+from typing import Any
+
+GENESIS = "0" * 64
+
+
+def sha256_hex(s: str | bytes) -> str:
+    if isinstance(s, str):
+        s = s.encode("utf-8")
+    return hashlib.sha256(s).hexdigest()
+
+
+def chain_next(previous_hash: str, payload: dict[str, Any]) -> str:
+    """current_hash = SHA256(previous_hash || canonical_json(payload))."""
+    canonical = json.dumps(payload, sort_keys=True, ensure_ascii=False, separators=(",", ":"))
+    return sha256_hex((previous_hash or GENESIS) + canonical)
+
+
+def verify_chain(events: list[dict]) -> tuple[bool, int | None]:
+    """Valida cadeia inteira. Retorna (ok, índice_da_quebra_se_houver)."""
+    prev = GENESIS
+    for i, ev in enumerate(events):
+        payload = {k: v for k, v in ev.items() if k not in {"previous_hash", "current_hash"}}
+        expected = chain_next(prev, payload)
+        if expected != ev["current_hash"]:
+            return False, i
+        prev = ev["current_hash"]
+    return True, None
diff --git a/backend/app/services/policy_engine.py b/backend/app/services/policy_engine.py
new file mode 100644
index 0000000..36779ba
--- /dev/null
+++ b/backend/app/services/policy_engine.py
@@ -0,0 +1,78 @@
+"""
+Motor de políticas OSINT.
+
+Antes de qualquer coleta, valida:
+  1. Investigação existe e está em status executável.
+  2. Declaração de finalidade legítima foi feita (refletida em status != rascunho).
+  3. Fonte está homologada, ativa e dentro do escopo aprovado.
+  4. Tipo de entidade-alvo é compatível com a fonte.
+  5. Ação não cai em uma das vedações absolutas.
+  6. Rate limit local não foi excedido.
+
+Decisão devolve um PolicyDecision com motivo. Coletas bloqueadas
+geram evento auditado `acao_bloqueada_por_escopo`.
+"""
+from dataclasses import dataclass
+
+from sqlalchemy.orm import Session
+
+from app.models import Investigation, OsintEntity, SourceCatalog
+
+# Práticas vedadas em qualquer cenário.
+FORBIDDEN_KEYWORDS = {
+    "captcha_bypass", "scraping_login", "vazamento", "credenciais",
+    "senhas", "cookies_de_terceiros", "localizacao_tempo_real",
+    "reconhecimento_facial", "perfil_psicologico", "previsao_criminal",
+    "coleta_massiva_pessoal", "dados_obtidos_ilicitamente",
+}
+
+
+@dataclass(frozen=True)
+class PolicyDecision:
+    allowed: bool
+    reason: str
+    audit_action: str  # 'execucao_coleta' (allowed) ou 'acao_bloqueada_por_escopo' (denied)
+
+
+def evaluate_run(
+    db: Session,
+    *,
+    investigation_id: str,
+    connector_id: str,
+    target_entity_id: str | None,
+    requested_action_tags: set[str] | None = None,
+) -> PolicyDecision:
+    inv = db.get(Investigation, investigation_id)
+    if inv is None:
+        return PolicyDecision(False, "Investigação não encontrada", "acao_bloqueada_por_escopo")
+
+    if inv.status in {"rascunho", "aguardando_aprovacao"}:
+        return PolicyDecision(False, f"Investigação está em '{inv.status}' — sem declaração aprovada", "acao_bloqueada_por_escopo")
+    if inv.status in {"concluida", "arquivada", "bloqueada"}:
+        return PolicyDecision(False, f"Investigação está '{inv.status}' (somente leitura)", "acao_bloqueada_por_escopo")
+
+    source = db.get(SourceCatalog, connector_id)
+    if source is None:
+        return PolicyDecision(False, f"Conector '{connector_id}' não cadastrado", "acao_bloqueada_por_escopo")
+    if not source.enabled:
+        return PolicyDecision(False, f"Conector '{source.name}' desativado", "acao_bloqueada_por_escopo")
+    if not source.terms_accepted:
+        return PolicyDecision(False, f"Termos de uso da fonte '{source.name}' não aceitos", "acao_bloqueada_por_escopo")
+
+    if source.category not in inv.scope:
+        return PolicyDecision(False, f"Categoria '{source.category}' fora do escopo aprovado {inv.scope}", "acao_bloqueada_por_escopo")
+
+    if target_entity_id:
+        entity = db.get(OsintEntity, target_entity_id)
+        if entity is None:
+            return PolicyDecision(False, "Entidade-alvo não encontrada", "acao_bloqueada_por_escopo")
+        if entity.investigation_id != investigation_id:
+            return PolicyDecision(False, "Entidade não pertence a esta investigação", "acao_bloqueada_por_escopo")
+        if entity.entity_type not in source.allowed_target_types:
+            return PolicyDecision(False, f"Tipo '{entity.entity_type}' não permitido pela fonte '{source.name}'", "acao_bloqueada_por_escopo")
+
+    if requested_action_tags and (FORBIDDEN_KEYWORDS & requested_action_tags):
+        violated = FORBIDDEN_KEYWORDS & requested_action_tags
+        return PolicyDecision(False, f"Ação contém prática vedada: {violated}", "acao_bloqueada_por_escopo")
+
+    return PolicyDecision(True, "OK", "execucao_coleta")
