+++ b/backend/app/core/config.py
@@ -0,0 +1,121 @@
+"""
+Configuração centralizada.
+
+Em produção, SECRETS_BACKEND=aws_secrets_manager carrega segredos do AWS Secrets Manager
+ao iniciar a aplicação (ver app/integrations/secrets.py). Em dev, env vars do .env.
+"""
+from functools import lru_cache
+from typing import Literal
+
+from pydantic import Field, SecretStr
+from pydantic_settings import BaseSettings, SettingsConfigDict
+
+
+class Settings(BaseSettings):
+    model_config = SettingsConfigDict(env_file=".env", env_file_encoding="utf-8", extra="ignore")
+
+    # App
+    app_env: Literal["development", "staging", "production"] = "development"
+    app_name: str = "semperfi-backend"
+    app_version: str = "2.0.0"
+    log_level: str = "INFO"
+
+    # Sessão / CSRF
+    session_secret: SecretStr = SecretStr("change-me")
+    session_cookie_name: str = "sf_session"
+    session_cookie_domain: str = ""
+    session_cookie_secure: bool = False
+    session_cookie_samesite: Literal["lax", "strict", "none"] = "lax"
+    session_max_age_seconds: int = 28800
+    csrf_secret: SecretStr = SecretStr("change-me")
+    csrf_cookie_name: str = "sf_csrf"
+    cors_allowed_origins: str = "http://localhost:3000"
+    reauth_ttl_seconds: int = 300
+
+    # Pseudonimização / cripto de coluna
+    pseudonymization_salt: SecretStr = SecretStr("change-me")
+    fernet_keys: str = ""  # CSV; primeira é a ativa, demais para descriptografia legada
+
+    # OIDC
+    oidc_enabled: bool = False
+    oidc_issuer: str = ""
+    oidc_client_id: str = ""
+    oidc_client_secret: SecretStr = SecretStr("")
+    oidc_redirect_uri: str = ""
+    oidc_audience: str = "semperfi"
+    local_auth_enabled: bool = True
+
+    # MFA
+    mfa_required_for_roles: str = "admin,gestor,investigador,auditor"
+    mfa_totp_issuer: str = "SEMPER-FI"
+
+    # DB
+    database_url: str = "postgresql+asyncpg://semperfi:semperfi@localhost:5432/semperfi"
+    database_pool_size: int = 10
+    database_max_overflow: int = 20
+
+    # Redis / Celery
+    redis_url: str = "redis://localhost:6379/0"
+    celery_broker_url: str = "redis://localhost:6379/1"
+    celery_result_backend: str = "redis://localhost:6379/2"
+
+    # S3 / Evidence
+    evidence_s3_endpoint: str = ""
+    evidence_s3_bucket: str = "semperfi-evidence"
+    evidence_s3_region: str = "us-east-1"
+    evidence_s3_access_key: SecretStr = SecretStr("")
+    evidence_s3_secret_key: SecretStr = SecretStr("")
+    evidence_s3_object_lock_mode: Literal["GOVERNANCE", "COMPLIANCE"] = "GOVERNANCE"
+    evidence_s3_default_retention_days: int = 1825
+    evidence_kms_key_id: str = ""
+    evidence_sse_type: Literal["AES256", "aws:kms"] = "AES256"
+
+    # SSRF
+    http_allowlist: str = "brasilapi.com.br,api.portaldatransparencia.gov.br"
+
+    # Connectors
+    brasilapi_base_url: str = "https://brasilapi.com.br/api"
+    transparencia_base_url: str = "https://api.portaldatransparencia.gov.br/api-de-dados"
+    transparencia_api_token: SecretStr = SecretStr("")
+    datajud_base_url: str = "https://api-publica.datajud.cnj.jus.br"
+    datajud_api_key: SecretStr = SecretStr("")
+
+    # Rate limit
+    rate_limit_global_per_min: int = Field(600, ge=1)
+    rate_limit_user_per_min: int = Field(120, ge=1)
+    rate_limit_connector_per_min: int = Field(60, ge=1)
+
+    # AV
+    clamd_host: str = "clamav"
+    clamd_port: int = 3310
+
+    # Observability
+    prometheus_enabled: bool = True
+    otel_enabled: bool = False
+    otel_exporter_otlp_endpoint: str = ""
+    sentry_dsn: str = ""
+
+    # Secrets backend
+    secrets_backend: Literal["env", "aws_secrets_manager", "vault"] = "env"
+    aws_secrets_prefix: str = "/semperfi/prod/"
+
+    @property
+    def cors_origins_list(self) -> list[str]:
+        return [o.strip() for o in self.cors_allowed_origins.split(",") if o.strip()]
+
+    @property
+    def http_allowlist_set(self) -> set[str]:
+        return {h.strip().lower() for h in self.http_allowlist.split(",") if h.strip()}
+
+    @property
+    def mfa_required_roles_set(self) -> set[str]:
+        return {r.strip() for r in self.mfa_required_for_roles.split(",") if r.strip()}
+
+    @property
+    def fernet_keys_list(self) -> list[str]:
+        return [k.strip() for k in self.fernet_keys.split(",") if k.strip()]
+
+
+@lru_cache
+def get_settings() -> Settings:
+    return Settings()
diff --git a/backend/app/core/errors.py b/backend/app/core/errors.py
new file mode 100644
index 0000000..fd875e1
--- /dev/null
+++ b/backend/app/core/errors.py
@@ -0,0 +1,82 @@
+"""Erros padronizados + handlers que não vazam stack para o cliente."""
+from typing import Any
+
+from fastapi import HTTPException, Request, status
+from fastapi.responses import JSONResponse
+
+from app.core.logging import get_logger
+
+log = get_logger(__name__)
+
+
+class AppError(Exception):
+    code: str = "app_error"
+    http_status: int = 500
+    public_message: str = "Erro interno."
+
+    def __init__(self, public_message: str | None = None, *, details: dict[str, Any] | None = None) -> None:
+        super().__init__(public_message or self.public_message)
+        self.details = details or {}
+        if public_message:
+            self.public_message = public_message
+
+
+class NotFound(AppError):
+    code = "not_found"; http_status = 404; public_message = "Recurso não encontrado."
+
+
+class Unauthorized(AppError):
+    code = "unauthorized"; http_status = 401; public_message = "Não autenticado."
+
+
+class Forbidden(AppError):
+    code = "forbidden"; http_status = 403; public_message = "Sem permissão."
+
+
+class PolicyDenied(Forbidden):
+    code = "policy_denied"; public_message = "Política bloqueou a operação."
+
+
+class RequireMFA(Forbidden):
+    code = "require_mfa"; http_status = 401; public_message = "MFA obrigatório."
+
+
+class RequireReauth(Forbidden):
+    code = "require_reauth"; http_status = 401; public_message = "Reautenticação obrigatória."
+
+
+class RateLimited(AppError):
+    code = "rate_limited"; http_status = 429; public_message = "Limite de requisições excedido."
+
+
+class ValidationFailed(AppError):
+    code = "validation_failed"; http_status = 422; public_message = "Dados inválidos."
+
+
+class IntegrityError(AppError):
+    code = "integrity_error"; http_status = 409; public_message = "Conflito de integridade."
+
+
+class TenantIsolationViolation(Forbidden):
+    code = "tenant_isolation_violation"; public_message = "Recurso pertence a outro tenant."
+
+
+def install_exception_handlers(app) -> None:
+    @app.exception_handler(AppError)
+    async def _app_error(request: Request, exc: AppError):
+        log.warning("app_error", code=exc.code, path=request.url.path, details=exc.details)
+        body = {"error": {"code": exc.code, "message": exc.public_message}}
+        if exc.details and request.app.state.settings.app_env != "production":
+            body["error"]["details"] = exc.details
+        return JSONResponse(status_code=exc.http_status, content=body)
+
+    @app.exception_handler(HTTPException)
+    async def _http_exception(request: Request, exc: HTTPException):
+        return JSONResponse(status_code=exc.status_code, content={"error": {"code": "http_error", "message": str(exc.detail)}})
+
+    @app.exception_handler(Exception)
+    async def _unhandled(request: Request, exc: Exception):
+        # NUNCA expõe stack/repr ao cliente.
+        log.exception("unhandled_exception", path=request.url.path)
+        return JSONResponse(status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
+                            content={"error": {"code": "internal_error", "message": "Erro interno."}})
diff --git a/backend/app/core/logging.py b/backend/app/core/logging.py
new file mode 100644
index 0000000..6218d78
--- /dev/null
+++ b/backend/app/core/logging.py
@@ -0,0 +1,53 @@
+"""structlog com filtro de PII e correlation_id."""
+import logging
+import re
+from typing import Any
+
+import structlog
+
+from app.core.config import get_settings
+
+# Regexes determinísticos — qualquer match é redigido em logs.
+_PII_PATTERNS = [
+    (re.compile(r"\b\d{3}\.?\d{3}\.?\d{3}-?\d{2}\b"), "[CPF-REDACTED]"),
+    (re.compile(r"\b\d{2}\.?\d{3}\.?\d{3}/?\d{4}-?\d{2}\b"), "[CNPJ-REDACTED]"),
+    (re.compile(r"\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}\b"), "[EMAIL-REDACTED]"),
+    (re.compile(r"\+?\d{2,3}[\s-]?\(?\d{2,4}\)?[\s-]?\d{4,5}[\s-]?\d{4}"), "[PHONE-REDACTED]"),
+    (re.compile(r"(?i)(authorization|cookie|token|password|secret)[\"']?\s*[:=]\s*[\"']?[^\s\"']+"), r"\1=[REDACTED]"),
+    (re.compile(r"eyJ[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+"), "[JWT-REDACTED]"),
+]
+
+
+def _redact_pii(_: Any, __: str, event_dict: dict[str, Any]) -> dict[str, Any]:
+    """Processor structlog: aplica PII filter em strings recursivamente."""
+    def walk(v: Any) -> Any:
+        if isinstance(v, str):
+            for pat, repl in _PII_PATTERNS:
+                v = pat.sub(repl, v)
+            return v
+        if isinstance(v, dict):
+            return {k: walk(x) for k, x in v.items()}
+        if isinstance(v, list):
+            return [walk(x) for x in v]
+        return v
+    return walk(event_dict)
+
+
+def configure_logging() -> None:
+    s = get_settings()
+    logging.basicConfig(format="%(message)s", level=s.log_level.upper())
+    structlog.configure(
+        processors=[
+            structlog.contextvars.merge_contextvars,
+            structlog.processors.add_log_level,
+            structlog.processors.TimeStamper(fmt="iso", utc=True),
+            _redact_pii,
+            structlog.processors.JSONRenderer(),
+        ],
+        wrapper_class=structlog.make_filtering_bound_logger(getattr(logging, s.log_level.upper(), logging.INFO)),
+        cache_logger_on_first_use=True,
+    )
+
+
+def get_logger(name: str | None = None) -> structlog.stdlib.BoundLogger:
+    return structlog.get_logger(name)
