ENVIRONMENT=development
APP_NAME=SEMPER-FI API
API_V1_PREFIX=/v1
DATABASE_URL=postgresql+asyncpg://semperfi:semperfi@postgres:5432/semperfi
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:4173,http://localhost:8088
FIELD_ENCRYPTION_KEY=
AUTH_MODE=password
ALLOW_SELF_REGISTRATION=true
ALLOW_DEVELOPMENT_IDENTITY_HEADERS=false
OIDC_ISSUER_URL=
OIDC_AUDIENCE=semperfi-api
OIDC_JWKS_URL=
MFA_MAX_AGE_SECONDS=900
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_EVIDENCE=semperfi-evidence
S3_KMS_KEY_ID=
S3_OBJECT_LOCK_MODE=GOVERNANCE
S3_OBJECT_LOCK_ENABLED=true
S3_RETENTION_DAYS=1825
S3_PRESIGN_EXPIRES_SECONDS=300
TRANSPARENCY_API_KEY=
DATAJUD_API_KEY=
DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br
BRASIL_API_BASE_URL=https://brasilapi.com.br/api
MAX_UPLOAD_BYTES=52428800
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,image/tiff,video/mp4,video/quicktime
EVIDENCE_STAGING_DIR=var/semperfi-evidence
SENTRY_DSN=
LOG_LEVEL=INFO
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://api.example.com/v1/auth/oidc/callback
SESSION_COOKIE_NAME=semperfi_session
SESSION_TTL_SECONDS=28800

# Required stable random secret in staging/production; use at least 32 random bytes.
# Development/test may use a process-local ephemeral secret.
AUTH_OTP_SIGNING_KEY=
CHALLENGE_COOKIE_NAME=semperfi_verification
AUTH_OTP_TTL_SECONDS=600
AUTH_OTP_COOLDOWN_SECONDS=60
AUTH_OTP_MAX_ATTEMPTS=5

# Email verification fails closed when delivery is unavailable or not configured.
# TLS is always required: starttls (usually port 587) or ssl (usually port 465).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
# Set both credentials for authenticated SMTP, or leave both empty for a trusted relay.
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_TIMEOUT_SECONDS=10

# Asaas Sandbox only. Keep disabled until a separate Sandbox account/webhook is configured.
# Put the Sandbox key (prefix $aact_hmlg_) and a random webhook token in .env only.
# Production keys and hosts are deliberately unsupported by this release.
ASAAS_SANDBOX_ENABLED=false
ASAAS_SANDBOX_API_KEY=
ASAAS_WEBHOOK_TOKEN=
# Public HTTPS application URL, e.g. https://homolog.example.com/ui/frontend/index.html
ASAAS_CHECKOUT_RETURN_URL=

# Local supervised AI. No cloud fallback; model must already be installed in Ollama.
AI_PROVIDER=disabled
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=120
