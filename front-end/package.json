{
  "name": "semperfi-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend modular do sistema SEMPER-FI.",
  "scripts": {
    "dev": "node server.mjs",
    "preview": "node server.mjs",
    "check:syntax": "node scripts/check.mjs",
    "check": "node scripts/check.mjs && node scripts/sync-backend.mjs --check",
    "sync:backend": "node scripts/sync-backend.mjs",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node tests/browser/functional.cjs && node tests/browser/auth-recovery.cjs && node tests/browser/client-profile.cjs",
    "test:browser:api": "node tests/browser/legal-live.cjs"
  },
  "devDependencies": {
    "axe-core": "4.13.0",
    "playwright": "1.63.0"
  }
}
